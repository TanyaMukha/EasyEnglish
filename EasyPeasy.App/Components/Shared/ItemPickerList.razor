@namespace EasyPeasy.App.Components.Shared
@using EasyPeasy.App.Models

@*
    Picker for the individual items of a session (words, forms, cards).

    Collapsed by default, like the exercise picker: everything is selected anyway, so the whole
    list only gets in the way of the learner who just wants to press "Почати". The summary keeps
    the count visible, so it is clear what will be practised without opening the block.
*@

<details class="item-picker">
    <summary>
        <i class="bi bi-chevron-right block-chevron"></i>
        <span class="item-picker-title">@Title</span>
        <span class="item-picker-count">@SelectedIds.Count із @Items.Count</span>
    </summary>

    @if (Items.Count == 0)
    {
        <p class="item-picker-empty">@EmptyText</p>
    }
    else
    {
        <div class="item-picker-header">
            <InputCheckboxField Label="@SelectAllLabel" Value="@IsAllSelected" ValueChanged="@ToggleAll" />
        </div>

        <div class="item-picker-list">
            @foreach (var item in Items)
            {
                <label class="item-picker-row">
                    <input type="checkbox"
                           checked="@SelectedIds.Contains(item.Id)"
                           @onchange="@(e => ToggleItem(item.Id, (bool)(e.Value ?? false)))" />
                    <span>@item.Title</span>
                </label>
            }
        </div>
    }
</details>

@code {
    [Parameter, EditorRequired] public List<OptionDefinition> Items { get; set; } = new();
    [Parameter] public HashSet<int> SelectedIds { get; set; } = new();
    [Parameter] public EventCallback<HashSet<int>> SelectedIdsChanged { get; set; }
    [Parameter] public string Title { get; set; } = "Що вивчати";
    [Parameter] public string SelectAllLabel { get; set; } = "Вибрати всі";
    [Parameter] public string EmptyText { get; set; } = "Немає елементів для відображення.";

    private bool IsAllSelected => Items.Count > 0 && Items.All(i => SelectedIds.Contains(i.Id));

    private async Task ToggleAll(bool value)
    {
        SelectedIds = value ? Items.Select(i => i.Id).ToHashSet() : new HashSet<int>();
        await SelectedIdsChanged.InvokeAsync(SelectedIds);
    }

    private async Task ToggleItem(int id, bool isChecked)
    {
        if (isChecked)
            SelectedIds.Add(id);
        else
            SelectedIds.Remove(id);

        await SelectedIdsChanged.InvokeAsync(SelectedIds);
    }
}

<style>
    .item-picker {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 0.5rem 1rem;
    }

    .item-picker summary {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        padding: 0.5rem 0;
        font-weight: 600;
        color: var(--text-primary);
    }

    .item-picker summary::-webkit-details-marker {
        display: none;
    }

    .item-picker[open] summary {
        margin-bottom: 0.5rem;
        border-bottom: 1px solid var(--border-light);
    }

    .item-picker-count {
        margin-left: auto;
        padding: 0.1rem 0.55rem;
        border-radius: 999px;
        background: var(--surface-alt);
        border: 1px solid var(--border);
        color: var(--text-muted);
        font-size: 0.8rem;
        font-weight: 500;
        white-space: nowrap;
    }

    .item-picker-header {
        border-bottom: 1px solid var(--border-light);
        padding-bottom: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .item-picker-list {
        max-height: 320px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }

    .item-picker-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0.25rem;
        cursor: pointer;
        border-bottom: 1px solid var(--border-light);
        font-size: 0.95rem;
        color: var(--text-primary);
    }

    .item-picker-row:last-child {
        border-bottom: none;
    }

    .item-picker-row:hover {
        background: var(--surface-alt);
    }

    .item-picker-empty {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin: 0.5rem 0;
    }
</style>
