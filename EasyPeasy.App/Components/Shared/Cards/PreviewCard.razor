@namespace EasyPeasy.App.Components.Shared

<div class="preview-card" @onclick="@(async () => await GoToViewPage.InvokeAsync(Id))">
    <div class="card-header">
        <div class="card-content">
            <h3 class="card-title">@Title</h3>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="card-description">@Description</p>
            }
            @if (AdditionalMainContent != null)
            {
                <div class="card-additional-content">
                    @AdditionalMainContent
                </div>
            }
        </div>
        @if (IsEditable)
        {
            <div class="card-actions" @onclick:stopPropagation="true">
                <button class="action-btn" @onclick="@(async () => await GoToEditPage.InvokeAsync(Id))" title="Редагувати">
                    <i class="bi bi-pencil"></i>
                </button>
                <button class="action-btn action-btn-danger" @onclick="@(async () => await RemoveItem.InvokeAsync(Id))" title="Видалити">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        }
    </div>

    @if (AdditionalBottomContent != null)
    {
        <div class="card-bottom-content">
            @AdditionalBottomContent
        </div>
    }

    <div class="card-footer">
        @if (StatsContent != null)
        {
            @StatsContent
        }
        else
        {
            <div class="card-stat">
                <i class="bi bi-card-text"></i>
                <span>@ItemsCount items</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(BadgeText))
        {
            <span class="card-badge">@BadgeText</span>
        }
    </div>
</div>

@code {
    [Parameter] public required int Id { get; set; }
    [Parameter] public required string Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public required int ItemsCount { get; set; } = 0;
    [Parameter] public string? BadgeText { get; set; }
    [Parameter] public bool IsEditable { get; set; } = false;

    [Parameter] public RenderFragment? AdditionalMainContent { get; set; }
    [Parameter] public RenderFragment? AdditionalBottomContent { get; set; }

    /// <summary>Replaces the default "N items" footer line when a card counts more than one kind of item.</summary>
    [Parameter] public RenderFragment? StatsContent { get; set; }

    [Parameter] public EventCallback<int> GoToViewPage { get; set; }
    [Parameter] public EventCallback<int> GoToEditPage { get; set; }
    [Parameter] public EventCallback<int> RemoveItem { get; set; }
}

<style>  
    .preview-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        height: 100%;
    }

    .preview-card:hover {
        border-color: #A3BFFA;
        box-shadow: 0 4px 12px rgba(163, 191, 250, 0.15);
        transform: translateY(-2px);
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        background: transparent;
        border: none;
    }

    .card-content {
        flex: 1;
        min-width: 0;
    }

    .card-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0 0 0.5rem 0;
        line-height: 1.3;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .card-description {
        font-size: 0.95rem;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.5;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }

    .card-additional-content {
        margin-top: 0.75rem;
    }

    .card-actions {
        display: flex;
        gap: 0.5rem;
        opacity: 0;
        transition: opacity 0.2s;
    }

    .preview-card:hover .card-actions {
        opacity: 1;
    }

    /* На тач-пристроях немає hover — кнопки дій завжди видимі */
    @@media (hover: none), (pointer: coarse) {
        .card-actions {
            opacity: 1;
        }
    }

    .action-btn {
        background: var(--surface-alt);
        border: 1px solid var(--border-muted);
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .action-btn:hover {
        background: var(--surface);
        border-color: #A3BFFA;
        color: #A3BFFA;
        transform: translateY(-2px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .action-btn-danger:hover {
        border-color: #dc3545;
        color: #dc3545;
    }

    .action-btn i {
        font-size: 1rem;
    }

    .card-bottom-content {
        margin-top: auto;
    }

    .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        margin-top: auto;
        background: transparent;
    }

    .card-stat {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        color: var(--text-secondary);
        font-weight: 500;
    }

    .card-stat i {
        font-size: 1.1rem;
        color: #A3BFFA;
    }

    .card-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        background: #F3E5F5;
        color: #7B1FA2;
    }

    @@media (max-width: 768px) {
        .preview-card {
            padding: 1.25rem;
        }

        .card-title {
            font-size: 1.1rem;
        }

        .card-actions {
            opacity: 1;
        }
    }
</style>