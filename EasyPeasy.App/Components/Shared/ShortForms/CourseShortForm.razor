@namespace EasyPeasy.App.Components.Shared

<div class="create-card">
    @if (!isExpanded)
    {
            <button class="expand-btn" @onclick="ToggleExpand">
                <i class="bi bi-plus-lg"></i>
                <span>Створити новий словник</span>
            </button>
    }
    else
    {
        <div class="create-form-container">
            <div class="form-header">
                <h3 class="form-title">
                    <i class="bi bi-book"></i>
                    Новий словник
                </h3>
                <button class="close-btn" @onclick="ToggleExpand">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm Model="newCourse" OnValidSubmit="HandleCreateCourse" class="create-form">
                <DataAnnotationsValidator />

                <InputTextField @bind-Value="newCourse.Title"
                                Label="Назва словника" />
                <ValidationMessage For="@(() => newCourse.Title)" class="validation-message" />

                <InputMultilineField @bind-Value="newCourse.Description"
                                        Label="Опис"
                                        Rows="2" />
                <ValidationMessage For="@(() => newCourse.Description)" class="validation-message" />

                <div class="form-actions">
                    <button type="button" class="btn-cancel" @onclick="ToggleExpand">
                        Скасувати
                    </button>
                    <button type="submit" class="btn-create">
                        <i class="bi bi-check-lg"></i>
                        Створити
                    </button>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    [Parameter] public Func<Task>? OnCourseCreated { get; set; }

    private CourseModel newCourse = new CourseModel();
    private bool isExpanded = false;

    private void ToggleExpand()
    {
        isExpanded = !isExpanded;
        if (!isExpanded)
        {
            ResetnewCourse();
        }
    }

    private void ResetnewCourse()
    {
        newCourse = new CourseModel();
    }

    private async Task HandleCreateCourse()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(newCourse.Title))
            {
                return;
            }

            await CourseService.CreateAsync(newCourse);
            if (OnCourseCreated != null)
            {
                await OnCourseCreated.Invoke();
            }
            ResetnewCourse();
            isExpanded = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating course: {ex.Message}");
        }
    }
}

<style>
    .create-card {
        background: var(--surface);
        border: 2px dashed var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        transition: all 0.2s ease;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .create-card:hover {
        border-color: #A3BFFA;
    }

    .expand-btn {
        background: transparent;
        border: none;
        color: var(--text-secondary);
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        width: 100%;
        justify-content: center;
        transition: all 0.2s;
    }

    .expand-btn:hover {
        color: #A3BFFA;
    }

    .expand-btn i {
        font-size: 1.25rem;
    }

    .create-form-container {
        width: 100%;
    }

    .form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .form-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-title i {
        color: #A3BFFA;
    }

    .close-btn {
        background: var(--surface-alt);
        border: 1px solid var(--border-muted);
        border-radius: 8px;
        padding: 0.5rem;
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
    }

    .close-btn:hover {
        background: var(--surface);
        border-color: #A3BFFA;
        color: #A3BFFA;
    }

    .create-form {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-actions {
        display: flex;
        gap: 0.75rem;
        margin-top: 1rem;
    }

    .btn-cancel,
    .btn-create {
        flex: 1;
        border: none;
        border-radius: 8px;
        padding: 0.75rem 1.5rem;
        cursor: pointer;
        transition: all 0.2s;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 0.95rem;
    }

.btn-cancel:hover {
        background: var(--surface);
        border-color: var(--text-muted);
        color: var(--text-primary);
    }

    .btn-create {
        background: linear-gradient(135deg, #A3BFFA, #B5EAD7);
        color: white;
        box-shadow: 0 2px 8px rgba(163, 191, 250, 0.3);
    }

    .btn-create:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(163, 191, 250, 0.4);
    }

    .btn-create:active {
        transform: translateY(0);
    }

@@media (max-width: 768px) {
        .create-card {
            padding: 1.25rem;
        }

        .form-actions {
            flex-direction: column;
        }
    }
</style>