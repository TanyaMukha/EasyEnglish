@namespace EasyPeasy.App.Components.Shared

<div class="form-field-inline">
    <div class="input-wrapper file-input-wrapper">
        <InputFile OnChange="@HandleFileChange"
                   accept="@Accept"
                   class="inline-file-input"
                   id="@inputId" />
        <label for="@inputId" class="file-upload-label">
            <div class="file-icon">
                <i class="bi bi-cloud-upload"></i>
            </div>
            <div class="file-text">
                <span class="file-label-text">@Label</span>
                @if (!string.IsNullOrEmpty(SelectedFileName))
                {
                    <span class="file-name">@SelectedFileName</span>
                    @if (!string.IsNullOrEmpty(FileSize))
                    {
                        <small class="file-size">(@FileSize)</small>
                    }
                }
                else
                {
                    <span class="file-placeholder">Натисніть для вибору файлу</span>
                }
            </div>
        </label>
        
        @if (!string.IsNullOrEmpty(SelectedFileName))
        {
            <div class="file-selected-indicator">
                <i class="bi bi-check-circle-fill"></i>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnChange { get; set; }
    [Parameter] public string Label { get; set; } = "Виберіть файл";
    [Parameter] public string? Accept { get; set; }

    private string inputId = $"file-{Guid.NewGuid():N}";
    private string? SelectedFileName { get; set; }
    private string? FileSize { get; set; }

    private async Task HandleFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            SelectedFileName = file.Name;
            FileSize = FormatFileSize(file.Size);
        }
        else
        {
            SelectedFileName = null;
            FileSize = null;
        }

        await OnChange.InvokeAsync(e);
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024:F1} KB";
        return $"{bytes / (1024 * 1024):F1} MB";
    }

    public void ClearFile()
    {
        SelectedFileName = null;
        FileSize = null;
        StateHasChanged();
    }
}

<style>
    .form-field-inline {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-bottom: 1.5rem;
    }

    .input-wrapper {
        position: relative;
    }

    .file-input-wrapper {
        min-height: 5rem;
    }

    .inline-file-input {
        opacity: 0;
        position: absolute;
        z-index: -1;
        width: 0;
        height: 0;
    }

    .file-upload-label {
        display: flex;
        align-items: center;
        gap: 1rem;
        width: 100%;
        padding: 1rem 1.25rem;
        border: none;
        border-bottom: 2px solid rgba(0, 0, 0, 0.1);
        background: transparent;
        cursor: pointer;
        transition: all 0.2s;
        min-height: 5rem;
    }

    .file-upload-label:hover {
        border-bottom-color: #A3BFFA;
    }

    .file-icon {
        flex-shrink: 0;
        width: 3rem;
        height: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(163, 191, 250, 0.1);
        border-radius: 50%;
        transition: all 0.2s;
    }

    .file-upload-label:hover .file-icon {
        background: rgba(163, 191, 250, 0.2);
        transform: scale(1.05);
    }

    .file-icon i {
        font-size: 1.5rem;
        color: #A3BFFA;
    }

    .file-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .file-label-text {
        font-size: 0.75rem;
        color: #A3BFFA;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .file-placeholder {
        color: var(--text-muted);
        font-size: 0.95rem;
    }

    .file-name {
        color: var(--text-primary);
        font-weight: 600;
        font-size: 1rem;
    }

    .file-size {
        color: var(--text-secondary);
        font-size: 0.875rem;
    }

    .file-selected-indicator {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #28a745;
        font-size: 1.5rem;
        animation: fadeIn 0.3s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-50%) scale(0.8);
        }
        to {
            opacity: 1;
            transform: translateY(-50%) scale(1);
        }
    }

    @@media (max-width: 768px) {
        .file-upload-label {
            padding: 0.875rem 1rem;
            min-height: 4.5rem;
        }

        .file-icon {
            width: 2.5rem;
            height: 2.5rem;
        }

        .file-icon i {
            font-size: 1.25rem;
        }
    }
</style>
