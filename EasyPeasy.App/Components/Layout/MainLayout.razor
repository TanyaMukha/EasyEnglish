@inherits LayoutComponentBase
@using EasyPeasy.App.Components.Shared
@inject NavigationManager NavigationManagerNavigation
@inject IJSRuntime JSRuntime
@inject StorageMaintenanceService StorageMaintenanceService
@implements IDisposable

<div class="app-layout">
    <!-- Overlay -->
    @if (isSidebarOpen && isMobile)
    {
        <div class="sidebar-overlay" @onclick="CloseSidebar"></div>
    }

    <!-- Sidebar Navigation -->
    <aside class="app-sidebar @(isSidebarOpen ? "open" : "") @(isSidebarCollapsed && !isMobile ? "collapsed" : "")">
        <div class="sidebar-header">
            <button class="logo-link" 
                    @onclick="ToggleCollapse" 
                    @onclick:stopPropagation="true"
                    title="@(isSidebarCollapsed ? "Розгорнути меню" : "Згорнути меню")">
                <div class="logo-icon">
                    <i class="bi bi-book"></i>
                </div>
                @if (!isSidebarCollapsed || isMobile)
                {
                    <h3 class="logo-text">EasyPeasy</h3>
                }
            </button>
            <button class="close-button" @onclick="CloseSidebar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <!-- Navigation Menu -->
        <nav class="sidebar-nav">
            <div class="nav-section">
                @if (!isSidebarCollapsed || isMobile)
                {
                    <p class="nav-section-title">Головне</p>
                }
                <ul class="nav-menu">
                    <li class="nav-item">
                        <a href="/" 
                           class="nav-link @GetNavClass("/")" 
                           @onclick="OnNavClick" 
                           title="@(isSidebarCollapsed && !isMobile ? "Home" : "")">
                            <i class="nav-icon bi bi-house"></i>
                            @if (!isSidebarCollapsed || isMobile)
                            {
                                <span class="nav-label">Home</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/courses"
                           class="nav-link @GetNavClass("/courses")"
                           @onclick="OnNavClick"
                           title="@(isSidebarCollapsed && !isMobile ? "Courses" : "")">
                            <i class="nav-icon bi bi-journals"></i>
                            @if (!isSidebarCollapsed || isMobile)
                            {
                                <span class="nav-label">Courses</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/subjects"
                           class="nav-link @GetNavClass("/subjects")"
                           @onclick="OnNavClick"
                           title="@(isSidebarCollapsed && !isMobile ? "Subjects" : "")">
                            <i class="nav-icon bi bi-tags"></i>
                            @if (!isSidebarCollapsed || isMobile)
                            {
                                <span class="nav-label">Subjects</span>
                            }
                        </a>
                    </li>
                    @* <li class="nav-item"> *@
                    @*     <a href="/vocab-player" *@
                    @*        class="nav-link @GetNavClass("/vocab-player")" *@
                    @*        @onclick="OnNavClick" *@
                    @*        title="@(isSidebarCollapsed && !isMobile ? "Player" : "")"> *@
                    @*         <i class="nav-icon bi bi-house"></i> *@
                    @*         @if (!isSidebarCollapsed || isMobile) *@
                    @*         { *@
                    @*                 <span class="nav-label">Player</span> *@
                    @*         } *@
                    @*     </a> *@
                    @* </li> *@
                </ul>
            </div>

            <div class="nav-section">
                @if (!isSidebarCollapsed || isMobile)
                {
                    <p class="nav-section-title">Інструменти</p>
                }
                <ul class="nav-menu">
                    <li class="nav-item">
                        <a href="/import-course-zip"
                            class="nav-link @GetNavClass("/import-course-zip")"
                            @onclick="OnNavClick"
                            title="@(isSidebarCollapsed && !isMobile ? "Import Zip" : "")">
                            <i class="nav-icon bi bi-upload"></i>
                            @if (!isSidebarCollapsed || isMobile)
                            {
                                <span class="nav-label">Import</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/export-course-zip"
                           class="nav-link @GetNavClass("/export-course-zip")"
                            @onclick="OnNavClick"
                            title="@(isSidebarCollapsed && !isMobile ? "Export Zip" : "")">
                            <i class="nav-icon bi bi-download"></i>
                            @if (!isSidebarCollapsed || isMobile)
                            {
                                <span class="nav-label">Export</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/database-info"
                           class="nav-link @GetNavClass("/database-info")"
                           @onclick="OnNavClick"
                           title="@(isSidebarCollapsed && !isMobile ? "Database Info" : "")">
                            <i class="nav-icon bi bi-database"></i>
                            @if (!isSidebarCollapsed || isMobile)
                            {
                                <span class="nav-label">Database Info</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/settings/voices"
                           class="nav-link @GetNavClass("/settings/voices")"
                           @onclick="OnNavClick"
                           title="@(isSidebarCollapsed && !isMobile ? "Voices" : "")">
                            <i class="nav-icon bi bi-mic"></i>
                            @if (!isSidebarCollapsed || isMobile)
                            {
                                <span class="nav-label">Voices</span>
                            }
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Footer -->
        <div class="nav-footer">
            <button class="theme-toggle" @onclick="ToggleTheme"
                    title="@(currentTheme == "dark" ? "Світла тема" : "Темна тема")">
                <i class="bi @(currentTheme == "dark" ? "bi-sun" : "bi-moon")"></i>
                @if (!isSidebarCollapsed || isMobile)
                {
                    <span>@(currentTheme == "dark" ? "Світла тема" : "Темна тема")</span>
                }
            </button>

            @if (!isSidebarCollapsed || isMobile)
            {
                <p class="footer-text">© @DateTime.Now.Year EasyPeasy</p>
            }
            else
            {
                <p class="footer-text">©</p>
            }
        </div>
    </aside>

    <!-- Main Content -->
    <CascadingValue Value="@chromeStart" Name="ChromeStart" IsFixed="true">
        <main class="app-content @(isSidebarCollapsed && !isMobile ? "collapsed" : "")">
            <div class="content-wrapper">
                @Body
            </div>
        </main>
    </CascadingValue>

    <ConfirmDialogHost />
</div>

<script>
    window.mainLayoutHelper = {
        dotNetRef: null,
        resizeTimeout: null,

        initialize: function (dotNetReference) {
            this.dotNetRef = dotNetReference;
            
            // Resize handler with debounce
            window.addEventListener('resize', () => {
                clearTimeout(this.resizeTimeout);
                this.resizeTimeout = setTimeout(() => {
                    if (this.dotNetRef) {
                        console.log('Calling HandleResize from JavaScript');
                        this.dotNetRef.invokeMethodAsync('HandleResize');
                    }
                }, 100);
            });

            // Orientation-change handler
            window.addEventListener('orientationchange', () => {
                clearTimeout(this.resizeTimeout);
                this.resizeTimeout = setTimeout(() => {
                    if (this.dotNetRef) {
                        console.log('Calling HandleResize from orientationchange');
                        this.dotNetRef.invokeMethodAsync('HandleResize');
                    }
                }, 200);
            });

            console.log('MainLayout resize listener initialized');
        },

        dispose: function () {
            if (this.dotNetRef) {
                this.dotNetRef = null;
            }
        }
    };
</script>

@code {
    private bool isSidebarOpen = false;
    private bool isSidebarCollapsed = true; // Starts collapsed
    private bool isMobile = false;
    private string currentTheme = "light";
    private int windowWidth = 0;
    private int windowHeight = 0;
    private DotNetObjectReference<MainLayout>? dotNetRef;

    /// <summary>
    /// App chrome that PageShell embeds into its top row.
    /// The layout decides what the buttons are; the shell decides where they sit.
    /// </summary>
    private readonly RenderFragment chromeStart;

    public MainLayout()
    {
        chromeStart = @<SidebarToggleButton OnToggle="ToggleSidebar" />;
    }

    protected override async Task OnInitializedAsync()
    {
        await StorageMaintenanceService.RemoveObsoleteKeysAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Console.WriteLine($"MainLayout OnAfterRenderAsync - firstRender: {firstRender}");

        if (firstRender)
        {
            await CheckIsMobile();
            
            // Create a reference for JavaScript
            dotNetRef = DotNetObjectReference.Create(this);
            
            // Initialize the JavaScript helper
            await JSRuntime.InvokeVoidAsync("mainLayoutHelper.initialize", dotNetRef);

            currentTheme = await JSRuntime.InvokeAsync<string>("themeHelper.get");

            StateHasChanged();
        }
    }

    [JSInvokable("HandleResize")]
    public async Task HandleResize()
    {
        var wasMobile = isMobile;
        await CheckIsMobile();
        Console.WriteLine($"HandleResize - wasMobile: {wasMobile}, isMobile: {isMobile}, isSidebarOpen: {isSidebarOpen}, width: {windowWidth}, height: {windowHeight}");

        if (wasMobile && !isMobile && isSidebarOpen)
        {
            Console.WriteLine("Closing sidebar - switched to desktop");
            isSidebarOpen = false;
        }

        StateHasChanged();
    }

    private async Task CheckIsMobile()
    {
        try
        {
            windowWidth = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
            windowHeight = await JSRuntime.InvokeAsync<int>("eval", "window.innerHeight");
            
            // How mobile mode is decided:
            // 1. Width <= 768px - always mobile
            // 2. Width > 768px and <= 1024px (tablet):
            //    - portrait (height > width) - mobile
            //    - landscape (width >= height) - desktop
            // 3. Width > 1024px - desktop
            
            if (windowWidth <= 768)
            {
                isMobile = true;
            }
            else if (windowWidth <= 1024)
            {
                // Tablet: decide by orientation
                isMobile = windowHeight > windowWidth; // portrait = mobile, landscape = desktop
            }
            else
            {
                isMobile = false;
            }
            
            Console.WriteLine($"CheckIsMobile - width: {windowWidth}, height: {windowHeight}, isMobile: {isMobile}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckIsMobile: {ex.Message}");
            isMobile = true;
            windowWidth = 0;
            windowHeight = 0;
        }
    }

    private async Task ToggleTheme()
    {
        currentTheme = await JSRuntime.InvokeAsync<string>("themeHelper.toggle");
    }

    private void ToggleSidebar()
    {
        Console.WriteLine($"ToggleSidebar clicked! Current isSidebarOpen: {isSidebarOpen}");
        isSidebarOpen = !isSidebarOpen;
        Console.WriteLine($"New isSidebarOpen: {isSidebarOpen}");
    }

    private void ToggleCollapse()
    {
        // Collapsing is not allowed on mobile
        if (isMobile)
        {
            Console.WriteLine("ToggleCollapse ignored on mobile");
            return;
        }

        Console.WriteLine($"ToggleCollapse clicked! Current isSidebarCollapsed: {isSidebarCollapsed}");
        isSidebarCollapsed = !isSidebarCollapsed;
        Console.WriteLine($"New isSidebarCollapsed: {isSidebarCollapsed}");
    }

    private void CloseSidebar()
    {
        Console.WriteLine("CloseSidebar called");
        isSidebarOpen = false;
    }

    private void OnNavClick()
    {
        Console.WriteLine($"OnNavClick - isMobile: {isMobile}, isSidebarOpen: {isSidebarOpen}");
        if (isMobile)
        {
            CloseSidebar();
        }
    }

    private string GetNavClass(string path)
    {
        var currentPath = NavigationManager.Uri.Replace(NavigationManager.BaseUri, "/").TrimEnd('/');
        if (string.IsNullOrEmpty(currentPath))
        {
            currentPath = "/";
        }

        return currentPath == path ? "active" : "";
    }

    public void Dispose()
    {
        if (dotNetRef != null)
        {
            JSRuntime.InvokeVoidAsync("mainLayoutHelper.dispose");
            dotNetRef.Dispose();
        }
    }
}

<style>
    .app-layout {
        display: flex;
        min-height: 100vh;
        background-color: var(--surface-alt);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        position: relative;
    }

    .app-content {
        flex: 1;
        margin-left: 280px;
        overflow-y: auto;
        transition: margin-left 0.3s ease;
    }

    .app-content.collapsed {
        margin-left: 80px;
    }

    .content-wrapper {
        background-color: var(--surface);
        min-height: 100vh;
        /* Inset equal to the on-screen keyboard height — it must not cover fields and buttons */
        padding-bottom: var(--keyboard-inset, 0px);
        transition: padding-bottom 0.15s ease;
    }

    /* ===== OVERLAY ===== */
    .sidebar-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.4);
        z-index: 999;
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    /* ===== SIDEBAR ===== */
    .app-sidebar {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        width: 280px;
        background: var(--surface);
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        transition: all 0.3s ease;
        overflow-y: auto;
        overflow-x: hidden;

        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }

    .app-sidebar.collapsed {
        width: 80px;
    }

    /* ===== SIDEBAR HEADER ===== */
    .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.5rem 1rem;
        border-bottom: 1px solid var(--border);
        min-height: 80px;
    }

    .logo-link {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .logo-link:hover .logo-icon {
        transform: scale(1.05);
    }

    .logo-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #A3BFFA, #B5EAD7);
        border-radius: 12px;
        color: white;
        font-size: 1.5rem;
        flex-shrink: 0;
        transition: transform 0.3s ease;
    }

    .logo-text {
        font-size: 1.25rem;
        font-weight: 700;
        background: linear-gradient(135deg, #A3BFFA, #B5EAD7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 0;
        white-space: nowrap;
    }

    .close-button {
        display: none;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border: 2px solid transparent;
        background: transparent;
        border-radius: 8px;
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 1.2rem;
    }

    .close-button:hover {
        background: var(--surface);
        border-color: #A3BFFA;
        color: #A3BFFA;
    }

    /* ===== SIDEBAR NAVIGATION ===== */
    .sidebar-nav {
        flex: 1;
        padding: 1rem;
        overflow-y: auto;
    }

    .nav-section {
        margin-bottom: 1.5rem;
    }

    .nav-section-title {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
        margin: 0 0 0.5rem 0.75rem;
        white-space: nowrap;
    }

    .app-sidebar.collapsed .nav-section-title {
        display: none;
    }

    .nav-menu {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .nav-item {
        margin-bottom: 0.25rem;
    }

    .nav-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        color: var(--text-secondary);
        text-decoration: none;
        border-radius: 10px;
        transition: all 0.2s ease;
        font-size: 0.95rem;
        font-weight: 500;
        white-space: nowrap;
    }

    .app-sidebar.collapsed .nav-link {
        justify-content: center;
        padding: 0.75rem;
    }

    .nav-link:hover {
        background-color: var(--surface-alt);
        color: var(--text-primary);
    }

    .nav-link.active {
        background: linear-gradient(135deg, #A3BFFA, #B5EAD7);
        color: white;
    }

    .nav-link.active:hover {
        background: linear-gradient(135deg, #8FA9E8, #A3D9C2);
    }

    .nav-icon {
        font-size: 1.1rem;
        width: 20px;
        text-align: center;
        flex-shrink: 0;
    }

    .nav-label {
        flex: 1;
    }

    /* ===== SIDEBAR FOOTER ===== */
    .nav-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--border);
        margin-top: auto;
    }

    .app-sidebar.collapsed .nav-footer {
        padding: 1rem 0.5rem;
        text-align: center;
    }

    .theme-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        padding: 0.6rem;
        margin-bottom: 0.75rem;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--surface-alt);
        color: var(--text-secondary);
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .theme-toggle:hover {
        border-color: #A3BFFA;
        color: #A3BFFA;
    }

    .footer-text {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.75rem;
        text-align: center;
    }

    /* ===== SCROLLBAR ===== */
    .app-sidebar::-webkit-scrollbar {
        width: 6px;
    }

    .app-sidebar::-webkit-scrollbar-track {
        background: var(--surface-alt);
    }

    .app-sidebar::-webkit-scrollbar-thumb {
        background: #A3BFFA;
        border-radius: 3px;
    }

    .app-sidebar::-webkit-scrollbar-thumb:hover {
        background: #8FA9E8;
    }

    /* ===== RESPONSIVE ===== */
    /* Phones and tablets in portrait */
    @@media (max-width: 768px), (max-width: 1024px) and (orientation: portrait) {
        .close-button {
            display: flex;
        }

        /* Drop the sidebar offset on mobile */
        .app-content {
            margin-left: 0 !important;
        }

        /* Sidebar on mobile */
        .app-sidebar {
            z-index: 1000;
            transform: translateX(-100%);
            box-shadow: 4px 0 20px rgba(0, 0, 0, 0.15);
            width: 280px;
        }

        /* Open sidebar */
        .app-sidebar.open {
            transform: translateX(0);
        }

        /* On mobile always show the full version (never collapsed) */
        .app-sidebar.collapsed {
            width: 280px;
        }

        /* Show every element on mobile */
        .app-sidebar .nav-section-title,
        .app-sidebar .nav-label,
        .app-sidebar .logo-text {
            display: block !important;
        }

        .app-sidebar .nav-link {
            justify-content: flex-start !important;
            padding: 0.75rem 1rem !important;
        }

        .app-sidebar .nav-footer {
            padding: 1rem 1.5rem !important;
        }

        /* No empty strip at the top is needed any more: the menu button sits in the
           breadcrumb row instead of floating above the content. */
    }

    @@media (max-width: 480px) {
        .app-sidebar {
            width: 85vw;
            max-width: 320px;
        }

        .app-sidebar.collapsed {
            width: 85vw;
            max-width: 320px;
        }
    }

    /* Tablets in landscape and desktops */
    @@media (min-width: 769px) and (orientation: landscape), (min-width: 1025px) {
        .close-button {
            display: none;
        }
    }
</style>
