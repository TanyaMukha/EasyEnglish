@page "/courses/{CourseId:int}/units/{UnitId:int}/study-cards/{StudyCardId:int}"

@using EasyPeasy.App.Components.Shared
@using EasyPeasy.App.Components.Shared.Breadcrumb
@using EasyPeasy.Core.Enums
@using EasyPeasy.Core.Presets

<PageShell Breadcrumbs="breadcrumbs" Width="PageWidth.Full" @key="StudyCardId">
    <div class="header-section">

        <div class="title-section">
            <div class="title-wrapper">
                <h1 class="word-title">@GetTitle()</h1>
                <span class="card-tile-kind-badge">@GetKindLabel()</span>
                <a href="/courses/@CourseId/units/@UnitId/study-cards/@StudyCardId/edit" class="btn-edit" title="Edit">
                    <i class="bi bi-pencil"></i>
                </a>
            </div>

            <div class="navigation-section">
                <div class="navigation-buttons">
                    @if (PreviousId.HasValue)
                    {
                        <a href="/courses/@CourseId/units/@UnitId/study-cards/@PreviousId"
                           class="btn-nav"
                           title="Previous card">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    }
                    else
                    {
                        <button class="btn-nav" disabled>
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    }
                    @if (NextId.HasValue)
                    {
                        <a href="/courses/@CourseId/units/@UnitId/study-cards/@NextId"
                           class="btn-nav"
                           title="Next card">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    }
                    else
                    {
                        <button class="btn-nav" disabled>
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    }
                </div>
                @if (Total > 0)
                {
                    <span class="navigation-position">@Position / @Total</span>
                }
            </div>
        </div>
    </div>

    <div class="content-grid">
        @if (Card.Kind == StudyCardKind.Term)
        {
            <div class="info-card">
                <div class="card-icon"><i class="bi bi-card-text"></i></div>
                <div class="card-content">
                    <h3 class="card-title">Термін</h3>
                    <SelectableText><p class="card-text">@Card.Title</p></SelectableText>
                </div>
            </div>

            <div class="info-card">
                <div class="card-icon"><i class="bi bi-translate"></i></div>
                <div class="card-content">
                    <h3 class="card-title">Визначення</h3>
                    <SelectableText><p class="card-text">@Card.Body</p></SelectableText>
                </div>
            </div>
        }
        else if (Card.Kind == StudyCardKind.Text)
        {
            @if (!string.IsNullOrEmpty(Card.Body))
            {
                <div class="info-card">
                    <div class="card-icon"><i class="bi bi-file-text"></i></div>
                    <div class="card-content">
                        <h3 class="card-title">Текст</h3>
                        <SelectableText><p class="card-text">@Card.Body</p></SelectableText>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Card.CodeBlock))
            {
                <div class="info-card">
                    <div class="card-icon"><i class="bi bi-code-slash"></i></div>
                    <div class="card-content">
                        <h3 class="card-title">Код</h3>
                        <SelectableText><p class="card-text">@Card.CodeBlock</p></SelectableText>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Card.Dialogue))
            {
                <div class="info-card">
                    <div class="card-icon"><i class="bi bi-chat-dots"></i></div>
                    <div class="card-content">
                        <h3 class="card-title">Діалог</h3>
                        <SelectableText><p class="card-text">@Card.Dialogue</p></SelectableText>
                    </div>
                </div>
            }
        }
        else if (Card.Kind == StudyCardKind.BlurredText)
        {
            <div class="info-card">
                <div class="card-icon"><i class="bi bi-eye"></i></div>
                <div class="card-content">
                    <h3 class="card-title">Текст (розкрито)</h3>
                    <SelectableText>
                        <p class="card-text">@((MarkupString)ExampleMarkdownService.RenderMarkdown(Card.Body ?? ""))</p>
                    </SelectableText>
                </div>
            </div>

            <div class="info-card">
                <div class="card-icon"><i class="bi bi-shuffle"></i></div>
                <div class="card-content">
                    <h3 class="card-title">Режим розкриття</h3>
                    <p class="card-text">@(Card.RevealMode == BlurRevealMode.Grouped ? "Групове (всі одразу)" : "Незалежне")</p>
                </div>
            </div>
        }
    </div>

    <div class="stats-section">
        <h2 class="section-title">
            <i class="bi bi-bar-chart"></i> Learning Progress
        </h2>
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-star"></i></div>
                <div class="stat-content">
                    <div class="stat-label">Rating</div>
                    <div class="stat-value">@Card.Rate.ToString("F1") / 5</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-arrow-repeat"></i></div>
                <div class="stat-content">
                    <div class="stat-label">Reviews</div>
                    <div class="stat-value">@Card.ReviewCount</div>
                </div>
            </div>

            @if (Card.LastReviewDate.HasValue)
            {
                <div class="stat-card">
                    <div class="stat-icon"><i class="bi bi-calendar-check"></i></div>
                    <div class="stat-content">
                        <div class="stat-label">Last Review</div>
                        <div class="stat-value">@Card.LastReviewDate.Value.ToString("dd MMM yyyy")</div>
                    </div>
                </div>
            }
        </div>
    </div>
</PageShell>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int UnitId { get; set; }
    [Parameter] public int StudyCardId { get; set; }

    private StudyCardModel Card { get; set; } = new();
    private int? PreviousId { get; set; }
    private int? NextId { get; set; }
    private int Position { get; set; }
    private int Total { get; set; }

    private List<Breadcrumb.BreadcrumbItem> breadcrumbs = new();
    private int _loadedCardId = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedCardId == StudyCardId)
            return;

        _loadedCardId = StudyCardId;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        Card = await StudyCardService.GetByIdAsync(StudyCardId, StudyCardIncludes.Full) ?? new StudyCardModel();

        var navigationIds = await StudyCardService.GetNavigationIdsAsync(UnitId, StudyCardId);
        PreviousId = navigationIds.PreviousId;
        NextId = navigationIds.NextId;
        Position = navigationIds.Position;
        Total = navigationIds.Total;

        breadcrumbs = BreadcrumbBuilder.Create()
            .WithHome()
            .WithLink("Курси", "/courses")
            .WithLink(Card.Unit?.Course?.Title ?? "Курс", $"/courses/{CourseId}")
            .WithLink(Card.Unit?.Title ?? "Unit", $"/courses/{CourseId}/units/{UnitId}")
            .WithLink("Навчальні картки", $"/courses/{CourseId}/units/{UnitId}?tab=study-cards")
            .WithActive(GetTitle())
            .Build();
    }

    private string GetTitle() =>
        string.IsNullOrEmpty(Card.Title)
            ? (Card.Kind == StudyCardKind.BlurredText ? "Розмитий текст" : "Без назви")
            : Card.Title;

    private string GetKindLabel() => Card.Kind switch
    {
        StudyCardKind.Term => "Термін",
        StudyCardKind.Text => "Текст",
        StudyCardKind.BlurredText => "Розмиті слова",
        _ => Card.Kind.ToString()
    };
}
