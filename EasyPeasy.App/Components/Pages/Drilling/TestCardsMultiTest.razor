@page "/courses/{CourseId:int}/units/{UnitId:int}/test-cards/practice"
@page "/courses/{CourseId:int}/test-cards/practice"
@inject PracticeQueueService PracticeQueueService

<PageShell Title="Практика тестових карток" Breadcrumbs="breadcrumbs" Width="PageWidth.Narrow">

    <MultiTestHost TItem="TestCardTestModel"
        Definitions="@_definitions"
        Items="@_items"
        IsLoading="@_isLoading"
        ErrorMessage="@_errorMessage"
        OnFinish="@FinishTest" />
</PageShell>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int? UnitId { get; set; }

    private List<TestCardTestModel> _items = [];
    private List<TestDefinition<TestCardTestModel>> _definitions = [.. TestRegistry.TestCardTests];
    private bool _isLoading;
    private string? _errorMessage;
    private List<Breadcrumb.BreadcrumbItem> breadcrumbs = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;

            await BuildBreadcrumbsAsync();

            var keys = ParseKeys("tests");
            if (keys.Count > 0)
                _definitions = TestRegistry.TestCardTests.Where(d => keys.Contains(d.Key)).ToList();

            var itemIds = ParseIds("itemIds");
            if (itemIds.Count > 0)
            {
                var cards = await TestCardService.GetByIdsAsync(itemIds);
                _items = mapper.Map<List<TestCardTestModel>>(cards);
            }
            else if (UnitId.HasValue)
            {
                var unit = await UnitService.GetByIdAsync(UnitId.Value, UnitIncludes.Full);
                _items = mapper.Map<List<TestCardTestModel>>(unit?.TestCards ?? new List<TestCardModel>());
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Помилка завантаження: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task BuildBreadcrumbsAsync()
    {
        var course = await CourseService.GetByIdAsync(CourseId);
        var builder = BreadcrumbBuilder.Create()
            .WithHome()
            .WithLink("Курси", "/courses")
            .WithLink(course?.Title ?? "Курс", $"/courses/{CourseId}");

        if (UnitId.HasValue)
        {
            var unit = await UnitService.GetByIdAsync(UnitId.Value);
            builder = builder.WithLink(unit?.Title ?? "Модуль", $"/courses/{CourseId}/units/{UnitId}");
        }

        breadcrumbs = builder.WithActive("Практика тестових карток").Build();
    }

    private async Task FinishTest()
    {
        try
        {
            var toUpdate = WordRatingCalculator.UpdateWordRate(_items);
            await TestCardService.UpdateRateRangeAsync(mapper.Map<List<UpdateWordRateRequest>>(toUpdate));
        }
        catch (Exception ex)
        {
            _errorMessage = $"Помилка збереження результатів: {ex.Message}";
            return;
        }

        var next = PracticeQueueService.Advance();
        NavigationManager.NavigateTo(next ?? (UnitId.HasValue ? $"/courses/{CourseId}/units/{UnitId}" : $"/courses/{CourseId}"));
    }

    private HashSet<string> ParseKeys(string paramName)
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return (query[paramName] ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
    }

    private List<int> ParseIds(string paramName)
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return (query[paramName] ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(int.Parse)
            .ToList();
    }
}

