@page "/courses/{CourseId:int}/units/{UnitId:int}/examples/practice"

<PageShell Title="Вивчення прикладів" Breadcrumbs="breadcrumbs" Width="PageWidth.Wide">

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner-border" role="status"></div>
        </div>
    }
    else if (wordOptions.Count == 0)
    {
        <div class="empty-container">
            <p class="empty-message">У цьому модулі немає слів із прикладами речень.</p>
        </div>
    }
    else
    {
        <div class="setup-grid">
            <div class="setup-column">
                <ItemPickerList Items="@wordOptions"
                                @bind-SelectedIds="selectedWordIds"
                                Title="Приклади яких слів вивчати"
                                SelectAllLabel="Вибрати всі"
                                EmptyText="Немає слів із прикладами." />

                <QuickFilterBlock Description="@LearningFilterPanel.Describe(filterOptions)"
                                  Applied="@(filteredIds is not null)"
                                  Changed="@FilterChangedByHand"
                                  SelectedCount="@selectedWordIds.Count"
                                  TotalCount="@wordOptions.Count"
                                  OnReset="ResetSelection">
                    <LearningFilterPanel Options="filterOptions"
                                         MaxCount="@wordOptions.Count"
                                         TotalCount="@wordOptions.Count"
                                         ResultCount="@(filteredIds?.Count)"
                                         OnApply="ApplyQuickFilter"
                                         OnReset="ResetSelection" />
                </QuickFilterBlock>
            </div>

            <div class="setup-column">
                <ExerciseTypeList Options="@exerciseOptions" @bind-SelectedKeys="selectedTestKeys" />
            </div>
        </div>

        @if (selectedWordIds.Count > 0 && selectedTestKeys.Count > 0)
        {
            <div class="multi-test-section">
                <div class="multi-test-card">
                    <div class="multi-test-info">
                        <h3 class="multi-test-title">
                            <i class="bi bi-collection"></i>
                            Готово до старту
                        </h3>
                        <p class="multi-test-description">
                            Прикладів: <strong>@selectedWordIds.Count</strong>, вправ: <strong>@selectedTestKeys.Count</strong>
                        </p>
                    </div>
                    <button class="btn-multi-test" @onclick="StartPractice">
                        <i class="bi bi-play-fill"></i>
                        Почати
                    </button>
                </div>
            </div>
        }
    }
</PageShell>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int UnitId { get; set; }

    private List<WordModel> wordsWithExamples = new();
    private List<OptionDefinition> wordOptions = new();
    private HashSet<int> selectedWordIds = new();
    private HashSet<string> selectedTestKeys = new();
    // The page opens with everything selected, so the panel has to say "усі" too — the default
    // WordCount of 15 would describe a selection that has not happened.
    private LearningSelectionOptions filterOptions = new() { WordCount = 0 };

    /// <summary>What the last quick-filter run selected; null — the filter has not run.</summary>
    private HashSet<int>? filteredIds;

    /// <summary>The filter ran, but the learner has ticked items by hand since — so it no longer describes the selection.</summary>
    private bool FilterChangedByHand => filteredIds is not null && !selectedWordIds.SetEquals(filteredIds);

    private bool isLoading = true;
    private List<Breadcrumb.BreadcrumbItem> breadcrumbs = new();

    private readonly List<ExerciseOption> exerciseOptions = ExerciseCatalog.Examples;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            var unit = await UnitService.GetByIdAsync(UnitId, UnitIncludes.Full);
            breadcrumbs = BreadcrumbBuilder.Create()
                .WithHome()
                .WithLink("Курси", "/courses")
                .WithLink(unit?.Course?.Title ?? "Курс", $"/courses/{CourseId}")
                .WithLink(unit?.Title ?? "Модуль", $"/courses/{CourseId}/units/{UnitId}")
                .WithActive("Вивчення прикладів")
                .Build();

            var allWords = (await WordService.GetByUnitAsync(UnitId, ["Examples"])).ToList();
            wordsWithExamples = allWords.Where(w => w.Examples is { Count: > 0 }).ToList();
            wordOptions = wordsWithExamples.Select(w => new OptionDefinition { Id = w.Id, Title = BuildLabel(w) }).ToList();
            selectedWordIds = wordOptions.Select(o => o.Id).ToHashSet();
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string BuildLabel(WordModel w)
        => string.IsNullOrWhiteSpace(w.Translation) ? w.Word : $"{w.Word} — {w.Translation}";

    private async Task ApplyQuickFilter()
    {
        var result = await WordService.GetForLearningAsync(CourseId, UnitId, filterOptions);
        var withExamplesIds = wordsWithExamples.Select(w => w.Id).ToHashSet();
        selectedWordIds = result.Where(w => withExamplesIds.Contains(w.Id)).Select(w => w.Id).ToHashSet();
        filteredIds     = new HashSet<int>(selectedWordIds);
    }

    private void ResetSelection()
    {
        selectedWordIds = wordOptions.Select(o => o.Id).ToHashSet();
        filteredIds     = null;
    }

    private void StartPractice()
    {
        var wordIds = string.Join(",", selectedWordIds);
        var tests = string.Join(",", selectedTestKeys);
        NavigationManager.NavigateTo($"/courses/{CourseId}/units/{UnitId}/examples/practice/session?wordIds={wordIds}&tests={tests}");
    }
}

<style>

    .setup-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
        gap: 2rem;
        align-items: start;
        margin-top: 1.5rem;
    }

    .loading-container, .empty-container {
        text-align: center;
        padding: 3rem 1rem;
    }

    .multi-test-section { margin-top: 2rem; }

    .multi-test-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .multi-test-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0 0 0.25rem 0;
        color: var(--text-primary);
    }

    .multi-test-description {
        margin: 0;
        color: var(--text-secondary);
    }

    .btn-multi-test {
        background: linear-gradient(135deg, #A3BFFA, #B5EAD7);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 0.875rem 1.75rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s;
    }

    .btn-multi-test:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(163, 191, 250, 0.35);
    }
</style>
