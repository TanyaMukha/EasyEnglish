@*
    Thin wrapper around MultiTestEngine: every decision (queue, phases, ratings, statistics)
    is made by the engine, what is left here is rendering and forwarding events.
*@

@typeparam TItem

<DrillingPageLayout
    Title="@(_engine?.CurrentDefinition?.Title ?? DefaultTitle)"
    HeaderClass="@(_engine?.CurrentDefinition?.HeaderClass ?? "pastel-blue")"
    IconClass="@(_engine?.CurrentDefinition?.IconClass ?? "bi-collection")"
    Rate="@CurrentRate"
    TotalCount="@(_engine?.DisplayTotal ?? 0)"
    CompletedCount="@(_engine?.ProgressCompleted ?? 0)"
    IsLoading="@IsLoading"
    ErrorMessage="@ErrorMessage"
    ShowStats="@(_engine?.ShowStats ?? false)"
    CompletedWords="@(_engine?.CompletedCount ?? 0)"
    TotalAttempts="@(_engine?.TotalAttempts ?? 0)"
    CorrectAnswers="@(_engine?.CorrectAnswers ?? 0)"
    IncorrectAnswers="@(_engine?.IncorrectAnswers ?? 0)"
    ShowNextButton="@(_engine?.ShowNextButton ?? false)"
    IsBrowseMode="@(_engine?.InBrowsePhase ?? false)"
    HasTestsAhead="@(_engine?.HasTestsAhead ?? false)"
    BrowseCards="@(_engine?.BrowseCards ?? [])"
    CurrentCardIndex="@(_engine?.BrowseIndex ?? 0)"
    OnJumpToCard="@OnJumpToCard"
    OnPrevCard="@OnPrev"
    OnGoToTests="@OnGoToTests"
    OnFinishEarly="@OnFinishEarly"
    OnNextCard="@OnNext"
    OnFinish="@OnFinish">

    <ChildContent>
        @if (_engine?.CurrentDefinition is not null && _cardParams.Count > 0)
        {
            <DynamicComponent
            Type="@_engine.CurrentDefinition.ComponentType"
            Parameters="@_cardParams" />
        }
    </ChildContent>
</DrillingPageLayout>

@code {
    // ── Parameters ────────────────────────────────────────────────────────────

    [Parameter, EditorRequired]
    public IReadOnlyList<TestDefinition<TItem>> Definitions { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public EventCallback OnFinish { get; set; }

    [Parameter] public string  DefaultTitle  { get; set; } = "Мульті-тест";
    [Parameter] public bool    IsLoading     { get; set; }
    [Parameter] public string? ErrorMessage  { get; set; }
    [Parameter] public float   Rate          { get; set; }

    // ── State ─────────────────────────────────────────────────────────────────

    private MultiTestEngine<TItem>?     _engine;
    private Dictionary<string, object?> _cardParams = [];

    /// <summary>Rating of the card on screen, falling back to the session value from the page.</summary>
    private float CurrentRate => _engine?.CurrentRating is { } rate ? (float)rate : Rate;

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override void OnParametersSet()
    {
        if (_engine is null && Items.Count > 0 && Definitions.Count > 0)
        {
            _engine = new MultiTestEngine<TItem>(Definitions, Items);
            RebuildCardParams();
        }
    }

    private void RebuildCardParams()
    {
        if (_engine?.CurrentDefinition is null || _engine.CurrentViewModel is null) return;

        var callbacks = new TestCallbacks(
            OnCheckAnswer: EventCallback.Factory.Create<bool>(this, HandleCheckAnswer),
            OnReveal:      EventCallback.Factory.Create(this, HandleReveal),
            OnRate:        EventCallback.Factory.Create<double>(this, HandleRate)
        );

        var context = new TestCardContext
        {
            ViewModel = _engine.CurrentViewModel,
            RawItem   = _engine.CurrentItem as object,
            State     = _engine.State,
            Callbacks = callbacks,
        };

        _cardParams = new Dictionary<string, object?> { ["Context"] = context };
    }

    // ── Card events ───────────────────────────────────────────────────────────

    private void HandleCheckAnswer(bool isCorrect) => Apply(() => _engine!.RecordAnswer(isCorrect));
    private void HandleReveal()                    => Apply(() => _engine!.Reveal());
    private void HandleRate(double rating)         => Apply(() => _engine!.Rate(rating));

    // ── Navigation ────────────────────────────────────────────────────────────

    private Task OnNext()             { Apply(() => _engine!.Next());        return Task.CompletedTask; }
    private Task OnPrev()             { Apply(() => _engine!.Previous());    return Task.CompletedTask; }
    private Task OnGoToTests()        { Apply(() => _engine!.GoToTests());   return Task.CompletedTask; }
    private Task OnJumpToCard(int i)  { Apply(() => _engine!.JumpTo(i));     return Task.CompletedTask; }
    private void OnFinishEarly()      => Apply(() => _engine!.FinishEarly());

    private void Apply(Action change)
    {
        if (_engine is null) return;

        change();
        RebuildCardParams();
        StateHasChanged();
    }
}
