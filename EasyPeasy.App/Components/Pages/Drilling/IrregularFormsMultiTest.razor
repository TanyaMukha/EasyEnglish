@page "/courses/{CourseId:int}/units/{UnitId:int}/irregular-forms/practice/session"
@page "/courses/{CourseId:int}/irregular-forms/practice/session"
@inject ILogger<IrregularFormsMultiTest> Logger
@inject PracticeQueueService PracticeQueueService

<PageShell Title="Вивчення неправильних форм" Breadcrumbs="breadcrumbs" Width="PageWidth.Narrow">

    <MultiTestHost TItem="IrregularFormTestModel"
        Definitions="@_definitions"
        Items="@_items"
        IsLoading="@_isLoading"
        ErrorMessage="@_errorMessage"
        OnFinish="@FinishTest" />
</PageShell>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int? UnitId { get; set; }

    private List<IrregularFormTestModel>               _items       = [];
    private List<TestDefinition<IrregularFormTestModel>> _definitions = [];
    private bool    _isLoading;
    private string? _errorMessage;
    private List<Breadcrumb.BreadcrumbItem> breadcrumbs = new();

    protected override async Task OnInitializedAsync()
    {
        _definitions = ParseKeys("tests")
            .Select(key => TestRegistry.GetIrregularFormTest(key))
            .OfType<TestDefinition<IrregularFormTestModel>>()
            .ToList();

        await BuildBreadcrumbsAsync();
        await LoadData();
    }

    private async Task BuildBreadcrumbsAsync()
    {
        var course = await CourseService.GetByIdAsync(CourseId);
        var builder = BreadcrumbBuilder.Create()
            .WithHome()
            .WithLink("Курси", "/courses")
            .WithLink(course?.Title ?? "Курс", $"/courses/{CourseId}");

        if (UnitId.HasValue)
        {
            var unit = await UnitService.GetByIdAsync(UnitId.Value);
            builder = builder.WithLink(unit?.Title ?? "Модуль", $"/courses/{CourseId}/units/{UnitId}");
        }

        breadcrumbs = builder.WithActive("Вивчення неправильних форм").Build();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            StateHasChanged();
            var formIds = ParseIds("formIds");
            var forms = await IrregularFormService.GetByIdsAsync(formIds);
            _items = mapper.Map<List<IrregularFormTestModel>>(forms);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Помилка завантаження: {ex.Message}";
            Logger.LogError(ex, "Error loading irregular forms for multi-test");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task FinishTest()
    {
        try
        {
            var toUpdate = WordRatingCalculator.UpdateWordRate(_items);
            await IrregularFormService.UpdateRateRangeAsync(mapper.Map<List<UpdateWordRateRequest>>(toUpdate));
        }
        catch (Exception ex)
        {
            _errorMessage = $"Помилка збереження результатів: {ex.Message}";
            return;
        }

        var next = PracticeQueueService.Advance();
        NavigationManager.NavigateTo(next ?? (UnitId.HasValue ? $"/courses/{CourseId}/units/{UnitId}" : $"/courses/{CourseId}"));
    }

    private HashSet<string> ParseKeys(string paramName)
    {
        var uri   = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return (query[paramName] ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .ToHashSet();
    }

    private List<int> ParseIds(string paramName)
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return (query[paramName] ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(int.Parse)
            .ToList();
    }
}

