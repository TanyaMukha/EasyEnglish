<TestCardQuestionSection Text="@Item.Question" Hint="@Item.Hint" Image="@Item.Image" FormattedText="@Item.FormattedText" />

<AnswerInputSection
    isAnswerSubmitted="@Context.State.IsAnswerSubmitted"
    CorrectAnswer="@(Item.ShortAnswer?.AcceptableAnswers.FirstOrDefault() ?? "")"
    AcceptableAnswers="@Item.ShortAnswer?.AcceptableAnswers"
    OnAnswerSubmitted="@Context.Callbacks.OnCheckAnswer" />

<TestCardExplanationSection Explanation="@Item.Explanation" IsAnswerSubmitted="@Context.State.IsAnswerSubmitted" IsCorrect="@Context.State.IsCorrect" />

@code {
    [Parameter, EditorRequired]
    public TestCardContext Context { get; set; } = null!;

    private TestCardTestModel Item => Context.GetRawItem<TestCardTestModel>();
}
