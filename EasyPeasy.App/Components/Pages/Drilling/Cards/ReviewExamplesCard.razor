<div class="DrillingReviewCardContent">
    <div class="example-container">
        @* Sentence and its translation — one block, centred in the card *@
        <div class="example-block">
            <div class="sentence-text">
                @((MarkupString)ExampleMarkdownService.RenderMarkdown(_item.Sentence))
            </div>

            @if (!string.IsNullOrEmpty(_item.Translation))
            {
                <div class="sentence-translation">
                    @((MarkupString)ExampleMarkdownService.RenderMarkdown(_item.Translation))
                </div>
            }
        </div>
    </div>

    <DifficultyRatingSection
        OnRate="@Context.Callbacks.OnRate"
        IsRating="@Context.State.IsRating"
        IsRated="@Context.State.IsRated"
        LastRatedValue="@Context.State.LastRatedValue" />
</div>

@code {
    [Parameter, EditorRequired]
    public TestCardContext Context { get; set; } = null!;

    private ExampleModel _item => Context.GetRawItem<ExampleModel>();
}

<style>
    .example-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        margin-bottom: 2rem;
    }

    /* Shared container for the sentence and its translation */
    .example-block {
        width: 100%;
        max-width: 34rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.5rem;
        background: var(--surface-alt);
        border-radius: 12px;
        text-align: center;
    }

    .sentence-translation {
        font-size: 1.05rem;
        line-height: 1.6;
        color: var(--text-secondary);
        font-style: italic;
    }

    .sentence-translation :deep(strong) { color: #1976D2; font-weight: 700; }
    .sentence-translation :deep(em)     { color: #7B1FA2; font-style: italic; }

    .sentence-section {
        border-radius: 8px;
        padding: 1.25rem 1.5rem;
    }

    .sentence-section.english {
        background: var(--surface-alt);
        border-left: 4px solid #A3BFFA;
    }

    .sentence-section.translation {
        background: var(--surface-alt);
        border-left: 4px solid var(--border-muted);
    }

    .language-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-secondary);
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .sentence-text {
        font-size: 1.25rem;
        line-height: 1.8;
        color: var(--text-primary);
    }

    .sentence-text :deep(strong) { color: #1976D2; font-weight: 700; }
    .sentence-text :deep(em)     { color: #7B1FA2; font-style: italic; }

    @@media (max-width: 768px) {
        .sentence-text { font-size: 1.125rem; }
    }
</style>
