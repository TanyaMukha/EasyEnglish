@page "/subjects/{id:int}/edit"
@page "/subjects/create"

@using EasyEnglish.App.Components.Shared
@using EasyEnglish.App.Components.Shared.Breadcrumb

<div class="page-content">
    <div class="header-section">
        <Breadcrumb Items="breadcrumbs" />

        <h1 class="page-title">
            <i class="bi @(IsEditMode ? "bi-pencil" : "bi-plus-circle")"></i>
            @(IsEditMode ? "Редагувати предмет" : "Новий предмет")
        </h1>
    </div>

    <div class="edit-form-container">
        <EditForm Model="subject" OnValidSubmit="HandleValidSubmit" class="edit-form">
            <DataAnnotationsValidator />

            <div class="form-section">
                <h2 class="section-title">
                    <i class="bi bi-info-circle"></i>
                    Основна інформація
                </h2>

                <InputTextField @bind-Value="subject.Title"
                                Label="Назва предмету" />
                <ValidationMessage For="@(() => subject.Title)" class="validation-message" />

                <InputMultilineField @bind-Value="subject.Description"
                                     Label="Опис"
                                     Rows="2" />
                <ValidationMessage For="@(() => subject.Description)" class="validation-message" />
            </div>

            <div class="form-actions">
                <a href="/subjects" class="btn-cancel">
                    <i class="bi bi-x-lg"></i>
                    Скасувати
                </a>
                <button type="submit" class="btn-submit">
                    <i class="bi @(IsEditMode ? "bi-check-lg" : "bi-plus-lg")"></i>
                    @(IsEditMode ? "Оновити" : "Створити")
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; } = 0;

    public SubjectModel subject { get; set; } = new();

    private bool IsEditMode => Id > 0;

    private List<Breadcrumb.BreadcrumbItem> breadcrumbs = new();

    protected override async Task OnInitializedAsync()
    {
        if (IsEditMode)
        {
            subject = await SubjectService.GetByIdAsync(Id) ?? new SubjectModel();
        }
        else
        {
            subject = new SubjectModel();
        }

        breadcrumbs = BreadcrumbBuilder.Create()
            .WithHome()
            .WithLink("Предмети", "/subjects")
            .WithActive(IsEditMode ? subject.Title : "Новий предмет")
            .Build();
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (IsEditMode)
            {
                await SubjectService.UpdateAsync(subject.Id, subject);
            }
            else
            {
                await SubjectService.CreateAsync(subject);
            }

            NavigationManager.NavigateTo("/subjects");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving subject: {ex.Message}");
        }
    }
}
