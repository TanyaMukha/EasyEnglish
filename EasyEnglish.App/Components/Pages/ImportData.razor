@page "/import"
@using EasyEnglish.App.Components.Shared
@using EasyEnglish.App.Interfaces
@using EasyEnglish.Core.Models
@using EasyEnglish.Services
@inject UnitBackupService UnitBackupService
@inject IFileService FileService
@inject IJSRuntime JSRuntime

<div class="page-wrapper">
    <div class="scroll-area">
        <div class="edit-page">
            <div class="header-section">
                <h1 class="page-title">
                    <i class="bi bi-box-arrow-in-down"></i>
                    Імпорт словника
                </h1>
                <p class="page-description">Завантажте JSON файл для імпорту слів у словник</p>
            </div>

            <div class="form-container">
                <div class="form-section">
                    <h2 class="section-title">
                        <i class="bi bi-gear"></i>
                        Налаштування імпорту
                    </h2>

                    <InputSelectField @bind-Value="selectedCourseId" Label="Словник для імпорту">
                        @foreach (var dict in availableCourses)
                        {
                            <option value="@dict.Id">@dict.Title</option>
                        }
                    </InputSelectField>

                    <div class="file-picker-section">
                        <label class="form-label">JSON файл для імпорту</label>
                        <button class="btn-file-picker" @onclick="PickFile" disabled="@isProcessing">
                            <i class="bi bi-file-earmark-arrow-up"></i>
                            @(selectedFileName ?? "Виберіть файл...")
                        </button>
                    </div>

                    @if (importError != null)
                    {
                        <div class="alert alert-error">
                            <i class="bi bi-exclamation-triangle"></i>
                            <div>
                                <strong>Помилка:</strong>
                                <p>@importError</p>
                            </div>
                        </div>
                    }
                </div>

                @if (unit?.Words?.Any() == true)
                {
                    <div class="form-section preview-section">
                        <h2 class="section-title">
                            <i class="bi bi-eye"></i>
                            Попередній перегляд
                        </h2>

                        <InputTextField @bind-Value="unit.Title" Label="Назва модулю" />

                        <InputMultilineField @bind-Value="unit.Description"
                        Label="Опис"
                        Rows="1" />

                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Слово</th>
                                        <th>Транскрипція</th>
                                        <th>Переклад</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var (item, index) in unit.Words.Take(10).Select((word, i) => (word, i + 1)))
                                    {
                                        <tr>
                                            <td>@index</td>
                                            <td><strong>@item.Word</strong></td>
                                            <td>@item.Transcription</td>
                                            <td>@item.Translation</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            @if (unit.Words.Count > 10)
                            {
                                <div class="table-footer">
                                    <i class="bi bi-three-dots"></i>
                                    і ще @(unit.Words.Count - 10) елементів
                                </div>
                            }
                        </div>

                        <div class="checkbox-group">
                            @if (initOptions.includeExamples)
                            {
                                <InputCheckboxField @bind-Value="options.includeExamples"
                                    Label="Приклади використання"
                                    Icon="bi-file-text" />
                            }
                            
                            @if (initOptions.includeLearningProgress)
                            {
                                <InputCheckboxField @bind-Value="options.includeLearningProgress"
                                    Label="Прогрес вивчення"
                                    Icon="bi-tags" />
                            }

                            @if (initOptions.isFullBackup)
                            {
                                <InputCheckboxField @bind-Value="options.isFullBackup"
                                    Label="Резервна копія"
                                    Icon="bi-list-ul" />
                            }
                        </div>
                    </div>
                }
                <div>
                    @if (importSuccess != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i>
                            <div>
                                <p>@importSuccess</p>
                            </div>
                        </div>
                    }

                    <div class="form-actions">
                        @if (unit is not null)
                        {
                            <button class="btn-submit"
                            @onclick="SaveImportedUnit"
                            disabled=@isProcessing>
                                @if (isProcessing)
                                {
                                    <span class="spinner"></span>
                                    <text>Збереження...</text>
                                }
                                else
                                {
                                    <i class="bi bi-save"></i>
                                    <text>Зберегти модуль</text>
                                }
                            </button>
                        }
                    </div>
                </div>
            </div>
            
            <div class="keyboard-spacer"></div>
        </div>
    </div>
</div>

@code {
    private UnitModel? unit = null;
    private List<CourseModel> availableCourses = new();
    private bool isProcessing = false;
    private string? selectedFileName;

    private UnitBackupOptions options = new();
    private UnitBackupOptions initOptions = new();

    private int selectedCourseId = 0;

    private string? importError;
    private string? importSuccess;

    protected override async Task OnInitializedAsync()
    {
        availableCourses = (await CourseService.GetAllAsync()).ToList();
        if (availableCourses.Any())
        {
            selectedCourseId = availableCourses.First().Id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // ВИПРАВЛЕНО: scrollIntoView з block: 'center'
            await JSRuntime.InvokeVoidAsync("eval", @"
                (function() {
                    document.addEventListener('focusin', function(e) {
                        const element = e.target;
                        if (element.tagName === 'INPUT' || 
                            element.tagName === 'TEXTAREA' || 
                            element.tagName === 'SELECT') {
                            
                            setTimeout(function() {
                                element.scrollIntoView({
                                    behavior: 'smooth',
                                    block: 'center',
                                    inline: 'nearest'
                                });
                            }, 300);
                        }
                    });
                })();
            ");
        }
    }

    private void ClearMessages()
    {
        importError = null;
        importSuccess = null;
    }

    private async Task PickFile()
    {
        ClearMessages();
        isProcessing = true;

        try
        {
            var json = await FileService.PickAndReadFileAsync("application/json", ".json");

            if (string.IsNullOrEmpty(json))
            {
                return;
            }

            selectedFileName = "Файл вибрано";

            if (!UnitBackupService.ValidateJson(json))
            {
                importError = "Невалідний JSON файл. Перевірте структуру файлу.";
                selectedFileName = null;
                return;
            }

            UnitBackup? backup = UnitBackupService.ImportFromJson(json);
            if (backup is not null)
            {
                unit = backup.Unit;
                options = initOptions = backup.Options;
                selectedFileName = $"{unit.Title}.json";
            }
        }
        catch (Exception ex)
        {
            importError = $"Помилка при читанні файлу: {ex.Message}";
            selectedFileName = null;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task SaveImportedUnit()
    {
        if (unit is null) return;

        isProcessing = true;
        ClearMessages();

        try
        {
            if (options is not null)
            {
                if (initOptions.isFullBackup && !options.isFullBackup)
                {
                    unit.ClearKeyFields();
                }
                if (initOptions.includeExamples && !options.includeExamples)
                {
                    unit.RemoveExamples();
                }
                if (initOptions.includeLearningProgress && !options.includeLearningProgress)
                {
                    unit.ClearLearningProgress();
                }
            }
            
            unit.CourseId = selectedCourseId;

            await UnitService.CreateAsync(unit);
            importSuccess = $"Збережено {unit.Words?.Count} елементів в базу даних.";
            selectedFileName = null;
            unit = null;
        }
        catch (Exception ex)
        {
            importError = $"Помилка збереження: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
}

<style>
    .page-wrapper {
        display: flex;
        flex-direction: column;
        height: 100vh;
        height: 100dvh;
        overflow: hidden;

        border-top: 1px solid #e0e0e0;
        border-bottom: 1px solid #e0e0e0;
    }
    
    .scroll-area {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;
    }
    
    .keyboard-spacer {
        height: 0;
    }
    
    .edit-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .header-section {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        color: #333;
        margin: 0 0 0.5rem 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .page-title i {
        color: #A3BFFA;
    }

    .page-description {
        color: #666;
        font-size: 1rem;
        margin: 0;
    }

    .form-container {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .form-section {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-section:not(:last-child) {
        margin-bottom: 2rem;
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #333;
        margin: 0 0 1rem 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .section-title i {
        color: #A3BFFA;
    }

    .file-picker-section {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #333;
        font-size: 0.95rem;
    }

    .btn-file-picker {
        padding: 0.875rem 1.5rem;
        border-radius: 10px;
        font-weight: 500;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border: 2px dashed #A3BFFA;
        background: rgba(163, 191, 250, 0.05);
        color: #5a7fb8;
        text-align: left;
    }

    .btn-file-picker:hover:not(:disabled) {
        background: rgba(163, 191, 250, 0.1);
        border-color: #7ea0f0;
    }

    .btn-file-picker:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-file-picker i {
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 1rem;
    }

    .btn-submit {
        padding: 0.875rem 2rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        border: none;
        background: linear-gradient(135deg, #A3BFFA, #B5EAD7);
        color: white;
        box-shadow: 0 4px 12px rgba(163, 191, 250, 0.3);
    }

    .btn-submit:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(163, 191, 250, 0.4);
    }

    .btn-submit:active {
        transform: translateY(0);
    }

    .btn-submit:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    .spinner {
        display: inline-block;
        width: 16px;
        height: 16px;
        border: 2px solid #ffffff;
        border-radius: 50%;
        border-top-color: transparent;
        animation: spin 1s ease-in-out infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .alert {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 1rem 1.25rem;
        border-radius: 10px;
        border: 1px solid;
        margin-top: 1rem;
    }

    .alert i {
        font-size: 1.25rem;
        flex-shrink: 0;
        margin-top: 0.125rem;
    }

    .alert div {
        flex: 1;
    }

    .alert strong {
        display: block;
        margin-bottom: 0.25rem;
    }

    .alert p {
        margin: 0;
    }

    .alert-success {
        background: rgba(181, 234, 215, 0.15);
        color: #155724;
        border-color: rgba(181, 234, 215, 0.5);
    }

    .alert-success i {
        color: #28a745;
    }

    .alert-error {
        background: rgba(220, 53, 69, 0.1);
        color: #721c24;
        border-color: rgba(220, 53, 69, 0.3);
    }

    .alert-error i {
        color: #dc3545;
    }

    .preview-section {
        margin-top: 0;
    }

    .table-wrapper {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        overflow: hidden;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
    }

    .data-table thead {
        background: #f8f9fa;
    }

    .data-table th {
        padding: 0.875rem 1rem;
        text-align: left;
        font-weight: 600;
        color: #333;
        border-bottom: 2px solid #dee2e6;
    }

    .data-table td {
        padding: 0.875rem 1rem;
        border-bottom: 1px solid #f0f0f0;
    }

    .data-table tbody tr:last-child td {
        border-bottom: none;
    }

    .data-table tbody tr:hover {
        background: rgba(163, 191, 250, 0.05);
    }

    .table-footer {
        padding: 0.875rem 1rem;
        text-align: center;
        background: #f8f9fa;
        color: #666;
        font-style: italic;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .checkbox-group {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    @@media (max-width: 768px) {
        .edit-page {
            padding: 1.5rem 1rem;
        }

        .form-container {
            padding: 1.5rem;
        }

        .page-title {
            font-size: 1.75rem;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-submit,
        .btn-file-picker {
            width: 100%;
            justify-content: center;
        }

        .data-table {
            font-size: 0.875rem;
        }

        .data-table th,
        .data-table td {
            padding: 0.625rem 0.75rem;
        }
        
        .keyboard-spacer {
            height: 350px;
        }
    }
</style>
