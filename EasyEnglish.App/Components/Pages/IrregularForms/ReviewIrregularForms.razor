@page "/review-irregular-forms"
@using EasyEnglish.App.Components.Shared
@using EasyEnglish.App.Models
@using EasyEnglish.App.Components.Pages.Learning.Shared
@inject NavigationManager NavigationManager
@inject IBrowserConsoleService BrowserConsole

<div class="page-content">
    <PageHeader Title="Перегляд неправильних форм" />

    <LearningCard 
        Title="Перегляд"
        HeaderClass="pastel-blue"
        IconClass="bi-book"
        Rate="@(currentItem?.Rate ?? 0)"
        TotalCount="@totalItems"
        CompletedCount="@completed"
        IsLoading="@isLoading"
        ErrorMessage="@errorMessage"
        ShowStats="@showStats"
        CompletedWords="@completed"
        TotalAttempts="@totalAttempts"
        CorrectAnswers="@correctAnswers"
        IncorrectAnswers="@incorrectAnswers"
        ShowNextButton="true"
        OnNextCard="@NextItem"
        OnFinish="@FinishTest">

        <ChildContent>
            @if (currentItem != null)
            {
                <!-- Part of Speech Badge -->
                @if (!string.IsNullOrEmpty(currentItem.PartOfSpeech))
                {
                    <div class="part-of-speech-badge">
                        <span class="badge">@GetPartOfSpeechLabel(currentItem.PartOfSpeech)</span>
                    </div>
                }

                <!-- Forms Display -->
                <div class="forms-container">
                    <!-- First Form -->
                    <div class="form-section">
                        <h3 class="form-label">@GetFormLabel(1)</h3>
                        <div class="form-content">
                            <div class="form-word">@currentItem.FirstForm</div>
                            @if (!string.IsNullOrEmpty(currentItem.FirstFormTranscription))
                            {
                                <div class="form-transcription">[@currentItem.FirstFormTranscription]</div>
                            }
                            @if (!string.IsNullOrEmpty(currentItem.FirstFormTranslation))
                            {
                                <div class="form-translation">@currentItem.FirstFormTranslation</div>
                            }
                        </div>
                    </div>

                    <!-- Second Form -->
                    <div class="form-section">
                        <h3 class="form-label">@GetFormLabel(2)</h3>
                        <div class="form-content">
                            <div class="form-word">@currentItem.SecondForm</div>
                            @if (!string.IsNullOrEmpty(currentItem.SecondFormTranscription))
                            {
                                <div class="form-transcription">[@currentItem.SecondFormTranscription]</div>
                            }
                            @if (!string.IsNullOrEmpty(currentItem.SecondFormTranslation))
                            {
                                <div class="form-translation">@currentItem.SecondFormTranslation</div>
                            }
                        </div>
                    </div>

                    <!-- Third Form (if exists) -->
                    @if (!string.IsNullOrEmpty(currentItem.ThirdForm))
                    {
                        <div class="form-section">
                            <h3 class="form-label">@GetFormLabel(3)</h3>
                            <div class="form-content">
                                <div class="form-word">@currentItem.ThirdForm</div>
                                @if (!string.IsNullOrEmpty(currentItem.ThirdFormTranscription))
                                {
                                    <div class="form-transcription">[@currentItem.ThirdFormTranscription]</div>
                                }
                                @if (!string.IsNullOrEmpty(currentItem.ThirdFormTranslation))
                                {
                                    <div class="form-translation">@currentItem.ThirdFormTranslation</div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Difficulty Rating -->
                <DifficultyRatingSection 
                    OnRate="@RateForm"
                    IsRating="@isRating"
                    LastRatedValue="@lastRatedValue" />
            }
        </ChildContent>
    </LearningCard>
</div>

@code {
    // Data
    private List<IrregularFormModel> items = new();
    private IrregularFormModel? currentItem;
    private int currentIndex = 0;

    // State
    private bool isLoading = false;
    private string? errorMessage;
    private bool showStats = false;
    private bool isRating = false;
    private double lastRatedValue = 0;

    // Statistics
    private int totalItems = 0;
    private int totalAttempts = 0;
    private int correctAnswers = 0;
    private int incorrectAnswers = 0;
    private int completed => currentIndex;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            // TODO: Завантажити IrregularForm моделі з сервісу
            // items = await IrregularFormService.GetAllAsync();
            
            // Тимчасові дані для тестування
            items = new List<IrregularFormModel>
            {
                new IrregularFormModel 
                { 
                    Id = 1,
                    PartOfSpeech = "verb",
                    FirstForm = "go",
                    FirstFormTranscription = "ɡəʊ",
                    FirstFormTranslation = "йти",
                    SecondForm = "went",
                    SecondFormTranscription = "went",
                    ThirdForm = "gone",
                    ThirdFormTranscription = "ɡɒn"
                }
            };

            totalItems = items.Count;
            
            if (items.Any())
            {
                currentItem = items[currentIndex];
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            BrowserConsole.LogErrorAsync("Error loading irregular forms", ex);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RateForm(double rating)
    {
        if (currentItem == null) return;

        try
        {
            isRating = true;
            lastRatedValue = rating;

            // TODO: Зберегти оцінку
            // await IrregularFormService.UpdateRateAsync(currentItem.Id, rating);

            await Task.Delay(300); // Для анімації
        }
        catch (Exception ex)
        {
            BrowserConsole.LogErrorAsync("Error rating form", ex);
        }
        finally
        {
            isRating = false;
            StateHasChanged();
        }
    }

    private async Task NextItem()
    {
        currentIndex++;
        lastRatedValue = 0;

        if (currentIndex >= totalItems)
        {
            showStats = true;
        }
        else
        {
            currentItem = items[currentIndex];
        }

        StateHasChanged();
    }

    private void FinishTest()
    {
        NavigationManager.NavigateTo("/irregular-forms");
    }

    private string GetPartOfSpeechLabel(string partOfSpeech)
    {
        return partOfSpeech?.ToLower() switch
        {
            "verb" => "Verb (Дієслово)",
            "noun" => "Noun (Іменник)",
            "adjective" => "Adjective (Прикметник)",
            "adverb" => "Adverb (Прислівник)",
            _ => partOfSpeech ?? ""
        };
    }

    private string GetFormLabel(int formNumber)
    {
        if (currentItem == null || string.IsNullOrEmpty(currentItem.PartOfSpeech))
        {
            return formNumber switch
            {
                1 => "First Form",
                2 => "Second Form",
                3 => "Third Form",
                _ => "Form"
            };
        }

        return currentItem.PartOfSpeech.ToLower() switch
        {
            "verb" => formNumber switch
            {
                1 => "Infinitive (Base Form)",
                2 => "Past Simple",
                3 => "Past Participle",
                _ => "Form"
            },
            "noun" => formNumber switch
            {
                1 => "Singular",
                2 => "Plural",
                3 => "Alternative Plural",
                _ => "Form"
            },
            "adjective" => formNumber switch
            {
                1 => "Positive",
                2 => "Comparative",
                3 => "Superlative",
                _ => "Form"
            },
            "adverb" => formNumber switch
            {
                1 => "Positive",
                2 => "Comparative",
                3 => "Superlative",
                _ => "Form"
            },
            _ => $"Form {formNumber}"
        };
    }
}

<style>
    .page-content {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .part-of-speech-badge {
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: center;
    }

    .badge {
        background: #E3F2FD;
        color: #1976D2;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .forms-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin-bottom: 2rem;
    }

    .form-section {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 1.5rem;
    }

    .form-label {
        font-size: 0.875rem;
        font-weight: 600;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0 0 1rem 0;
    }

    .form-content {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-word {
        font-size: 2rem;
        font-weight: 700;
        color: #333;
    }

    .form-transcription {
        font-size: 1.25rem;
        color: #666;
        font-style: italic;
    }

    .form-translation {
        font-size: 1.125rem;
        color: #888;
    }

    @@media (max-width: 768px) {
        .form-word {
            font-size: 1.5rem;
        }

        .form-transcription {
            font-size: 1rem;
        }

        .form-translation {
            font-size: 0.9375rem;
        }
    }
</style>
