@page "/export"
@using EasyEnglish.App.Components.Shared
@using EasyEnglish.App.Interfaces
@using EasyEnglish.Core.Models
@using EasyEnglish.Services
@inject UnitBackupService UnitBackupService
@inject IFileService FileService
@inject ICourseService courseService
@inject IJSRuntime JSRuntime

<div class="page-wrapper">
    <div class="scroll-area">
        <div class="edit-page">
            <div class="header-section">
                <h1 class="page-title">
                    <i class="bi bi-box-arrow-up"></i>
                    Експорт словника
                </h1>
                <p class="page-description">Експортуйте ваші слова у JSON файл для резервного копіювання або обміну</p>
            </div>

            <div class="form-container">
                <div class="form-section">
                    <h2 class="section-title">
                        <i class="bi bi-gear"></i>
                        Налаштування експорту
                    </h2>

                    <InputSelectField @bind-Value="selectedCourseId"
                            @bind-Value:after="@(async () => await OnCourseChanged())"
                            Label="Словник для експорту"
                            EmptyOption="Виберіть словник">
                        @foreach (var dict in availableCourses)
                        {
                            <option value="@dict.Id">@dict.Title</option>
                        }
                    </InputSelectField>

                    <InputSelectField @bind-Value="selectedUnitId" 
                    Label="Набір для експорту"
                    EmptyOption="Виберіть набір">
                        @foreach (var list in availableUnits)
                        {
                            <option value="@list.Id">@list.Title</option>
                        }
                    </InputSelectField>

                    <InputTextWithSuffix @bind-Value="exportFileName"
                    Label="Ім'я файлу"
                    Suffix=".json"
                    Placeholder="my_vocabulary" />
                </div>

                <div class="form-section">
                    <h2 class="section-title">
                        <i class="bi bi-sliders"></i>
                        Параметри експорту
                    </h2>

                    <div class="checkbox-group">
                        <InputCheckboxField @bind-Value="options.includeExamples"
                        Label="Приклади використання"
                        Icon="bi-file-text" />

                        <InputCheckboxField @bind-Value="options.includeLearningProgress"
                        Label="Прогрес вивчення"
                        Icon="bi-tags" />

                        <InputCheckboxField @bind-Value="options.isFullBackup"
                        Label="Резервна копія"
                        Icon="bi-list-ul" />
                    </div>

                    @if (exportError != null)
                    {
                        <div class="alert alert-error">
                            <i class="bi bi-exclamation-triangle"></i>
                            <div>
                                <strong>Помилка:</strong>
                                <p>@exportError</p>
                            </div>
                        </div>
                    }

                    @if (exportSuccess != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i>
                            <div>
                                <p>@exportSuccess</p>
                            </div>
                        </div>
                    }

                    <div class="form-actions">
                        <button class="btn-submit"
                        @onclick="ExportToFile"
                        disabled="@(selectedUnitId == 0 || isProcessing)">
                            @if (isProcessing)
                            {
                                <span class="spinner"></span>
                                <text>Експорт...</text>
                            }
                            else
                            {
                                <i class="bi bi-download"></i>
                                <text>Експортувати</text>
                            }
                        </button>
                    </div>
                </div>
            </div>
            
            <div class="keyboard-spacer"></div>
        </div>
    </div>
</div>

<PageTitle>Експорт словника</PageTitle>

@code {

    private List<CourseModel> availableCourses = new();
    private List<UnitModel> availableUnits = new();
    private bool isProcessing = false;

    private int selectedCourseId = 0;
    private int selectedUnitId = 0;
    private string exportFileName = $"unit_export_{DateTime.Now:yyyy-MM-dd}";

    private readonly UnitBackupOptions options = new();

    private string? exportError;
    private string? exportSuccess;

    protected override async Task OnInitializedAsync()
    {
        availableCourses = (await courseService.GetAllAsync()).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // ВИПРАВЛЕНО: scrollIntoView з block: 'center'
            await JSRuntime.InvokeVoidAsync("eval", @"
                (function() {
                    document.addEventListener('focusin', function(e) {
                        const element = e.target;
                        if (element.tagName === 'INPUT' || 
                            element.tagName === 'TEXTAREA' || 
                            element.tagName === 'SELECT') {
                            
                            setTimeout(function() {
                                element.scrollIntoView({
                                    behavior: 'smooth',
                                    block: 'center',
                                    inline: 'nearest'
                                });
                            }, 300);
                        }
                    });
                })();
            ");
        }
    }

    private async Task OnCourseChanged()
    {
        if (selectedCourseId == 0)
        {
            availableUnits = new List<UnitModel>();
            selectedUnitId = 0;
        }
        else
        {
            availableUnits = (await CourseService.GetUnitsAsync(selectedCourseId)).ToList();
            selectedUnitId = 0;
        }
        StateHasChanged();
    }

    private void ClearMessages()
    {
        exportError = null;
        exportSuccess = null;
    }

    private async Task ExportToFile()
    {
        isProcessing = true;
        ClearMessages();

        try
        {
            var _listToExport = await UnitService.GetByIdAsync(selectedUnitId);

            if (!_listToExport.Words.Any())
            {
                exportError = "Немає даних для експорту.";
                return;
            }

            var json = UnitBackupService.ExportToJson(_listToExport, options);
            var fileName = $"{exportFileName}.json";

            var success = await FileService.SaveFileAsync(fileName, json, "application/json");

            if (success)
            {
                exportSuccess = $"Експортовано {_listToExport.Words.Count} елементів у файл '{fileName}'.";
            }
            else
            {
                exportError = "Не вдалося зберегти файл. Спробуйте ще раз.";
            }
        }
        catch (Exception ex)
        {
            exportError = $"Помилка експорту: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
}

<style>
    .page-wrapper {
        display: flex;
        flex-direction: column;
        height: 100vh;
        height: 100dvh;
        overflow: hidden;

        border-top: 1px solid #e0e0e0;
        border-bottom: 1px solid #e0e0e0;
    }
    
    .scroll-area {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;
    }
    
    .keyboard-spacer {
        height: 0;
    }
    
    .edit-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .header-section {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        color: #333;
        margin: 0 0 0.5rem 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .page-title i {
        color: #A3BFFA;
    }

    .page-description {
        color: #666;
        font-size: 1rem;
        margin: 0;
    }

    .form-container {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .form-section {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-section:not(:last-child) {
        margin-bottom: 2rem;
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #333;
        margin: 0 0 1rem 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .section-title i {
        color: #A3BFFA;
    }

    .checkbox-group {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 1rem;
    }

    .btn-submit {
        padding: 0.875rem 2rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        border: none;
        background: linear-gradient(135deg, #A3BFFA, #B5EAD7);
        color: white;
        box-shadow: 0 4px 12px rgba(163, 191, 250, 0.3);
    }

    .btn-submit:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(163, 191, 250, 0.4);
    }

    .btn-submit:active {
        transform: translateY(0);
    }

    .btn-submit:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    .spinner {
        display: inline-block;
        width: 16px;
        height: 16px;
        border: 2px solid #ffffff;
        border-radius: 50%;
        border-top-color: transparent;
        animation: spin 1s ease-in-out infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .alert {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 1rem 1.25rem;
        border-radius: 10px;
        border: 1px solid;
        margin-top: 1rem;
    }

    .alert i {
        font-size: 1.25rem;
        flex-shrink: 0;
        margin-top: 0.125rem;
    }

    .alert div {
        flex: 1;
    }

    .alert strong {
        display: block;
        margin-bottom: 0.25rem;
    }

    .alert p {
        margin: 0;
    }

    .alert-success {
        background: rgba(181, 234, 215, 0.15);
        color: #155724;
        border-color: rgba(181, 234, 215, 0.5);
    }

    .alert-success i {
        color: #28a745;
    }

    .alert-error {
        background: rgba(220, 53, 69, 0.1);
        color: #721c24;
        border-color: rgba(220, 53, 69, 0.3);
    }

    .alert-error i {
        color: #dc3545;
    }

    @@media (max-width: 768px) {
        .edit-page {
            padding: 1.5rem 1rem;
        }

        .form-container {
            padding: 1.5rem;
        }

        .page-title {
            font-size: 1.75rem;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-submit {
            width: 100%;
            justify-content: center;
        }
        
        .keyboard-spacer {
            height: 350px;
        }
    }
</style>
