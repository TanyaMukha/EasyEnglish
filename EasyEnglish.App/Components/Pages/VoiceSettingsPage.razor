@page "/settings/voices"
@using EasyEnglish.App.Components.Shared.Breadcrumb
@using EasyEnglish.App.Services.Speech
@inject VoicePickerViewModel ViewModel
@inject VoiceAvailabilityService Availability
@implements IAsyncDisposable

<div class="page-content">
    <Breadcrumb Items="breadcrumbs" />

    <div class="header-section">
        <h1 class="page-title">
            <i class="bi bi-mic"></i>
            Налаштування голосів
        </h1>
        <p class="page-description">Оберіть голос синтезу мовлення для кожної мови.</p>
    </div>

    @if (ViewModel.IsLoading)
    {
        <div class="loading-container">
            <div class="spinner-border" role="status"></div>
            <p class="loading-text">Завантаження голосів...</p>
        </div>
    }
    else if (ViewModel.ErrorMessage is not null)
    {
        <div class="alert alert-error">
            <i class="bi bi-exclamation-triangle"></i>
            <p>@ViewModel.ErrorMessage</p>
        </div>
    }
    else
    {
        @foreach (var group in ViewModel.Groups)
        {
            var lang = group.Language;
            var selected = ViewModel.GetSelected(lang);

            <div class="voice-group">
                <h2 class="voice-group-title">@group.Label</h2>

                @if (group.Voices.Count == 0)
                {
                    var availability = GetAvailability(lang);
                    <div class="no-voices">
                        <div class="no-voices-message">
                            <i class="bi bi-exclamation-triangle"></i>
                            @(availability?.InstallInstructions ?? "Голосів не знайдено. Встановіть мовний пакет у системних налаштуваннях.")
                        </div>
                        <div class="no-voices-actions">
                            @if (availability?.CanOpenSettings == true)
                            {
                                <button class="btn-open-settings" @onclick="() => OpenSettingsAsync(lang)">
                                    <i class="bi bi-gear-fill"></i>
                                    Відкрити налаштування
                                </button>
                            }
                            <button class="btn-recheck" @onclick="ReloadAsync">
                                <i class="bi bi-arrow-clockwise"></i>
                                Перевірити знову
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="voice-list">
                        @foreach (var voice in group.Voices)
                        {
                            var isSelected = selected?.Id == voice.Id;

                            <div class="voice-item @(isSelected ? "selected" : "")"
                                 @onclick="() => Select(lang, voice)">

                                <span class="voice-radio @(isSelected ? "checked" : "")"></span>

                                <span class="voice-name">@voice.DisplayName</span>

                                @if (!voice.IsLocalService)
                                {
                                    <span class="badge-online" title="Потребує інтернету">
                                        <i class="bi bi-globe"></i>
                                        онлайн
                                    </span>
                                }

                                <button class="btn-preview"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => ViewModel.PreviewAsync(voice)"
                                        title="Прослухати">
                                    <i class="bi bi-play-fill"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <button class="btn-reload" @onclick="ReloadAsync">
            <i class="bi bi-arrow-clockwise"></i>
            Оновити список
        </button>
    }
</div>

@code {
    private List<Breadcrumb.BreadcrumbItem> breadcrumbs = BreadcrumbBuilder.Create().WithHome().WithActive("Налаштування голосів").Build();

    private List<VoiceAvailabilityResult> _availability = [];

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadAsync();
        await RecheckAvailabilityAsync();
    }

    private void Select(SpeechLanguage lang, LocaleInfo voice)
    {
        ViewModel.SetSelected(lang, voice);
        StateHasChanged();
    }

    private async Task ReloadAsync()
    {
        ViewModel.InvalidateCache();
        await ViewModel.LoadAsync();
        await RecheckAvailabilityAsync();
    }

    private async Task RecheckAvailabilityAsync()
    {
        _availability = (await Availability.CheckAllAsync()).ToList();
        StateHasChanged();
    }

    private VoiceAvailabilityResult? GetAvailability(SpeechLanguage lang) =>
        _availability.FirstOrDefault(a => a.Language == lang);

    private async Task OpenSettingsAsync(SpeechLanguage lang)
    {
#if ANDROID
        if (lang == SpeechLanguage.Ukrainian)
            AndroidVoiceInstallHelper.RequestLanguageInstall();
        else
            AndroidVoiceInstallHelper.OpenTtsSettings();
#elif WINDOWS
        await Launcher.OpenAsync("ms-settings:speech");
#endif
        await Task.CompletedTask;
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}

<style>
    .page-content { max-width: 800px; margin: 0 auto; padding: 2rem 1rem; }

    .header-section { margin-bottom: 2rem; }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0 0 0.5rem 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .page-description { color: var(--text-secondary); font-size: 1rem; margin: 0; }

    .loading-container { text-align: center; padding: 3rem 1rem; }
    .loading-text { color: var(--text-secondary); margin-top: 1rem; }

    .alert {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 1rem 1.25rem;
        border-radius: 10px;
        border: 1px solid;
    }

    .alert i { font-size: 1.25rem; flex-shrink: 0; margin-top: 0.125rem; }
    .alert p { margin: 0; }

    .alert-error { background: rgba(220, 53, 69, 0.1); color: #721c24; border-color: rgba(220, 53, 69, 0.3); }
    .alert-error i { color: #dc3545; }

    .voice-group {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .voice-group-title {
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0 0 1rem 0;
    }

    .no-voices {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .no-voices-message {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-muted);
        font-style: italic;
        font-size: 0.9rem;
    }

    .no-voices-message i { color: #F57C00; }

    .no-voices-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .btn-open-settings, .btn-recheck {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border-radius: 10px;
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-open-settings {
        background: #A3BFFA;
        border: 1.5px solid #A3BFFA;
        color: white;
    }

    .btn-open-settings:hover { background: #7B9FE8; border-color: #7B9FE8; }

    .btn-recheck {
        background: var(--surface-alt);
        border: 1.5px solid var(--border-muted);
        color: var(--text-secondary);
    }

    .btn-recheck:hover { border-color: #A3BFFA; color: #5a7fb8; }

    .voice-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .voice-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        border: 2px solid var(--border);
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .voice-item:hover { border-color: #c5d4f8; }

    .voice-item.selected {
        border-color: #A3BFFA;
        background: rgba(163, 191, 250, 0.07);
    }

    .voice-radio {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 2px solid var(--border-muted);
        flex-shrink: 0;
        transition: all 0.2s;
    }

    .voice-radio.checked {
        border-color: #A3BFFA;
        background: #A3BFFA;
        box-shadow: inset 0 0 0 3px var(--surface);
    }

    .voice-name {
        flex: 1;
        min-width: 0;
        color: var(--text-primary);
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .badge-online {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        background: rgba(163, 191, 250, 0.15);
        color: #5a7fb8;
        padding: 0.2rem 0.6rem;
        border-radius: 99px;
        font-size: 0.75rem;
        font-weight: 600;
        flex-shrink: 0;
    }

    .btn-preview {
        background: var(--surface-alt);
        border: 1px solid var(--border-muted);
        border-radius: 8px;
        width: 34px;
        height: 34px;
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .btn-preview:hover {
        background: var(--surface);
        border-color: #A3BFFA;
        color: #A3BFFA;
    }

    .btn-reload {
        background: var(--surface-alt);
        border: 1.5px solid #A3BFFA;
        border-radius: 10px;
        padding: 0.7rem 1.5rem;
        color: #5a7fb8;
        font-weight: 500;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s;
    }

    .btn-reload:hover { background: rgba(163, 191, 250, 0.1); }
</style>
