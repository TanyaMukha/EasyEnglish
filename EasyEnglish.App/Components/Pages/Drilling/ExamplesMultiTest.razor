@page "/drilling/examples-multi-test"

<div class="page-content">
    <PageHeader Title="Мульті-тест прикладів" />

    <MultiTestHost TItem="ExampleTestModel"
    Definitions="@_definitions"
    Items="@_items"
    IsLoading="@_isLoading"
    ErrorMessage="@_errorMessage"
    OnFinish="@FinishTest" />
</div>

@code {
    private List<WordTestModel> _words = [];
    private List<ExampleTestModel> _items = [];
    private List<TestDefinition<ExampleTestModel>> _definitions = [];
    private bool _isLoading;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var keys = ParseTestKeys();
        _definitions = TestRegistry.ExampleTests
            .Where(d => keys.Contains(d.Key))
            .ToList();

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            var result = await DailyWordsService.GetWordsForToday();
            _words = mapper.Map<List<WordTestModel>>(result.Words);
            _items = _words
                .Where(w => w.Examples is { Count: > 0 })
                .Select(w =>
                {
                    var example = mapper.Map<ExampleTestModel>(w.Examples!.First());
                    example.TestWord = w;
                    return example;
                })
                .ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Помилка завантаження: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task FinishTest()
    {
        var toUpdate = WordRatingCalculator.UpdateWordRate(_words);
        await WordService.UpdateWordRateRangeAsync(mapper.Map<List<UpdateWordRateRequest>>(toUpdate));
        DailyWordsService.ClearCache();
        NavigationManager.NavigateTo("/drilling/examples-learning");
    }

    private HashSet<string> ParseTestKeys()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return (query["tests"] ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
    }
}

<style>
    .page-content { max-width: 800px; margin: 0 auto; padding: 2rem 1rem; }
</style>
