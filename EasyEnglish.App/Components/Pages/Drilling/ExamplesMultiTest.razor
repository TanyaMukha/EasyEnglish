@page "/courses/{CourseId:int}/units/{UnitId:int}/examples/practice/session"
@page "/courses/{CourseId:int}/examples/practice/session"
@inject PracticeQueueService PracticeQueueService

<div class="page-content">
    <Breadcrumb Items="breadcrumbs" />
    <PageHeader Title="Вивчення прикладів" />

    <MultiTestHost TItem="ExampleTestModel"
    Definitions="@_definitions"
    Items="@_items"
    IsLoading="@_isLoading"
    ErrorMessage="@_errorMessage"
    OnFinish="@FinishTest" />
</div>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int? UnitId { get; set; }

    private List<WordTestModel> _words = [];
    private List<ExampleTestModel> _items = [];
    private List<TestDefinition<ExampleTestModel>> _definitions = [];
    private bool _isLoading;
    private string? _errorMessage;
    private List<Breadcrumb.BreadcrumbItem> breadcrumbs = new();

    protected override async Task OnInitializedAsync()
    {
        var keys = ParseKeys("tests");
        _definitions = TestRegistry.ExampleTests
            .Where(d => keys.Contains(d.Key))
            .ToList();

        await BuildBreadcrumbsAsync();
        await LoadData();
    }

    private async Task BuildBreadcrumbsAsync()
    {
        var course = await CourseService.GetByIdAsync(CourseId);
        var builder = BreadcrumbBuilder.Create()
            .WithHome()
            .WithLink("Курси", "/courses")
            .WithLink(course?.Title ?? "Курс", $"/courses/{CourseId}");

        if (UnitId.HasValue)
        {
            var unit = await UnitService.GetByIdAsync(UnitId.Value);
            builder = builder.WithLink(unit?.Title ?? "Модуль", $"/courses/{CourseId}/units/{UnitId}");
        }

        breadcrumbs = builder.WithActive("Вивчення прикладів").Build();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            var wordIds = ParseIds("wordIds");
            var words = await WordService.GetByIdsAsync(wordIds, ["Examples"]);
            _words = mapper.Map<List<WordTestModel>>(words);
            _items = _words
                .Where(w => w.Examples is { Count: > 0 })
                .Select(w =>
                {
                    var example = mapper.Map<ExampleTestModel>(w.Examples!.First());
                    example.TestWord = w;
                    return example;
                })
                .ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Помилка завантаження: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task FinishTest()
    {
        var toUpdate = WordRatingCalculator.UpdateWordRate(_words);
        await WordService.UpdateWordRateRangeAsync(mapper.Map<List<UpdateWordRateRequest>>(toUpdate));

        var next = PracticeQueueService.Advance();
        NavigationManager.NavigateTo(next ?? (UnitId.HasValue ? $"/courses/{CourseId}/units/{UnitId}" : $"/courses/{CourseId}"));
    }

    private HashSet<string> ParseKeys(string paramName)
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return (query[paramName] ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
    }

    private List<int> ParseIds(string paramName)
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return (query[paramName] ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(int.Parse)
            .ToList();
    }
}

<style>
    .page-content { max-width: 800px; margin: 0 auto; padding: 2rem 1rem; }
</style>
