<TestCardQuestionSection Text="@Item.Text" Hint="@Item.Hint" />

<AnswerOptionSection
    AnswerOptions="@_shuffledOptions"
    IsAnswerSubmitted="@Context.State.IsAnswerSubmitted"
    CorrectAnswer="@(Item.Choice?.CorrectAnswers.FirstOrDefault() ?? "")"
    OnAnswerSelected="@Context.Callbacks.OnCheckAnswer" />

@code {
    [Parameter, EditorRequired]
    public TestCardContext Context { get; set; } = null!;

    private TestCardTestModel Item => Context.GetRawItem<TestCardTestModel>();

    private List<string> _shuffledOptions = new();
    private int _loadedItemId = -1;

    protected override void OnParametersSet()
    {
        if (_loadedItemId == Item.Id)
            return;

        _loadedItemId = Item.Id;
        _shuffledOptions = (Item.Choice?.Options ?? Array.Empty<string>())
            .OrderBy(_ => Random.Shared.Next())
            .ToList();
    }
}
