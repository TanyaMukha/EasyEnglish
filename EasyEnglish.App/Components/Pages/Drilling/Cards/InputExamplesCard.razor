@if (!Context.State.IsAnswerSubmitted)
{
    <div class="hint-container">
        <div class="hint-badge">
            <i class="bi bi-pencil"></i>
            <span>Введіть правильне слово замість пропуску</span>
        </div>
    </div>
}

<div class="example-container">

    <div class="sentence-text">
        @if (_parsed.beforeHidden != string.Empty)
        {
            @((MarkupString)ExampleMarkdownService.RenderMarkdown(_parsed.beforeHidden))

            @if (!Context.State.IsAnswerSubmitted)
            {
                <input type="text"
                        class="word-input"
                        @bind="_userAnswer"
                        @bind:event="oninput"
                        placeholder="..."
                        @onkeydown="HandleKeyDown"
                        autofocus />
            }
            else
            {
                <span class="answer-display @(_isCorrect ? "correct" : "incorrect")">
                    @(_isCorrect ? _userAnswer : _parsed.hiddenText)
                </span>
            }

            @((MarkupString)ExampleMarkdownService.RenderMarkdown(_parsed.afterHidden))
        }
        else
        {
            @((MarkupString)ExampleMarkdownService.RenderMarkdown(_item.Sentence))
        }
    </div>

    <div class="sentence-text">
        @((MarkupString)ExampleMarkdownService.RenderMarkdown(_item.Translation))
    </div>

    @if (!Context.State.IsAnswerSubmitted && _parsed.hiddenText != string.Empty)
    {
        <div class="submit-container">
            <button class="btn-submit"
                    @onclick="CheckAnswer"
                    disabled="@string.IsNullOrWhiteSpace(_userAnswer)">
                <i class="bi bi-check-circle"></i>
                Перевірити
            </button>
        </div>
    }

    @if (Context.State.IsAnswerSubmitted)
    {
        <div class="feedback @(_isCorrect ? "success" : "error")">
            <i class="bi @(_isCorrect ? "bi-check-circle" : "bi-x-circle")"></i>
            <span>
                @if (_isCorrect)
                {
                    <span>Правильно! Чудова робота!</span>
                }
                else
                {
                    <span>Неправильно. Ваша відповідь: <strong>@_userAnswer</strong> · Правильно: <strong>@_parsed.hiddenText</strong></span>
                }
            </span>
        </div>  
    }
</div>

@code {
    [Parameter, EditorRequired]
    public TestCardContext Context { get; set; } = null!;

    private ExampleModel _item => Context.GetRawItem<ExampleModel>();

    private (string beforeHidden, string hiddenText, string afterHidden) _parsed =>
        ExampleMarkdownService.ParseHiddenText(_item.Sentence);

    // Local UI state
    private string _userAnswer = string.Empty;
    private bool   _isCorrect;

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_userAnswer) && !Context.State.IsAnswerSubmitted)
            CheckAnswer();
    }

    private void CheckAnswer()
    {
        if (string.IsNullOrWhiteSpace(_userAnswer)) return;

        _isCorrect = ExampleMarkdownService.CheckAnswer(_userAnswer, _parsed.hiddenText);

        Context.Callbacks.OnCheckAnswer.InvokeAsync(_isCorrect);
    }

    // Скидаємо локальний стан при зміні картки
    protected override void OnParametersSet()
    {
        if (!Context.State.IsAnswerSubmitted)
        {
            _userAnswer = string.Empty;
            _isCorrect  = false;
        }
    }
}

<style>
    /* ── Hint ── */
    .hint-container {
        display: flex;
        justify-content: center;
        margin-bottom: 1.5rem;
    }

    .hint-badge {
        background: #EFF4FF;
        border: 1px solid #C7D7F9;
        padding: 0.625rem 1.25rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #3B5FC0;
        font-weight: 600;
        font-size: 0.9375rem;
    }

    /* ── Sentences ── */
    .example-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .sentence-section {
        border-radius: 8px;
        padding: 1.25rem 1.5rem;
    }

    .sentence-section.english {
        background: #F8F9FA;
        border-left: 4px solid #A3BFFA;
    }

    .sentence-section.translation {
        background: #F8F9FA;
        border-left: 4px solid #dee2e6;
    }

    .language-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #666;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .sentence-text {
        font-size: 1.25rem;
        line-height: 1.8;
        color: #333;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.25rem;
    }

    /* ── Inline input ── */
    .word-input {
        display: inline-block;
        min-width: 120px;
        padding: 0.25rem 0.75rem;
        font-size: 1.25rem;
        border: 2px solid #dee2e6;
        border-radius: 6px;
        background: white;
        outline: none;
        transition: border-color 0.2s;
    }

    .word-input:focus {
        border-color: #A3BFFA;
    }

    /* ── Inline answer badge ── */
    .answer-display {
        display: inline-block;
        padding: 0.125rem 0.625rem;
        border-radius: 6px;
        font-weight: 700;
    }

    .answer-display.correct   { background: #d4edda; color: #155724; }
    .answer-display.incorrect { background: #f8d7da; color: #721c24; }

    /* ── Submit button ── */
    .submit-container { display: flex; }

    .btn-submit {
        width: 100%;
        padding: 1rem;
        background: #A3BFFA;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-submit:hover:not(:disabled) {
        background: #7B9FE8;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(123, 159, 232, 0.3);
    }

    .btn-submit:active:not(:disabled) { transform: translateY(0); }
    .btn-submit:disabled { opacity: 0.5; cursor: not-allowed; }

    /* ── Feedback ── */
    .feedback {
        padding: 1rem 1.5rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 500;
        width: 100%;
        box-sizing: border-box;
        animation: slideIn 0.25s ease;
    }

    .feedback i { font-size: 1.25rem; flex-shrink: 0; }

    .feedback.success {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .feedback.error {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    @@keyframes slideIn {
        from { opacity: 0; transform: translateX(-12px); }
        to   { opacity: 1; transform: translateX(0); }
    }

    .sentence-text :deep(strong) { color: #1976D2; font-weight: 700; }
    .sentence-text :deep(em)     { color: #7B1FA2; font-style: italic; }

    .fade-in { animation: fadeIn 0.5s ease; }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-8px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 768px) {
        .sentence-text { font-size: 1.125rem; }
        .word-input    { font-size: 1.125rem; min-width: 100px; }
        .hint-badge    { font-size: 0.875rem; }
        .feedback      { font-size: 0.95rem; }
    }
</style>
