@page "/drilling/learning-words"

<div class="page-content">
    <PageHeader Title="Навчання слів" />

    <div>
        <InputCheckboxField Label="Вибрати всі" @bind-Value="_selectAll" @bind-Value:after="SelectAllChange" />
    </div>

    <div class="exercises-grid">
        <ExerciseCard
            Title="Повторення слів"
            Description="Переглядайте вивчені слова з перекладом для закріплення"
            Icon="bi-book"
            Color="blue"
            @bind-IsSelected="_reviewWords" />

        <ExerciseCard
            Title="Переклад для слова"
            Description="Оберіть правильний переклад для англійського слова"
            Icon="bi-translate"
            Color="green"
            @bind-IsSelected="_wordToTranslationChoice" />

        <ExerciseCard
            Title="Перевірка перекладу"
            Description="Підтвердіть, чи знаєте переклад слова"
            Icon="bi-eye"
            Color="purple"
            @bind-IsSelected="_wordToTranslationKnowOrNot" />

        <ExerciseCard
            Title="Слово за перекладом"
            Description="Знайдіть англійське слово за його перекладом"
            Icon="bi-search"
            Color="orange"
            @bind-IsSelected="_translationToWordChoice" />

        <ExerciseCard
            Title="Перевірка слова"
            Description="Підтвердіть, чи знаєте слово за перекладом"
            Icon="bi-eye-slash"
            Color="pink"
            @bind-IsSelected="_translationToWordKnowOrNot" />

        <ExerciseCard
            Title="Напишіть слово"
            Description="Введіть англійське слово за його перекладом"
            Icon="bi-keyboard"
            Color="mint"
            @bind-IsSelected="_translationToWordManualInput" />
    </div>

    @if (_anySelected)
    {
        <div class="multi-test-section">
            <div class="multi-test-card">
                <div class="multi-test-info">
                    <h3 class="multi-test-title">
                        <i class="bi bi-collection"></i>
                        Мульті-тест
                    </h3>
                    <p class="multi-test-description">
                        Обрано вправ: <strong>@_selectedCount</strong>
                    </p>
                </div>
                <button class="btn-multi-test" @onclick="StartMultiTest">
                    <i class="bi bi-play-fill"></i>
                    Почати мульті-тест
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool _selectAll;
    private bool _reviewWords;
    private bool _wordToTranslationChoice;
    private bool _wordToTranslationKnowOrNot;
    private bool _translationToWordChoice;
    private bool _translationToWordKnowOrNot;
    private bool _translationToWordManualInput;

    private bool _anySelected =>
        _reviewWords || _wordToTranslationChoice || _wordToTranslationKnowOrNot ||
        _translationToWordChoice || _translationToWordKnowOrNot || _translationToWordManualInput;

    private int _selectedCount
    {
        get
        {
            int count = 0;
            if (_reviewWords)                  count++;
            if (_wordToTranslationChoice)      count++;
            if (_wordToTranslationKnowOrNot)   count++;
            if (_translationToWordChoice)      count++;
            if (_translationToWordKnowOrNot)   count++;
            if (_translationToWordManualInput) count++;
            return count;
        }
    }

    private void SelectAllChange()
    {
        _reviewWords                  = _selectAll;
        _wordToTranslationChoice      = _selectAll;
        _wordToTranslationKnowOrNot   = _selectAll;
        _translationToWordChoice      = _selectAll;
        _translationToWordKnowOrNot   = _selectAll;
        _translationToWordManualInput = _selectAll;
    }

    private void StartMultiTest()
    {
        var keys = new List<string>();
        if (_reviewWords)                  keys.Add("review-words");
        if (_wordToTranslationChoice)      keys.Add("word-to-translation-single-choice");
        if (_wordToTranslationKnowOrNot)   keys.Add("word-to-translation-know-or-not");
        if (_translationToWordChoice)      keys.Add("translation-to-word-single-choice");
        if (_translationToWordKnowOrNot)   keys.Add("translation-to-word-know-or-not");
        if (_translationToWordManualInput) keys.Add("translation-to-word-manual-input");

        NavigationManager.NavigateTo($"/drilling/words-multi-test?tests={string.Join(",", keys)}");
    }
}
