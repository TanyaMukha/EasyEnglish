@page "/drilling/examples-learning"

<div class="page-content">
    <PageHeader Title="Навчання прикладів" />

    <div>
        <InputCheckboxField Label="Вибрати всі" @bind-Value="_selectAll" @bind-Value:after="SelectAllChange" />
    </div>

    <div class="exercises-grid">
        <ExerciseCard
            Title="Перегляд прикладів"
            Description="Переглядайте речення з перекладом для закріплення"
            Icon="bi-eye"
            Color="blue"
            @bind-IsSelected="_reviewExamples" />

        <ExerciseCard
            Title="Угадай слово"
            Description="Натисніть на розмите слово щоб його відкрити"
            Icon="bi-search"
            Color="purple"
            @bind-IsSelected="_reviewBlurred" />

        <ExerciseCard
            Title="Введи слово"
            Description="Надрукуйте пропущене слово у реченні"
            Icon="bi-keyboard"
            Color="mint"
            @bind-IsSelected="_inputExamples" />
    </div>

    @if (_anySelected)
    {
        <div class="multi-test-section">
            <div class="multi-test-card">
                <div class="multi-test-info">
                    <h3 class="multi-test-title">
                        <i class="bi bi-collection"></i>
                        Мульті-тест
                    </h3>
                    <p class="multi-test-description">
                        Обрано вправ: <strong>@_selectedCount</strong>
                    </p>
                </div>
                <button class="btn-multi-test" @onclick="StartMultiTest">
                    <i class="bi bi-play-fill"></i>
                    Почати мульті-тест
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool _selectAll;
    private bool _reviewExamples;
    private bool _reviewBlurred;
    private bool _inputExamples;

    private bool _anySelected => _reviewExamples || _reviewBlurred || _inputExamples;

    private int _selectedCount
    {
        get
        {
            int count = 0;
            if (_reviewExamples) count++;
            if (_reviewBlurred)  count++;
            if (_inputExamples)  count++;
            return count;
        }
    }

    private void SelectAllChange()
    {
        _reviewExamples = _selectAll;
        _reviewBlurred  = _selectAll;
        _inputExamples  = _selectAll;
    }

    private void StartMultiTest()
    {
        var keys = new List<string>();
        if (_reviewExamples) keys.Add("review-examples");
        if (_reviewBlurred)  keys.Add("review-examples-blurred");
        if (_inputExamples)  keys.Add("input-examples");

        NavigationManager.NavigateTo($"/drilling/examples-multi-test?tests={string.Join(",", keys)}");
    }
}
