@page "/courses/{CourseId:int}/units/{UnitId:int}/study-cards/practice"
@page "/courses/{CourseId:int}/study-cards/practice"

@using EasyEnglish.Core.Presets
@inject PracticeQueueService PracticeQueueService

<div class="page-content">
    <PageHeader Title="Практика навчальних карток" />

    <MultiTestHost TItem="StudyCardTestModel"
        Definitions="@_definitions"
        Items="@_items"
        IsLoading="@_isLoading"
        ErrorMessage="@_errorMessage"
        OnFinish="@FinishTest" />
</div>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int? UnitId { get; set; }

    private List<StudyCardTestModel> _items = [];
    private List<TestDefinition<StudyCardTestModel>> _definitions = [.. TestRegistry.StudyCardTests];
    private bool _isLoading;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;

            var keys = ParseKeys("tests");
            if (keys.Count > 0)
                _definitions = TestRegistry.StudyCardTests.Where(d => keys.Contains(d.Key)).ToList();

            var itemIds = ParseIds("itemIds");
            if (itemIds.Count > 0)
            {
                var cards = await StudyCardService.GetByIdsAsync(itemIds);
                _items = mapper.Map<List<StudyCardTestModel>>(cards);
            }
            else if (UnitId.HasValue)
            {
                var unit = await UnitService.GetByIdAsync(UnitId.Value, UnitIncludes.Full);
                _items = mapper.Map<List<StudyCardTestModel>>(unit?.StudyCards ?? new List<StudyCardModel>());
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Помилка завантаження: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task FinishTest()
    {
        var toUpdate = WordRatingCalculator.UpdateWordRate(_items);
        await StudyCardService.UpdateRateRangeAsync(mapper.Map<List<UpdateWordRateRequest>>(toUpdate));

        var next = PracticeQueueService.Advance();
        NavigationManager.NavigateTo(next ?? (UnitId.HasValue ? $"/courses/{CourseId}/units/{UnitId}" : $"/courses/{CourseId}"));
    }

    private HashSet<string> ParseKeys(string paramName)
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return (query[paramName] ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
    }

    private List<int> ParseIds(string paramName)
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return (query[paramName] ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(int.Parse)
            .ToList();
    }
}

<style>
    .page-content { max-width: 800px; margin: 0 auto; padding: 2rem 1rem; }
</style>
