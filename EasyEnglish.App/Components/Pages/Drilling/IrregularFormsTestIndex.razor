@page "/drilling/irregular-forms"

<div class="page-content">
    <PageHeader Title="Неправильні форми" />

    <div>
        <InputCheckboxField Label="Вибрати всі" @bind-Value="_selectAll" @bind-Value:after="SelectAllChange" />
    </div>

    <div class="exercises-grid">
        <ExerciseCard
            Title="Перегляд форм"
            Description="Переглядайте всі форми слів для запам'ятовування"
            Icon="bi-book"
            Color="blue"
            @bind-IsSelected="_reviewForms" />

        <ExerciseCard
            Title="Переклад форми"
            Description="Оберіть правильний переклад для форми слова"
            Icon="bi-question-circle"
            Color="yellow"
            @bind-IsSelected="_wordToTranslationChoice" />

        <ExerciseCard
            Title="Форма за перекладом"
            Description="Знайдіть форму слова за його перекладом"
            Icon="bi-chat-text"
            Color="orange"
            @bind-IsSelected="_translationToWordChoice" />

        <ExerciseCard
            Title="Напишіть форму"
            Description="Введіть форму слова за перекладом"
            Icon="bi-keyboard"
            Color="mint"
            @bind-IsSelected="_translationToWordManualInput" />

        <ExerciseCard Title="Картка форм"
                      Description="Переглядайте всі форми слова на одній картці"
                      Icon="bi-card-list"
                      Color="blue"
                      @bind-IsSelected="_reviewFormsCard" />

        <ExerciseCard Title="Введіть форми"
                      Description="Напишіть другу та третю форму слова"
                      Icon="bi-keyboard"
                      Color="green"
                      @bind-IsSelected="_inputForms" />
    </div>

    @if (_anySelected)
    {
        <div class="multi-test-section">
            <div class="multi-test-card">
                <div class="multi-test-info">
                    <h3 class="multi-test-title">
                        <i class="bi bi-collection"></i>
                        Мульті-тест
                    </h3>
                    <p class="multi-test-description">
                        Обрано вправ: <strong>@_selectedCount</strong>
                    </p>
                </div>
                <button class="btn-multi-test" @onclick="StartMultiTest">
                    <i class="bi bi-play-fill"></i>
                    Почати мульті-тест
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool _selectAll;
    private bool _reviewForms;
    private bool _wordToTranslationChoice;
    private bool _wordToTranslationKnowOrNot;
    private bool _translationToWordChoice;
    private bool _translationToWordManualInput;
    private bool _reviewFormsCard;
    private bool _inputForms;

    private bool _anySelected =>
        _reviewForms || _reviewFormsCard || _inputForms ||
        _wordToTranslationChoice || _wordToTranslationKnowOrNot ||
        _translationToWordChoice || _translationToWordManualInput;

    private int _selectedCount
    {
        get
        {
            int count = 0;
            if (_reviewForms)                  count++;
            if (_wordToTranslationChoice)      count++;
            if (_wordToTranslationKnowOrNot)   count++;
            if (_translationToWordChoice)      count++;
            if (_translationToWordManualInput) count++;
            if (_reviewFormsCard) count++;
            if (_inputForms) count++;
            return count;
        }
    }

    private void SelectAllChange()
    {
        _reviewForms                  = _selectAll;
        _wordToTranslationChoice      = _selectAll;
        _wordToTranslationKnowOrNot   = _selectAll;
        _translationToWordChoice      = _selectAll;
        _translationToWordManualInput = _selectAll;
        _reviewFormsCard = _selectAll;
        _inputForms = _selectAll;
    }

    private void StartMultiTest()
    {
        var keys = new List<string>();
        if (_reviewForms)                  keys.Add("review-irregular-forms");
        if (_wordToTranslationChoice)      keys.Add("irregular-word-to-translation-single-choice");
        if (_wordToTranslationKnowOrNot)   keys.Add("irregular-word-to-translation-know-or-not");
        if (_translationToWordChoice)      keys.Add("irregular-translation-to-word-single-choice");
        if (_translationToWordManualInput) keys.Add("irregular-translation-to-word-manual-input");
        if (_reviewFormsCard) keys.Add("review-irregular-forms-card");
        if (_inputForms) keys.Add("input-irregular-forms");

        NavigationManager.NavigateTo($"/drilling/irregular-forms-multi-test?tests={string.Join(",", keys)}");
    }
}
