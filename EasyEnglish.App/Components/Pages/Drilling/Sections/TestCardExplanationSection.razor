@* TestCardExplanationSection.razor - shown on a test card only after the learner answers incorrectly *@

@if (IsAnswerSubmitted && !IsCorrect && !string.IsNullOrWhiteSpace(Explanation))
{
    <div class="testcard-explanation-block">
        <div class="testcard-explanation-icon"><i class="bi bi-info-circle-fill"></i></div>
        <div class="testcard-explanation-text">@Explanation</div>
    </div>
}

@code {
    [Parameter] public string? Explanation { get; set; }
    [Parameter] public bool IsAnswerSubmitted { get; set; }
    [Parameter] public bool IsCorrect { get; set; }
}

<style>
    .testcard-explanation-block {
        margin-top: 1.5rem;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        background: #fff3cd;
        border: 1px solid #ffe69c;
        border-radius: 8px;
        padding: 1rem 1.25rem;
        text-align: left;
    }

    .testcard-explanation-icon {
        color: #997404;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .testcard-explanation-text {
        color: #664d03;
        line-height: 1.6;
        white-space: pre-wrap;
    }
</style>
