@namespace EasyEnglish.App.Components.Pages.Drilling.Sections
@using System.Globalization

@*
    Bottom-right corner control: a round core button with items fanned out over the 90° corner,
    pointing up and to the left — everything within thumb reach on a phone held in one hand.

    Two shapes:
      Petal  — annulus sectors filling the whole quarter (difficulty rating);
      Circle — round buttons sitting on the quarter arc (numbered answer options).
*@

<div class="corner-cluster">
    @if (Shape == ClusterShape.Petal)
    {
        <svg class="cluster-petals" viewBox="0 0 @Size @Size" width="@Size" height="@Size" aria-hidden="false">
            @for (var i = 0; i < Items.Count; i++)
            {
                var index = i;
                var item  = Items[index];

                @* No tabindex/role: a focusable SVG path draws the platform focus ring, and the
                   design calls for no frames at all — pressing lengthens the petal instead. *@
                <path class="cluster-petal @item.CssClass @(item.IsActive ? "active" : "")"
                      d="@PetalPath(index)"
                      @onclick="() => OnItemClick.InvokeAsync(index)">
                    <title>@item.Title</title>
                </path>

            }
        </svg>

        @* Numbers ride above the SVG as plain elements — Razor reserves the <text> tag, and this
           way the label is styled with ordinary CSS. pointer-events: none keeps taps on the petal. *@
        @for (var i = 0; i < Items.Count; i++)
        {
            var item = Items[i];

            if (!string.IsNullOrEmpty(item.Label))
            {
                <span class="cluster-petal-label @item.CssClass @(WideLabels ? "wide" : "")"
                      style="@PetalLabelStyle(i)">@item.Label</span>
            }
        }
    }
    else
    {
        @for (var i = 0; i < Items.Count; i++)
        {
            var index = i;
            var item  = Items[index];

            <button class="cluster-dot @item.CssClass @(item.IsActive ? "active" : "")"
                    style="@DotStyle(index)"
                    title="@item.Title"
                    disabled="@item.IsDisabled"
                    @onclick="() => OnItemClick.InvokeAsync(index)">
                @item.Label
            </button>
        }
    }

    @* Without a handler the core is just the hub the petals grow from — inert and muted,
       so the flower reads as one shape instead of five slices hanging in the corner. *@
    @if (OnCore.HasDelegate || ShowCore)
    {
        <button class="cluster-core @CoreCssClass @(OnCore.HasDelegate ? "" : "inert")"
                title="@CoreTitle"
                disabled="@(CoreDisabled || !OnCore.HasDelegate)"
                @onclick="() => OnCore.InvokeAsync()">
            @if (!string.IsNullOrEmpty(CoreIcon))
            {
                <i class="bi @CoreIcon"></i>
            }
            @CoreLabel
        </button>
    }
</div>

@code {
    /// <summary>
    /// Petal — annulus sectors filling the corner quarter, one per item (rating, answer options);
    /// Circle — round buttons spread along that quarter arc.
    /// </summary>
    public enum ClusterShape { Petal, Circle }

    /// <param name="Label">Text inside a circle item (a number, usually).</param>
    /// <param name="Title">Tooltip / accessible name.</param>
    /// <param name="CssClass">Extra class for colouring.</param>
    /// <param name="IsActive">Highlighted state.</param>
    /// <param name="IsDisabled">Non-clickable state.</param>
    public record ClusterItem(
        string Label = "",
        string Title = "",
        string CssClass = "",
        bool   IsActive = false,
        bool   IsDisabled = false);

    [Parameter, EditorRequired] public IReadOnlyList<ClusterItem> Items { get; set; } = [];
    [Parameter] public ClusterShape Shape { get; set; } = ClusterShape.Petal;
    [Parameter] public EventCallback<int> OnItemClick { get; set; }

    [Parameter] public string  CoreIcon     { get; set; } = "";
    [Parameter] public string  CoreLabel    { get; set; } = "";
    [Parameter] public string  CoreTitle    { get; set; } = "";
    [Parameter] public string  CoreCssClass { get; set; } = "";
    [Parameter] public bool    CoreDisabled { get; set; }
    [Parameter] public EventCallback OnCore { get; set; }

    /// <summary>Draw the hub even when nothing happens on tap — purely to complete the flower.</summary>
    [Parameter] public bool ShowCore { get; set; }

    /// <summary>Labels are words rather than single digits, so they need a wider box.</summary>
    [Parameter] public bool WideLabels { get; set; }

    // Geometry, in px.
    //
    // Everything shares one centre: the screen corner itself. The core is a quarter disc sitting
    // in that corner with its flat edges along the bottom and the right, and the petals are
    // annulus sectors around it — so the outermost petals end flush with the same two edges the
    // core's flat sides lie on.
    private const int Size        = 200;                            // fan reach from the corner
    private const int CoreRadius  = 78;                             // the quarter disc
    private const int InnerRadius = CoreRadius + 10;                // petals start just past it
    private const int OuterRadius = 190;
    private const int DotSize     = 44;
    private const int DotGap      = 10;                             // free space between neighbours

    /// <summary>Annulus sector for petal <paramref name="index"/>, sweeping the quarter from left to up.</summary>
    private string PetalPath(int index)
    {
        const double gap = 1.2 * Math.PI / 180;   // hairline between petals

        var step  = Math.PI / 2 / Items.Count;
        var start = Math.PI + index * step + gap;          // 180° = pointing left
        var end   = Math.PI + (index + 1) * step - gap;    // 270° = pointing up

        var (x1, y1) = Point(InnerRadius, start);
        var (x2, y2) = Point(OuterRadius, start);
        var (x3, y3) = Point(OuterRadius, end);
        var (x4, y4) = Point(InnerRadius, end);

        return string.Create(CultureInfo.InvariantCulture,
            $"M {x1:F1} {y1:F1} L {x2:F1} {y2:F1} A {OuterRadius} {OuterRadius} 0 0 1 {x3:F1} {y3:F1} L {x4:F1} {y4:F1} A {InnerRadius} {InnerRadius} 0 0 0 {x1:F1} {y1:F1} Z");
    }

    /// <summary>Places a petal's number at its middle — mid angle, mid radius.</summary>
    private string PetalLabelStyle(int index)
    {
        var labelSize = WideLabels ? 34 : 28;

        var step  = Math.PI / 2 / Items.Count;
        var angle = Math.PI + (index + 0.5) * step;

        var (x, y) = Point((InnerRadius + OuterRadius) / 2.0, angle);

        return string.Create(CultureInfo.InvariantCulture,
            $"right: calc({Size - x - labelSize / 2.0:F1}px + var(--cluster-inset)); bottom: calc({Size - y - labelSize / 2.0:F1}px + var(--cluster-inset));");
    }

    /// <summary>
    /// Radius the numbered circles sit on. Chosen so that neighbours never touch: with the arc
    /// step fixed by the item count, the chord between two centres must clear a whole dot plus a
    /// gap — hence r = (DotSize + DotGap) / (2·sin(step/2)), never below a comfortable minimum.
    /// </summary>
    private double DotRadius
    {
        get
        {
            // Never closer than a dot's width past the core disc.
            var minimum = CoreRadius + DotSize / 2.0 + 14;

            if (Items.Count < 2)
                return minimum;

            var step   = Math.PI / 2 / (Items.Count - 1);
            var needed = (DotSize + DotGap) / (2 * Math.Sin(step / 2));

            return Math.Max(minimum, needed);
        }
    }

    /// <summary>Places a numbered circle on the quarter arc, from pointing-left to pointing-up.</summary>
    private string DotStyle(int index)
    {
        var step  = Items.Count > 1 ? Math.PI / 2 / (Items.Count - 1) : 0;
        var angle = Math.PI + index * step;

        var (x, y) = Point(DotRadius, angle);

        // Offsets are measured from the container's bottom-right corner, plus the shared inset
        // so the circles sit on the same centre as the core.
        return string.Create(CultureInfo.InvariantCulture,
            $"right: calc({Size - x - DotSize / 2.0:F1}px + var(--cluster-inset)); bottom: calc({Size - y - DotSize / 2.0:F1}px + var(--cluster-inset));");
    }

    private static (double X, double Y) Point(double radius, double angle) =>
        (Size + radius * Math.Cos(angle), Size + radius * Math.Sin(angle));
}

<style>
    /* Phones and tablets only — the desktop layout keeps its own controls */
    .corner-cluster {
        --cluster-inset: 10px;

        display: none;
        position: fixed;
        right: 0;
        /* Sits above the action bar, which is itself lifted by the keyboard inset */
        bottom: calc(4.5rem + env(safe-area-inset-bottom) + var(--keyboard-inset, 0px));
        width: 200px;
        height: 200px;
        pointer-events: none;
        z-index: 850;
        /* No platform tap flash anywhere in the cluster */
        -webkit-tap-highlight-color: transparent;
    }

    .corner-cluster *:focus,
    .corner-cluster *:focus-visible {
        outline: none;
    }

    @@media (max-width: 1024px) {
        .corner-cluster {
            display: block;
        }
    }

    .corner-cluster > * {
        pointer-events: auto;
    }

    /* The fan and the core share the same inset, so they stay concentric while both keep
       a margin from the screen edges. */
    .cluster-petals {
        position: absolute;
        right: var(--cluster-inset);
        bottom: var(--cluster-inset);
        overflow: visible;
    }

    .cluster-petal {
        fill: var(--surface-alt);
        stroke: none;
        cursor: pointer;
        outline: none;
        /* The origin is the fan centre — the corner — so growing means "reaching further out" */
        transform-box: view-box;
        transform-origin: 200px 200px;
        transition: transform 0.12s ease, opacity 0.15s ease;
    }

    /* Pressing lengthens the petal — that is the feedback, instead of any kind of frame */
    .cluster-petal:active {
        transform: scale(1.08);
    }

    .cluster-petal-label {
        position: absolute;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        font-size: 1.15rem;
        font-weight: 700;
        color: #fff;
        user-select: none;
    }

    /* Answer petals: the app's accent by default, verdict colours once answered */
    .cluster-petal.option        { fill: var(--accent); }
    .cluster-petal.correct       { fill: #22c55e; }
    .cluster-petal.incorrect     { fill: #ef4444; }
    .cluster-petal.muted         { fill: var(--surface-alt); }
    .cluster-petal-label.muted   { color: var(--text-muted); }

    /* Self-assessment petals: yes / no / "not sure" without borrowing the verdict colours */
    .cluster-petal.positive       { fill: #22c55e; }
    .cluster-petal.negative       { fill: #ef4444; }
    .cluster-petal.neutral        { fill: var(--surface-alt); }
    .cluster-petal-label.neutral  { color: var(--text-secondary); }

    /* Words instead of digits need room, and they may wrap */
    .cluster-petal-label.wide {
        width: 78px;
        height: 34px;
        font-size: 0.85rem;
        font-weight: 600;
        line-height: 1.15;
        text-align: center;
    }

    /* Difficulty colours, easy → hard */
    .cluster-petal.level-1 { fill: #22c55e; }
    .cluster-petal.level-2 { fill: #84cc16; }
    .cluster-petal.level-3 { fill: #facc15; }
    .cluster-petal.level-4 { fill: #f97316; }
    .cluster-petal.level-5 { fill: #ef4444; }

    /* A picked level stands out and the rest step back — again without any outline */
    .cluster-petals:has(.active) .cluster-petal:not(.active) {
        opacity: 0.3;
    }

    .cluster-petal.active {
        transform: scale(1.08);
    }

    .cluster-dot {
        position: absolute;
        width: 44px;
        height: 44px;
        outline: none;
        border-radius: 50%;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text-primary);
        font-size: 1.05rem;
        font-weight: 700;
        box-shadow: var(--shadow-md);
        transition: all 0.15s ease;
    }

    .cluster-dot:active:not(:disabled) {
        transform: scale(0.92);
    }

    .cluster-dot.correct   { background: #22c55e; border-color: transparent; color: #fff; }
    .cluster-dot.incorrect { background: #ef4444; border-color: transparent; color: #fff; }
    .cluster-dot.muted     { opacity: 0.45; }

    /* A quarter disc in the very corner: its flat sides lie on the bottom and right edges,
       its arc faces up-left, and the petals continue outward from that arc. */
    .cluster-core {
        position: absolute;
        right: var(--cluster-inset);
        bottom: var(--cluster-inset);
        width: 78px;
        height: 78px;
        border-radius: 100% 0 0 0;
        border: none;
        background: var(--accent-gradient);
        color: #fff;
        font-size: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        /* The visual middle of a quarter disc is its centroid, 4R/3π ≈ 0.42R from each flat side,
           not the middle of the box — padding on the far sides moves the icon there. */
        padding: 12px 0 0 12px;
        box-shadow: -2px -2px 14px var(--accent-shadow-strong);
        transform-origin: bottom right;
        transition: transform 0.15s ease, opacity 0.15s ease;
    }

    .cluster-core:active:not(:disabled) {
        transform: scale(0.94);
    }

    .cluster-core:disabled {
        opacity: 0.45;
    }

    /* The decorative hub: solid but quiet, and it never looks pressable */
    .cluster-core.inert,
    .cluster-core.inert:disabled {
        opacity: 1;
        background: var(--surface-alt);
        border: 1px solid var(--border);
        color: var(--text-muted);
        box-shadow: none;
        cursor: default;
    }

    .cluster-core.speaking {
        animation: core-pulse 1s ease-in-out infinite;
    }

    @@keyframes core-pulse {
        0%, 100% { transform: scale(1); }
        50%      { transform: scale(1.08); }
    }

</style>
