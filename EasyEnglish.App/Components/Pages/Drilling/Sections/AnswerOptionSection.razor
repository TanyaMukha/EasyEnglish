@*
    Answer options. On a phone or tablet they get a second, thumb-reachable form: one petal per
    option in the bottom-right corner, numbered to match the list. Both work — tap the option or
    tap its petal. No core button here: "Далі" already lives in the action bar.
    On desktop only the list is shown, as before.
*@

<div class="options-grid">
    @foreach (var (option, index) in AnswerOptions.Select((option, index) => (option, index)))
    {
        var current = option;

        <button class="@GetButtonClass(current)"
                @onclick="() => SelectAnswer(current)"
                disabled="@IsAnswerSubmitted">
            <span class="option-number">@(index + 1)</span>
            <span class="option-text"><EntryText Value="@current" /></span>
        </button>
    }
</div>

<CornerCluster Items="@OptionPetals"
               Shape="CornerCluster.ClusterShape.Petal"
               OnItemClick="@SelectByIndex"
               ShowCore="true" />

@code {
    [Parameter] public List<string>         AnswerOptions     { get; set; } = new();
    [Parameter] public bool                 IsAnswerSubmitted { get; set; }
    [Parameter] public string               CorrectAnswer     { get; set; } = "";
    [Parameter] public EventCallback<bool>  OnAnswerSelected  { get; set; }

    private string _selectedOption = "";

    /// <summary>One petal per option, numbered to match the list above.</summary>
    private IReadOnlyList<CornerCluster.ClusterItem> OptionPetals => AnswerOptions
        .Select((option, index) => new CornerCluster.ClusterItem(
            Label:    (index + 1).ToString(),
            Title:    option,
            CssClass: PetalClass(option)))
        .ToList();

    private string PetalClass(string option)
    {
        if (!IsAnswerSubmitted) return "option";
        if (option == CorrectAnswer)   return "correct";
        if (option == _selectedOption) return "incorrect";
        return "muted";
    }

    private Task SelectByIndex(int index) =>
        index >= 0 && index < AnswerOptions.Count ? SelectAnswer(AnswerOptions[index]) : Task.CompletedTask;

    private async Task SelectAnswer(string option)
    {
        if (IsAnswerSubmitted) return;

        _selectedOption = option;
        var isCorrect   = string.Equals(option, CorrectAnswer, StringComparison.OrdinalIgnoreCase);
        await OnAnswerSelected.InvokeAsync(isCorrect);
    }

    private string GetButtonClass(string option)
    {
        if (!IsAnswerSubmitted) return "option-button";
        if (option == CorrectAnswer)   return "option-button correct";
        if (option == _selectedOption) return "option-button incorrect";
        return "option-button disabled";
    }
}

<style>
    .options-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        margin-top: 2rem;
        width: 100%;
    }

    @@media (min-width: 576px) {
        .options-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .option-button {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 1.25rem;
        background: var(--surface);
        border: 2px solid var(--border);
        border-radius: 12px;
        font-size: 1.05rem;
        color: var(--text-primary);
        text-align: left;
        transition: all 0.2s ease;
    }

    /* The number ties an option to its petal in the corner */
    .option-number {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        flex-shrink: 0;
        border-radius: 50%;
        background: var(--surface-alt);
        border: 1px solid var(--border);
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--text-secondary);
    }

    .option-button.correct .option-number {
        background: #22c55e;
        border-color: transparent;
        color: #fff;
    }

    .option-button.incorrect .option-number {
        background: #ef4444;
        border-color: transparent;
        color: #fff;
    }

    .option-text {
        flex: 1;
        min-width: 0;
    }

    .option-button:hover:not(:disabled) {
        border-color: var(--accent);
    }

    .option-button.correct {
        border-color: #22c55e;
        background: rgba(34, 197, 94, 0.12);
    }

    .option-button.incorrect {
        border-color: #ef4444;
        background: rgba(239, 68, 68, 0.12);
    }

    .option-button.disabled {
        opacity: 0.5;
    }

    /* Both ways work on touch: tap the option itself or its numbered petal in the corner.
       Back to one option per row — the number is what ties the two together now, so the list
       no longer has to mirror the corner layout. */
    @@media (max-width: 1024px) {
        .options-grid {
            grid-template-columns: 1fr;
            gap: 0.6rem;
        }

        .option-button {
            padding: 0.7rem 0.9rem;
            font-size: 0.95rem;
        }

        .option-text {
            overflow-wrap: anywhere;
        }

        .options-grid {
            margin-top: 1.25rem;
            /* Room for the corner cluster so the last option is never hidden behind it */
            padding-bottom: 8rem;
        }
    }
</style>
