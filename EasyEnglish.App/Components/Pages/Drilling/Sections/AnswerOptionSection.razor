@* AnswerOptionSection.razor - Компонент для відображення варіантів відповідей *@

<div class="options-grid">
    @foreach (var option in AnswerOptions)
    {
        <button class="@GetButtonClass(option)"
                @onclick="() => SelectAnswer(option)"
                disabled="@IsAnswerSubmitted">
            @option
        </button>
    }
</div>

@code {
    [Parameter] public List<string>         AnswerOptions     { get; set; } = new();
    [Parameter] public bool                 IsAnswerSubmitted { get; set; }
    [Parameter] public string               CorrectAnswer     { get; set; } = "";
    [Parameter] public EventCallback<bool>  OnAnswerSelected  { get; set; }

    private string _selectedOption = "";

    private async Task SelectAnswer(string option)
    {
        _selectedOption = option;
        var isCorrect   = string.Equals(option, CorrectAnswer, StringComparison.OrdinalIgnoreCase);
        await OnAnswerSelected.InvokeAsync(isCorrect);
    }

    private string GetButtonClass(string option)
    {
        if (!IsAnswerSubmitted) return "option-button";
        if (option == CorrectAnswer)   return "option-button correct";
        if (option == _selectedOption) return "option-button incorrect";
        return "option-button disabled";
    }
}

<style>
    .options-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        margin-top: 2rem;
        width: 100%;
    }

    @@media (min-width: 576px) {
        .options-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .option-button {
        padding: 1rem 1.5rem;
        background: var(--surface);
        border: 2px solid var(--border-muted);
        border-radius: 8px;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.2s;
        text-align: left;
        color: var(--text-primary);
    }

    .option-button:not(:disabled):hover {
        border-color: #A3BFFA;
        background: var(--surface-alt);
        transform: translateX(4px);
    }

    .option-button:disabled {
        cursor: not-allowed;
    }

    .option-button.correct {
        border-color: #28a745;
        background: #d4edda;
        color: #155724;
        font-weight: 600;
    }

    .option-button.incorrect {
        border-color: #dc3545;
        background: #f8d7da;
        color: #721c24;
        font-weight: 600;
    }

    .option-button.disabled {
        opacity: 0.5;
    }
</style>
