@* TestCardQuestionSection.razor - test card header: optional image, question, formatted content, hint *@
@using EasyEnglish.App.Services

<div class="testcard-question-section">
    @if (ImageDataUri is not null)
    {
        <img src="@ImageDataUri" alt="" class="testcard-question-image" />
    }

    @if (!string.IsNullOrWhiteSpace(Text))
    {
        <h3 class="testcard-question-text">@((MarkupString)ExampleMarkdownService.RenderMarkdown(Text))</h3>
    }

    @if (!string.IsNullOrWhiteSpace(FormattedText))
    {
        <div class="testcard-formatted-text">@((MarkupString)ExampleMarkdownService.RenderMarkdown(FormattedText))</div>
    }

    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <div class="testcard-hint-block">
            <div class="testcard-hint-text">
                <i class="bi bi-lightbulb-fill"></i> @Hint
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public byte[]? Image { get; set; }
    [Parameter] public string? FormattedText { get; set; }

    private string? ImageDataUri => ImageDataUriHelper.BuildDataUri(Image);
}

<style>
    .testcard-question-section {
        width: 100%;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .testcard-question-text {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }

    .testcard-question-image {
        max-width: 100%;
        max-height: 320px;
        border-radius: 8px;
        margin-bottom: 1rem;
        object-fit: contain;
    }

    .testcard-formatted-text {
        text-align: left;
        white-space: pre-wrap;
        background: var(--surface-alt);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1rem 1.25rem;
        margin-bottom: 1rem;
        font-size: 1rem;
        line-height: 1.6;
        color: var(--text-primary);
    }

    .testcard-hint-block {
        margin-top: 0.75rem;
        display: flex;
        justify-content: center;
    }

    .testcard-hint-text {
        background: var(--surface-alt);
        border-radius: 8px;
        padding: 0.6rem 1rem;
        font-size: 0.95rem;
        color: var(--text-secondary);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    @@media (max-width: 768px) {
        .testcard-question-text {
            font-size: 1.25rem;
        }
    }
</style>
