@page "/word-to-translation-single-choice"
@page "/word-to-translation-know-or-not"
@using System.Dynamic
@using MukhaLab.SelectQueryParameters.Models
@using MukhaLab.Database
@using System.Collections.Generic
@using System.Linq
@using System.Globalization
@inject DailyWordsService DailyWordsService
@inject ILogger<ReviewWords> Logger
@inject IBrowserConsoleService BrowserConsole
@using EasyEnglish.App.Models
@using EasyEnglish.App.Components.Pages.Learning.Shared
@inject NavigationManager NavigationManager
@* @inject WordLearningService WordLearningService *@
@using EasyEnglish.App.Services

<div class="page-content">
    <PageHeader Title="@CardTitle" />

    <LearningCard Title="@CardTitle"
                  HeaderClass="@WordLearningService.GetColorClass(cardType, cardDirection)"
                  IconClass="@WordLearningService.GetCardIcon(cardType, cardDirection)"
                  Rate="@currentItem!.Rate"
                  TotalCount="@totalItems"
                  CompletedCount="@completed"
                  IsLoading="@isLoading"
                  ErrorMessage="@errorMessage"
                  ShowStats="@showStats"
                  CompletedWords="@completed"
                  TotalAttempts="@totalAttempts"
                  CorrectAnswers="@correctAnswers"
                  IncorrectAnswers="@incorrectAnswers"
                  ShowNextButton="@isAnswerSubmitted"
                  OnNextCard="@NextItem"
                  OnFinish="@FinishTest">

        <ChildContent>
            <WordSection Word="@currentItem.Word" Transcription="@currentItem.Transcription" />
            @if (cardType == CardType.KnowOrNot)
            {
                <QuestionSection Text="@currentItem.Translation" Hidden="@(selectedAnswer == currentItem.Transcription)" />
            }

            @if (cardType == CardType.SingleChoice)
            {
                <AnswerOptionSection AnswerOptions="@answerOptions"
                                     IsAnswerSubmitted="@isAnswerSubmitted"
                                     CorrectAnswer="@currentItem.Translation"
                                     SelectedAnswer="@selectedAnswer"
                                     OnAnswerSelected="@CheckAnswer" />
            }
            else if (cardType == CardType.KnowOrNot)
            {
                <AnswerKnowOrNotSection isSelfAssessed="@isAnswerSubmitted"
                                        isKnown="@isKnown"
                                        isVerified="@isVerified"
                                        OnSelfAssess="@SelfAssess"
                                        OnVerifyAssessment="@VerifyAssessment" />
            }
        </ChildContent>

    </LearningCard>
</div>

@code {
    public CardType cardType { get; set; } = CardType.SingleChoice;
    private readonly CardDirection cardDirection = CardDirection.WordToTranslation;

    private List<WordTestModel> items = new();
    private UnitModel? list;
    private List<WordTestModel> pendingItems = new();
    private WordTestModel? currentItem;
    private List<string>? answerOptions;
    private string? selectedAnswer;
    private int currentIndex = 0;
    private bool isLoading = false;
    private string? errorMessage;
    private bool isAnswerSubmitted = false;
    private bool isKnown = false;
    private bool isVerified = false;
    private int correct = 0;
    private int incorrect = 0;
    private bool showStats = false;
    private int totalItems = 0;
    private int correctAnswers = 0;
    private int incorrectAnswers = 0;
    private int totalAttempts = 0;
    private int completed => totalItems - pendingItems.Count;
    private Random random = new Random();

    private string CardTitle => cardType switch
    {
        CardType.SingleChoice => "Переклад для слова",
        CardType.KnowOrNot => "Перевірка перекладу",
        _ => "Тест"
    };

    protected override async Task OnInitializedAsync()
    {
        var currentUri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).LocalPath;
        var (type, direction) = WordLearningService.ParsePageRoute(currentUri.TrimStart('/'));
        cardType = type;

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            var result = await DailyWordsService.GetWordsForToday();
            items = mapper.Map<List<WordTestModel>>(result.Words);
            list = result.Unit;
            pendingItems = items.OrderBy(x => Random.Shared.Next()).ToList();
            totalItems = items.Count;

            if (pendingItems.Any())
            {
                currentIndex = 0;
                currentItem = pendingItems[currentIndex];
                if (cardType == CardType.SingleChoice)
                {
                    PrepareAnswerOptions();
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Помилка завантаження: {ex.Message}";
            items = new();
            pendingItems = new();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void PrepareAnswerOptions()
    {
        if (currentItem == null || items.Count == 0) return;

        var correctAnswer = currentItem.Translation ?? "N/A";
        var options = new List<string> { correctAnswer };

        var randomTranslations = items
            .Where(item => item != currentItem && !string.IsNullOrEmpty(item.Translation))
            .Select(item => item.Translation!)
            .Distinct()
            .OrderBy(x => Guid.NewGuid())
            .Take(3)
            .ToList();

        options.AddRange(randomTranslations);
        answerOptions = options.OrderBy(x => Guid.NewGuid()).ToList();
        isAnswerSubmitted = false;
        selectedAnswer = null;
        StateHasChanged();
    }

    private async Task CheckAnswer(string selectedOption)
    {
        if (currentItem == null) return;

        isAnswerSubmitted = true;
        selectedAnswer = selectedOption;
        totalAttempts++;
        StateHasChanged();
    }

    private void SelfAssess(bool knows)
    {
        isAnswerSubmitted = true;
        isKnown = knows;
        if (knows)
        {
            selectedAnswer = currentItem!.Translation;
        }
        else
        {
            selectedAnswer = "";
            totalAttempts++;
        }
        StateHasChanged();
    }

    private void VerifyAssessment(bool knows)
    {
        isVerified = true;
        totalAttempts++;
        if (knows)
        {
            selectedAnswer = currentItem!.Translation;
        }
        else
        {
            selectedAnswer = "";
        }
        StateHasChanged();
    }

    private async Task NextItem()
    {
        if (selectedAnswer == currentItem!.Translation)
        {
            correctAnswers++;
            currentItem.Tests[cardDirection][cardType].CorrectAnswers++;
            currentItem.Tests[cardDirection][cardType].TotalAttempts++;
            pendingItems.RemoveAt(currentIndex);
        }
        else
        {
            incorrectAnswers++;
            currentItem.Tests[cardDirection][cardType].TotalAttempts++;
            if (pendingItems.Count > 1)
            {
                var item = pendingItems[currentIndex];
                pendingItems.RemoveAt(currentIndex);
                int offset = random.Next(2, 5);
                int insertAt = Math.Min(currentIndex + offset, pendingItems.Count);
                pendingItems.Insert(insertAt, item);
                currentIndex = currentIndex % pendingItems.Count;
            }
            else
            {
                PrepareForNextCard();
                await Task.CompletedTask;
                return;
            }
        }

        if (pendingItems.Any())
        {
            currentIndex = currentIndex % pendingItems.Count;
            currentItem = pendingItems[currentIndex];
            PrepareForNextCard();
        }
        else
        {
            showStats = true;
        }
        StateHasChanged();
        await Task.CompletedTask;
    }

    private void PrepareForNextCard()
    {
        isAnswerSubmitted = false;
        isVerified = false;
        selectedAnswer = null;
        if (cardType == CardType.SingleChoice)
        {
            PrepareAnswerOptions();
        }
    }

    private async Task FinishTest()
    {
        var wordsToUpdate = WordRatingCalculator.UpdateWordRate(items);
        await WordService.UpdateWordRateRangeAsync(mapper.Map<List<UpdateWordRateRequest>>(wordsToUpdate));
        DailyWordsService.ClearCache();
        await BrowserConsole.LogInfoAsync("Word rates updated.");
        NavigationManager.NavigateTo("/learning-words");
    }
}

<style>
    .page-content {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }
</style>
