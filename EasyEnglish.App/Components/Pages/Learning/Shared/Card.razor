<div class="card shadow-sm border-0 learning-card mx-auto" style="max-width: 600px;">
    <div class="card-header @HeaderClass text-dark d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <i class="bi @IconClass me-2"></i> @Title
        </div>
        @if (HeaderActions != null)
        {
            <div class="header-actions">
                @HeaderActions
            </div>
        }
    </div>
    <div class="card-body d-flex flex-column align-items-center position-relative">
        @if (ChildContent != null)
        {
            @ChildContent
        }

        @if (ActionsContent != null)
        {
            <div class="actions-section d-flex justify-content-end mt-4 w-100">
                @ActionsContent
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string HeaderClass { get; set; } = "pastel-blue";
    [Parameter] public string IconClass { get; set; } = "bi-translate";

    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public RenderFragment? ActionsContent { get; set; }

    // Основний слот для повного контролю вмісту
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

<style>
    .learning-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease, opacity 0.3s ease;
        animation: fadeIn 0.5s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .learning-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15) !important;
    }

    .card {
        border-radius: 12px;
    }

    .header-actions {
        display: flex;
        gap: 0.5rem;
    }
</style>