@using System.Globalization

@inject NavigationManager NavigationManager

<div class="review-card">
    <div class="card-header-gradient">
        <div class="header-info">
            <i class="bi bi-book"></i>
            @if (!string.IsNullOrEmpty(CourseTitle))
            {
                <span>@CourseTitle / </span>
            }
            @UnitTitle
        </div>
        <div class="rate-display">
            <i class="bi bi-star-fill"></i>
            <span class="rate-value">@Rate.ToString("F1", CultureInfo.InvariantCulture)</span>
        </div>
    </div>

    <div class="card-body">
        @ChildContent
    </div>

    @if (ShowNavigation)
    {
        <div class="card-footer">
            <button class="btn-nav previous"
            @onclick="OnPrevious"
            disabled="@(!CanGoPrevious)">
                <i class="bi bi-chevron-left"></i>
                Назад
            </button>
            <span class="progress-text">
                @CurrentIndex / @TotalCount
            </span>
            @if (CanGoNext)
            {
                <button class="btn-nav next"
                        @onclick="OnNext"
                        disabled="@(!CanGoNext)">
                    Далі
                    <i class="bi bi-chevron-right"></i>
                </button>
            }
            else
            {
                <button class="btn-nav finish"
                        @onclick="OnFinish">
                    Завершити
                    <i class="bi bi-check2-circle"></i>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string UnitTitle { get; set; } = "";
    [Parameter] public string? CourseTitle { get; set; }
    [Parameter] public float Rate { get; set; }
    [Parameter] public int CurrentIndex { get; set; }
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public bool ShowNavigation { get; set; } = true;
    [Parameter] public bool CanGoPrevious { get; set; } = true;
    [Parameter] public bool CanGoNext { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnFinish { get; set; }
}

<style>
    .review-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        animation: fadeIn 0.5s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .review-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    }

    .card-header-gradient {
        background: linear-gradient(135deg, #A3BFFA, #7B9FE8);
        color: white;
        padding: 1.25rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-info {
        font-size: 1rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .rate-display {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.25rem;
        font-weight: 600;
    }

        .rate-display i {
            color: #FFD700;
            font-size: 1.5rem;
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
        }

    .rate-value {
        font-size: 1.25rem;
        font-weight: 700;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
    }

    .card-body {
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .card-footer {
        padding: 1.25rem 1.5rem;
        background: #f8f9fa;
        border-top: 1px solid #dee2e6;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-nav {
        padding: 0.5rem 1rem;
        background: white;
        color: #666;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }

        .btn-nav:hover:not(:disabled) {
            background: #A3BFFA;
            color: white;
            border-color: #A3BFFA;
        }

        .btn-nav:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

    .progress-text {
        color: #666;
        font-size: 0.9rem;
        font-weight: 500;
    }

    @@media (max-width: 768px) {
        .card-footer {
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        .progress-text {
            order: -1;
            width: 100%;
            text-align: center;
        }

        .rate-display {
            font-size: 1rem;
        }

            .rate-display i {
                font-size: 1.25rem;
            }

        .rate-value {
            font-size: 1rem;
        }
    }
</style>
