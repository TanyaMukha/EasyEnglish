<div class="col @(countCards > 0 ? "" : "disabled-card")">
    <div class="card h-100 shadow-sm border-0 learning-card">
        <div class="card-header @CardColor text-dark d-flex align-items-center">
            <i class="bi @CardIcon me-2"></i> @Title
        </div>
        <div class="card-body">
            <p class="card-text">@Description</p>
            <p>Count cards: @countCards</p>
            <a href="@Link" class="btn btn-outline-success btn-sm">@ButtonCaption</a>
            @if (IncludeInMultiTest)
            {
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" @bind="@isIncluded" @bind:after="async () => await isIncludedChanged.InvokeAsync()" />
                
                    <label class="form-check-label">Include in Multi-Test</label>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } 
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Link { get; set; }
    [Parameter] public string? ButtonCaption { get; set; }
    [Parameter] public bool IncludeInMultiTest { get; set; } = false;
    [Parameter] public int countCards { get; set; } = 0;
    [Parameter] public bool isIncluded { get; set; }
    [Parameter] public EventCallback<bool> isIncludedChanged { get; set; }
    [Parameter] public string CardColor { get; set; }
    [Parameter] public string CardIcon { get; set; }
}

<style>
    /* Custom styles for the learning cards */
    .learning-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .learning-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15) !important;
        }

    .card-header {
        font-size: 1.25rem;
        font-weight: 500;
        border-bottom: none; /* Remove border for cleaner look */
    }

    .card-text {
        color: #555;
    }

    .btn {
        transition: background-color 0.3s ease, color 0.3s ease;
    }

    /* Ensure cards are consistent in height */
    .card {
        border-radius: 12px; /* Slightly larger border radius for softer look */
    }

    .disabled-card {
        opacity: 0.5;
        pointer-events: none;
        cursor: not-allowed;
    }

        .disabled-card .card {
            background-color: #f8f9fa;
        }

    /* Responsive adjustments */
    @@media (max-width: 576px) {
        .card-header {
            font-size: 1rem;
        }

        .card-text {
            font-size: 0.9rem;
        }

        .btn-sm {
            font-size: 0.8rem;
        }
    }
</style>