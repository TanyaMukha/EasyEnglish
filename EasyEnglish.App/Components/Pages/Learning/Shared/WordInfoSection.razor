@* WordInfoSection.razor - Повна інформація про слово (для Review) *@

<div class="word-info-section">
    <h2 class="word-title">@Word</h2>
    
    @if (!string.IsNullOrEmpty(Transcription))
    {
        <p class="transcription">[ @Transcription ]</p>
    }
    
    @if (!string.IsNullOrEmpty(Translation))
    {
        <p class="translation">@Translation</p>
    }
    
    @if (Examples != null && Examples.Any())
    {
        <div class="example-section">
            <p class="example-text">@Examples[0].Sentence</p>
            <p class="example-translation">
                <i>@Examples[0].Translation</i>
            </p>
        </div>
    }
    else if (ShowNoExamples)
    {
        <p class="no-examples">Немає прикладів</p>
    }
</div>

@code {
    [Parameter] public string Word { get; set; } = "";
    [Parameter] public string? Transcription { get; set; }
    [Parameter] public string? Translation { get; set; }
    [Parameter] public IList<ExampleModel>? Examples { get; set; }
    [Parameter] public bool ShowNoExamples { get; set; } = true;
}

<style>
    .word-info-section {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .word-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #333;
        margin: 0 0 0.75rem 0;
        text-align: center;
    }

    .transcription {
        font-size: 1.25rem;
        color: #666;
        font-style: italic;
        margin: 0 0 1.5rem 0;
        text-align: center;
    }

    .translation {
        font-size: 1.5rem;
        color: #333;
        margin: 0 0 2rem 0;
        text-align: center;
        font-weight: 500;
    }

    .example-section {
        width: 100%;
        padding: 1.5rem;
        background: #f8f9fa;
        border-radius: 8px;
        margin-bottom: 2rem;
    }

    .example-text {
        font-size: 1.1rem;
        color: #333;
        margin: 0 0 0.5rem 0;
    }

    .example-translation {
        font-size: 1rem;
        color: #666;
        margin: 0;
    }

    .no-examples {
        color: #999;
        font-style: italic;
        margin: 0 0 2rem 0;
    }

    @@media (max-width: 768px) {
        .word-title {
            font-size: 2rem;
        }

        .translation {
            font-size: 1.25rem;
        }

        .transcription {
            font-size: 1rem;
        }
    }
</style>
