@* DifficultyRatingSection.razor - Кнопки оцінки складності (5 рівнів) *@

<div class="difficulty-section">
    <div class="difficulty-buttons">
        <button class="btn-difficulty level-5"
                @onclick="() => OnRate.InvokeAsync(5.0)"
                disabled="@IsRating"
                title="Дуже складно">
            @if (IsRating && LastRatedValue == 5.0)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
        </button>

        <button class="btn-difficulty level-4"
                @onclick="() => OnRate.InvokeAsync(4.0)"
                disabled="@IsRating"
                title="Складно">
            @if (IsRating && LastRatedValue == 4.0)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
        </button>

        <button class="btn-difficulty level-3"
                @onclick="() => OnRate.InvokeAsync(3.0)"
                disabled="@IsRating"
                title="Середньо">
            @if (IsRating && LastRatedValue == 3.0)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
        </button>

        <button class="btn-difficulty level-2"
                @onclick="() => OnRate.InvokeAsync(2.0)"
                disabled="@IsRating"
                title="Легко">
            @if (IsRating && LastRatedValue == 2.0)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
        </button>

        <button class="btn-difficulty level-1"
                @onclick="() => OnRate.InvokeAsync(1.0)"
                disabled="@IsRating"
                title="Дуже легко">
            @if (IsRating && LastRatedValue == 1.0)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback<double> OnRate { get; set; }
    [Parameter] public bool IsRating { get; set; } = false;
    [Parameter] public double LastRatedValue { get; set; } = 0;
}

<style>
    .difficulty-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .difficulty-buttons {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        justify-content: center;
    }

    .btn-difficulty {
        width: 32px;
        height: 32px;
        border: none;
        border-radius: 8px;
        font-size: 1.5rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        box-shadow: 0 3px 6px rgba(0, 0, 0, 0.15);
        position: relative;
        overflow: hidden;
    }

    .btn-difficulty::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.2), transparent);
        opacity: 0;
        transition: opacity 0.3s;
    }

    .btn-difficulty:hover:not(:disabled)::before {
        opacity: 1;
    }

    .btn-difficulty:hover:not(:disabled) {
        transform: translateX(-6px) scale(1.08);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    }

    .btn-difficulty:active:not(:disabled) {
        transform: translateX(-3px) scale(1.04);
    }

    /* Градієнт від зеленого до червоного */
    .btn-difficulty.level-1 {
        background: linear-gradient(135deg, #22c55e, #16a34a);
    }

    .btn-difficulty.level-2 {
        background: linear-gradient(135deg, #84cc16, #65a30d);
    }

    .btn-difficulty.level-3 {
        background: linear-gradient(135deg, #facc15, #eab308);
    }

    .btn-difficulty.level-4 {
        background: linear-gradient(135deg, #f97316, #ea580c);
    }

    .btn-difficulty.level-5 {
        background: linear-gradient(135deg, #ef4444, #dc2626);
    }

    .btn-difficulty:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none !important;
    }

    @@media (max-width: 768px) {
        .difficulty-buttons {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 0.5rem;
            justify-content: center;
        }

        .btn-difficulty {
            width: 28px;
            height: 28px;
        }

        .btn-difficulty:hover:not(:disabled) {
            transform: translateY(-4px) scale(1.05);
        }
    }

    @@media (max-width: 480px) {
        .btn-difficulty {
            width: 24px;
            height: 24px;
        }
    }
</style>
