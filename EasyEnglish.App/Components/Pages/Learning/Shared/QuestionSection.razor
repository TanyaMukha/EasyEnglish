@* QuestionSection.razor - Компонент для відображення питання *@

@if(!Hidden)
{
    <div class="question-section">
        <h3 class="question-text">@Text</h3>
    </div>
}

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public bool Hidden { get; set; } = false;
}

<style>
    .question-section {
        width: 100%;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .question-text {
        font-size: 1.5rem;
        font-weight: 600;
        color: #333;
        margin: 0;
    }

    @@media (max-width: 768px) {
        .question-text {
            font-size: 1.25rem;
        }
    }
</style>
