@* AnswerKnowOrNotSection.razor - Компонент для самооцінки знань *@

@if (isSelfAssessed && isKnown)
{
    <div class="verify-section">
        <p class="verify-question">Ваша відповідь була правильною?</p>
        <div class="verify-buttons">
            <button class="btn-correct" @onclick="() => VerifyAssessment(true)" disabled="@isVerified">
                <i class="bi bi-check-lg"></i>
                Так
            </button>
            <button class="btn-incorrect" @onclick="() => VerifyAssessment(false)" disabled="@isVerified">
                <i class="bi bi-x-lg"></i>
                Ні
            </button>
        </div>
    </div>
}
else if (!isSelfAssessed)
{
    <div class="self-assess-section">
        <p class="assess-question">Ви знаєте цю відповідь?</p>
        <div class="self-assess-buttons">
            <button class="btn-know" @onclick="() => SelfAssess(true)">
                <i class="bi bi-check-lg"></i>
                Знаю
            </button>
            <button class="btn-dont-know" @onclick="() => SelfAssess(false)">
                <i class="bi bi-x-lg"></i>
                Не знаю
            </button>
        </div>
    </div>
}

@if (isVerified || !isKnown && isSelfAssessed)
{
    <div class="feedback @alertClass">
        <i class="bi @(alertClass == "success" ? "bi-check-circle" : "bi-x-circle")"></i>
        @feedbackMessage
    </div>
}

@code {
    [Parameter] public bool isSelfAssessed { get; set; } = false;
    [Parameter] public bool isKnown { get; set; } = false;
    [Parameter] public bool isVerified { get; set; } = false;
    [Parameter] public EventCallback<bool> OnSelfAssess { get; set; }
    [Parameter] public EventCallback<bool> OnVerifyAssessment { get; set; }

    private string feedbackMessage = "Потребує повторення!";
    private string alertClass = "warning";

    private async Task SelfAssess(bool isKnow)
    {
        await OnSelfAssess.InvokeAsync(isKnow);
        feedbackMessage = "Потребує повторення!";
        alertClass = "warning";
        StateHasChanged();
    }

    private async Task VerifyAssessment(bool isCorrectAssessment)
    {
        await OnVerifyAssessment.InvokeAsync(isCorrectAssessment);
        if (isCorrectAssessment)
        {
            feedbackMessage = "Чудова робота!";
            alertClass = "success";
        }
        else
        {
            feedbackMessage = "Потрібно ще попрацювати!";
            alertClass = "error";
        }
        StateHasChanged();
    }
}

<style>
    .self-assess-section,
    .verify-section {
        margin-top: 2rem;
        width: 100%;
    }

    .assess-question,
    .verify-question {
        font-size: 1rem;
        color: #666;
        margin: 0 0 1rem 0;
        text-align: center;
        font-weight: 500;
    }

    .self-assess-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
    }

    .btn-know,
    .btn-dont-know {
        flex: 1;
        max-width: 200px;
        padding: 1rem 1.5rem;
        border: none;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-know {
        background: #28a745;
        color: white;
    }

    .btn-know:hover {
        background: #218838;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(40, 167, 69, 0.3);
    }

    .btn-dont-know {
        background: #dc3545;
        color: white;
    }

    .btn-dont-know:hover {
        background: #c82333;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(220, 53, 69, 0.3);
    }

    .verify-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
    }

    .btn-correct,
    .btn-incorrect {
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-correct {
        background: #28a745;
        color: white;
    }

    .btn-correct:hover:not(:disabled) {
        background: #218838;
        transform: translateY(-2px);
    }

    .btn-incorrect {
        background: #dc3545;
        color: white;
    }

    .btn-incorrect:hover:not(:disabled) {
        background: #c82333;
        transform: translateY(-2px);
    }

    .btn-correct:disabled,
    .btn-incorrect:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .feedback {
        margin-top: 1.5rem;
        padding: 1rem 1.5rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 500;
        width: 100%;
    }

    .feedback.success {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .feedback.error {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .feedback.warning {
        background: #fff3cd;
        color: #856404;
        border: 1px solid #ffeeba;
    }

    .feedback i {
        font-size: 1.25rem;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .self-assess-buttons {
            flex-direction: column;
        }

        .btn-know,
        .btn-dont-know {
            max-width: none;
        }
    }
</style>
