@page "/multi-test"
@using System.Dynamic
@using MukhaLab.SelectQueryParameters.Models
@using MukhaLab.Database
@using System.Collections.Generic
@using EasyEnglish.App.Models
@using EasyEnglish.App.Components.Pages.Learning.Shared
@using EasyEnglish.App.Services
@inject DailyWordsService DailyWordsService
@inject ILogger<MultiTest> Logger
@inject IBrowserConsoleService BrowserConsole
@inject NavigationManager NavigationManager

<div class="page-content">
    <PageHeader Title="Мульті-тест" />

    <LearningCard 
        Title="@GetTestTitle()"
        HeaderClass="@GetHeaderClass()"
        IconClass="@GetIconClass()"
        Rate="@(currentItem?.Rate ?? 0)"
        TotalCount="@totalItems"
        CompletedCount="@completed"
        IsLoading="@isLoading"
        ErrorMessage="@errorMessage"
        ShowStats="@showStats"
        CompletedWords="@completed"
        TotalAttempts="@totalAttempts"
        CorrectAnswers="@correctAnswers"
        IncorrectAnswers="@incorrectAnswers"
        ShowNextButton="@(GetShowNextButton())"
        OnNextCard="@NextItem"
        OnFinish="@FinishTest">

        <ChildContent>
            @if (currentItem != null && !string.IsNullOrEmpty(currentTestType))
            {
                @* Review Words *@
                @if (currentTestType == "review-words")
                {
                    <div class="info-card-body w-100">
                        <WordInfoSection 
                            Word="@currentItem.Word"
                            Transcription="@currentItem.Transcription"
                            Translation="@currentItem.Translation"
                            Examples="@currentItem.Examples"
                            ShowNoExamples=false />
                    </div>
                }

                @* Word-to-Translation Tests *@
                else if (currentTestType == "word-to-translation-single-choice")
                {
                    <WordSection Word="@currentItem.Word" Transcription="@currentItem.Transcription" />
                    <AnswerOptionSection 
                        AnswerOptions="@answerOptions"
                        IsAnswerSubmitted="@isAnswerSubmitted"
                        CorrectAnswer="@currentItem.Translation"
                        SelectedAnswer="@selectedAnswer"
                        OnAnswerSelected="@CheckAnswer" />
                }
                else if (currentTestType == "word-to-translation-know-or-not")
                {
                    <WordSection Word="@currentItem.Word" Transcription="@currentItem.Transcription" />
                    @* word-to-translation-know-or-not *@
                    @if (!isSelfAssessed)
                    {
                        <AnswerKnowOrNotSection 
                            isSelfAssessed="@false"
                            isKnown="@false"
                            isVerified="@false"
                            OnSelfAssess="@SelfAssess"
                            OnVerifyAssessment="@VerifyAssessment"
                            OnNext="@NextItem" />
                    }
                    else
                    {
                        <QuestionSection Text="@currentItem.Translation" />
                        <AnswerKnowOrNotSection 
                            isSelfAssessed="@true"
                            isKnown="@isKnown"
                            isVerified="@isVerified"
                            OnSelfAssess="@SelfAssess"
                            OnVerifyAssessment="@VerifyAssessment"
                            OnNext="@NextItem" />
                        }
                    }

                @* Translation-to-Word Tests *@
                else if (currentTestType == "translation-to-word-single-choice")
                {
                    @* <WordSection Word="@currentItem.Word" Transcription="@currentItem.Transcription" Hidden="@(!isAnswerSubmitted)" /> *@
                    <QuestionSection Text="@currentItem.Translation" />
                    <AnswerOptionSection 
                        AnswerOptions="@answerOptions"
                        IsAnswerSubmitted="@isAnswerSubmitted"
                        CorrectAnswer="@currentItem.Word"
                        SelectedAnswer="@selectedAnswer"
                        OnAnswerSelected="@CheckAnswer" />
                }
                else if (currentTestType == "translation-to-word-know-or-not")
                {
                    <WordSection Word="@currentItem.Word" Transcription="@currentItem.Transcription" Hidden="@(!isSelfAssessed)" />
                    <QuestionSection Text="@currentItem.Translation" />
                    <AnswerKnowOrNotSection 
                        isSelfAssessed="@isSelfAssessed"
                        isKnown="@isKnown"
                        isVerified="@isVerified"
                        OnSelfAssess="@SelfAssess"
                        OnVerifyAssessment="@VerifyAssessment"
                        OnNext="@NextItem" />
                }
                else if (currentTestType == "translation-to-word-manual-input")
                {
                    <WordSection Word="@currentItem.Word" Transcription="@currentItem.Transcription" Hidden="@(!isAnswerSubmitted)" />
                    <QuestionSection Text="@currentItem.Translation" />
                    <AnswerInputSection 
                        isAnswerSubmitted="@isAnswerSubmitted"
                        CorrectAnswer="@currentItem.Word"
                        OnAnswerSubmitted="@CheckAnswer" />
                }
            }
        </ChildContent>
    </LearningCard>
</div>

@code {
    // Test configuration
    private List<string> selectedTests = new();
    private string currentTestType = "";
    private int currentTestIndex = 0;

    // Data
    private List<WordTestModel> items = new();
    private UnitModel? list;
    private List<(WordTestModel word, string testType)> pendingItems = new();
    private WordTestModel? currentItem;
    private List<string>? answerOptions;
    private string? selectedAnswer;

    // State
    private int currentIndex = 0;
    private bool isLoading = false;
    private string? errorMessage;
    private bool isAnswerSubmitted = false;
    private bool isSelfAssessed = false;
    private bool isKnown = false;
    private bool isVerified = false;
    private bool showStats = false;
    private bool isRating = false;
    private double lastRatedValue = 0;
    private bool isRated = false; // Для review-words в мультітесті

    // Statistics
    private int totalItems = 0;
    private int correctAnswers = 0;
    private int incorrectAnswers = 0;
    private int totalAttempts = 0;
    private int completed => totalItems - pendingItems.Count;

    private Random random = new Random();

    protected override async Task OnInitializedAsync()
    {
        ParseQueryParameters();
        await LoadData();
    }

    private void ParseQueryParameters()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = uri.Query;

        if (!string.IsNullOrEmpty(query))
        {
            // Парсимо query string вручну
            var queryParams = query.TrimStart('?')
                .Split('&')
                .Select(param => param.Split('='))
                .Where(parts => parts.Length == 2)
                .ToDictionary(parts => parts[0], parts => Uri.UnescapeDataString(parts[1]));

            if (queryParams.TryGetValue("tests", out var testsValue))
            {
                selectedTests = testsValue.Split(',').ToList();
            }
        }
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            var result = await DailyWordsService.GetWordsForToday();
            items = mapper.Map<List<WordTestModel>>(result.Words);
            list = result.Unit;

            // Create test items for each selected test type
            foreach (var word in items)
            {
                foreach (var testType in selectedTests)
                {
                    pendingItems.Add((word, testType));
                }
            }

            // Shuffle the pending items
            pendingItems = pendingItems
                .Select(x => new { Item = x, Priority = WordLearningService.GetTestPriority(ParseTestType(x.testType)), Random = Guid.NewGuid() })
                .OrderBy(x => x.Priority)
                .ThenBy(x => x.Random)
                .Select(x => x.Item)
                .ToList();
            totalItems = pendingItems.Count;

            if (pendingItems.Any())
            {
                LoadNextTestItem();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Помилка завантаження: {ex.Message}";
            items = new();
            pendingItems = new();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void LoadNextTestItem()
    {
        if (!pendingItems.Any()) return;

        var (word, testType) = pendingItems[currentIndex];
        currentItem = word;
        currentTestType = testType;

        // Reset state
        isAnswerSubmitted = false;
        isSelfAssessed = false;
        isKnown = false;
        isVerified = false;
        selectedAnswer = null;
        isRated = false;

        // Generate options for single choice tests
        if (testType.Contains("single-choice"))
        {
            GenerateAnswerOptions();
        }

        StateHasChanged();
    }

    private void GenerateAnswerOptions()
    {
        if (currentItem == null || items.Count == 0) return;

        string correctAnswer;
        Func<WordTestModel, string?> selector;

        if (currentTestType.StartsWith("word-to-translation"))
        {
            correctAnswer = currentItem.Translation ?? "N/A";
            selector = item => item.Translation;
        }
        else // translation-to-word
        {
            correctAnswer = currentItem.Word ?? "N/A";
            selector = item => item.Word;
        }

        var options = new List<string> { correctAnswer };

        var randomOptions = items
            .Where(item => item != currentItem && !string.IsNullOrEmpty(selector(item)))
            .Select(item => selector(item)!)
            .Distinct()
            .OrderBy(x => Guid.NewGuid())
            .Take(3)
            .ToList();

        options.AddRange(randomOptions);
        answerOptions = options.OrderBy(x => Guid.NewGuid()).ToList();
    }

    private string GetCorrectAnswer()
    {
        if (currentItem == null) return "";

        return currentTestType.StartsWith("word-to-translation") 
            ? currentItem.Translation ?? "" 
            : currentItem.Word ?? "";
    }

    private async Task CheckAnswer(string answer)
    {
        if (currentItem == null) return;

        isAnswerSubmitted = true;
        selectedAnswer = answer;
        totalAttempts++;

        if (answer == GetCorrectAnswer())
        {
            correctAnswers++;
        }
        else
        {
            incorrectAnswers++;
        }

        StateHasChanged();
        await Task.CompletedTask;
    }

    private void SelfAssess(bool knows)
    {
        isSelfAssessed = true;
        isKnown = knows;

        if (!knows)
        {
            totalAttempts++;
            incorrectAnswers++;
        }

        StateHasChanged();
    }

    private void VerifyAssessment(bool isCorrect)
    {
        isVerified = true;
        isAnswerSubmitted = true;
        totalAttempts++;

        if (isCorrect)
        {
            correctAnswers++;
            selectedAnswer = GetCorrectAnswer();
        }
        else
        {
            incorrectAnswers++;
            selectedAnswer = "";
        }

        StateHasChanged();
    }

    private async Task NextItem()
    {
        // Для review-words завжди видаляємо з pending (оцінено або ні)
        if (currentTestType == "review-words")
        {
            if (isRating) return; // Чекаємо поки оцінка завершиться

            if (currentItem != null)
            {
                // Завжди оновлюємо дату та кількість переглядів (навіть без оцінки)
                currentItem.LastReviewDate = DateTime.UtcNow;
                currentItem.ReviewCount++;
            }

            pendingItems.RemoveAt(currentIndex);
            isRated = false; // Скидаємо для наступного слова
        }
        else if (selectedAnswer == GetCorrectAnswer())
        {
            correctAnswers++;
            (CardType cardType, CardDirection cardDirection) = ParseTestType(currentTestType);
            currentItem.Tests[cardDirection][cardType].CorrectAnswers++;
            currentItem.Tests[cardDirection][cardType].TotalAttempts++;
            pendingItems.RemoveAt(currentIndex);
        }
        else
        {
            incorrectAnswers++;
            (CardType cardType, CardDirection cardDirection) = ParseTestType(currentTestType);
            currentItem.Tests[cardDirection][cardType].TotalAttempts++;
            // Incorrect answer - move to later position
            if (pendingItems.Count > 1)
            {
                var item = pendingItems[currentIndex];
                pendingItems.RemoveAt(currentIndex);
                
                int offset = random.Next(2, 5);
                int insertAt = Math.Min(currentIndex + offset, pendingItems.Count);
                pendingItems.Insert(insertAt, item);
            }
            else
            {
                pendingItems.RemoveAt(currentIndex);
            }
        }

        if (pendingItems.Any())
        {
            currentIndex = currentIndex % pendingItems.Count;
            LoadNextTestItem();
        }
        else
        {
            showStats = true;
        }

        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task RateWord(double rateValue)
    {
        if (currentItem == null || isRating) return;

        try
        {
            isRating = true;
            lastRatedValue = rateValue;
            StateHasChanged();

            // Оновлюємо тільки рейт (дата і лічильник оновляться в NextItem)
            currentItem.Rate = (float)rateValue;

            await BrowserConsole.LogInfoAsync($"Word '{currentItem.Word}' rated with {rateValue}");

            await Task.Delay(300);

            // Не переходимо автоматично - користувач натисне "Далі" сам
            isRated = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Помилка оцінки: {ex.Message}";
            Logger.LogError(ex, "Error rating word");
        }
        finally
        {
            isRating = false;
            StateHasChanged();
        }
    }

    private bool GetShowNextButton()
    {
        // Для review-words завжди показувати
        if (currentTestType == "review-words")
            return true;

        // Для know-or-not типів
        if (currentTestType.Contains("know-or-not"))
        {
            // Показувати тільки коли обрано "Не знаю"
            return isSelfAssessed && !isKnown;
        }

        // Для інших типів - стандартна логіка
        return isAnswerSubmitted;
    }

    private async Task FinishTest()
    {
        var wordsToUpdate = WordRatingCalculator.UpdateWordRate(items);
        await WordService.UpdateWordRateRangeAsync(mapper.Map<List<UpdateWordRateRequest>>(wordsToUpdate));
        DailyWordsService.ClearCache();
        await BrowserConsole.LogInfoAsync("Word rates updated.");
        NavigationManager.NavigateTo("/learning-words");
    }

    private void BackToMenu()
    {
        NavigationManager.NavigateTo("/learning-words");
    }

    // UI Helper Methods
    private string GetTestTitle()
    {
        return currentTestType switch
        {
            "review-words" => "Перегляд слів",
            "word-to-translation-single-choice" => "Переклад для слова",
            "word-to-translation-know-or-not" => "Перевірка перекладу",
            "translation-to-word-single-choice" => "Слово за перекладом",
            "translation-to-word-know-or-not" => "Перевірка слова",
            "translation-to-word-manual-input" => "Напишіть слово",
            _ => "Мульті-тест"
        };
    }

    private string GetHeaderClass()
    {
        if (currentTestType == "review-words")
        {
            return "pastel-blue";
        }
        
        var (type, direction) = ParseTestType(currentTestType);
        return WordLearningService.GetColorClass(type, direction);
    }

    private string GetIconClass()
    {
        if (currentTestType == "review-words")
        {
            return "bi-book";
        }
        
        var (type, direction) = ParseTestType(currentTestType);
        return WordLearningService.GetCardIcon(type, direction);
    }

    private (CardType type, CardDirection direction) ParseTestType(string testType)
    {
        return testType switch
        {
            "review-words" => (CardType.Review, CardDirection.WordToTranslation),
            "word-to-translation-single-choice" => (CardType.SingleChoice, CardDirection.WordToTranslation),
            "word-to-translation-know-or-not" => (CardType.KnowOrNot, CardDirection.WordToTranslation),
            "translation-to-word-single-choice" => (CardType.SingleChoice, CardDirection.TranslationToWord),
            "translation-to-word-know-or-not" => (CardType.KnowOrNot, CardDirection.TranslationToWord),
            "translation-to-word-manual-input" => (CardType.ManualInput, CardDirection.TranslationToWord),
            _ => (CardType.Review, CardDirection.WordToTranslation)
        };
    }
}

<style>
    .page-content {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .info-card-body {
        padding: 2rem;
        display: flex;
        flex-direction: row;
        align-items: stretch;
        gap: 2rem;
    }

    @@media (max-width: 768px) {
        .info-card-body {
            flex-direction: column;
            align-items: center;
            padding: 1.5rem;
            gap: 1.5rem;
        }

        .page-content {
            padding: 1rem 0.5rem;
        }
    }
</style>
