@page "/examples-learning"
@using EasyEnglish.App.Components.Shared
@inject NavigationManager NavigationManager

<div class="page-content">
    <PageHeader Title="Examples Learning" Description="Вчіть англійську через контекст реальних прикладів" />

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
            <p class="loading-text">Завантаження вправ...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-container">
            <div class="error-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <h3 class="error-title">Помилка завантаження</h3>
            <p class="error-message">@errorMessage</p>
        </div>
    }
    else
    {
        <div class="select-all-container">
            <InputCheckboxField Label="Вибрати всі" @bind-Value="selectAll" @bind-Value:after="SelectAllChange" />
        </div>
        
        <div class="exercises-grid">
            <IrregularFormsExerciseCard
                Title="Перегляд прикладів"
                Description="Читайте приклади з перекладом для розуміння контексту"
                Icon="bi-eye"
                Link="/review-examples"
                Color="blue"
                @bind-IsSelected="@ReviewExamples"
            />

            <IrregularFormsExerciseCard
                Title="Угадай слово"
                Description="Розкрийте приховане слово для перевірки розуміння"
                Icon="bi-search"
                Link="/review-examples-blurred"
                Color="purple"
                @bind-IsSelected="@ReviewExamplesBlurred"
            />

            <IrregularFormsExerciseCard
                Title="Введи слово"
                Description="Введіть правильне слово замість пропуску"
                Icon="bi-keyboard"
                Link="/input-examples"
                Color="green"
                @bind-IsSelected="@InputExamples"
            />
        </div>

        @if (AnySelected)
        {
            <div class="multi-test-section">
                <div class="multi-test-card">
                    <div class="multi-test-info">
                        <h3 class="multi-test-title">
                            <i class="bi bi-collection"></i>
                            Мульті-тест
                        </h3>
                        <p class="multi-test-description">
                            Обрано вправ: <strong>@SelectedCount</strong>
                        </p>
                    </div>
                    <button class="btn-multi-test" @onclick="StartMultiTest">
                        <i class="bi bi-play-fill"></i>
                        Почати мульті-тест
                    </button>
                </div>
            </div>
        }
    }
</div>

@code {
    private bool selectAll = false;

    private bool ReviewExamples = false;
    private bool ReviewExamplesBlurred = false;
    private bool InputExamples = false;

    private bool isLoading = false;
    private string? errorMessage;

    private bool AnySelected => ReviewExamples || ReviewExamplesBlurred || InputExamples;

    private int SelectedCount
    {
        get
        {
            int count = 0;
            if (ReviewExamples) count++;
            if (ReviewExamplesBlurred) count++;
            if (InputExamples) count++;
            return count;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            await Task.Delay(100);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading exercises: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void StartMultiTest()
    {
        var selectedTests = new List<string>();

        if (ReviewExamples) selectedTests.Add("review-examples");
        if (ReviewExamplesBlurred) selectedTests.Add("review-examples-blurred");
        if (InputExamples) selectedTests.Add("input-examples");

        var testsParam = string.Join(",", selectedTests);
        NavigationManager.NavigateTo($"/examples-multi-test?tests={testsParam}");
    }

    private async Task SelectAllChange()
    {
        bool isChecked = selectAll;
        ReviewExamples = isChecked;
        ReviewExamplesBlurred = isChecked;
        InputExamples = isChecked;
    }
}

<style>
    .page-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .select-all-container {
        margin-bottom: 1.5rem;
    }

    .exercises-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        gap: 1rem;
    }

    .spinner {
        color: #A3BFFA;
    }

    .loading-text {
        color: #666;
        font-size: 1rem;
        margin: 0;
    }

    .error-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        background: #fff5f5;
        border: 1px solid #feb2b2;
        border-radius: 12px;
        gap: 1rem;
    }

    .error-icon {
        width: 64px;
        height: 64px;
        background: #fed7d7;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .error-icon i {
        font-size: 2rem;
        color: #dc3545;
    }

    .error-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #333;
        margin: 0;
    }

    .error-message {
        color: #666;
        margin: 0;
        text-align: center;
    }

    .multi-test-section {
        position: sticky;
        bottom: 2rem;
        z-index: 10;
        animation: slideUp 0.3s ease-out;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .multi-test-card {
        background: linear-gradient(135deg, #A3BFFA, #B5EAD7);
        border-radius: 16px;
        padding: 1.5rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
        box-shadow: 0 8px 24px rgba(163, 191, 250, 0.4);
    }

    .multi-test-info {
        flex: 1;
    }

    .multi-test-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a202c;
        margin: 0 0 0.25rem 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .multi-test-description {
        color: #2d3748;
        font-size: 1rem;
        margin: 0;
    }

    .btn-multi-test {
        background: white;
        color: #667EEA;
        border: none;
        border-radius: 12px;
        padding: 0.875rem 2rem;
        font-size: 1.125rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        white-space: nowrap;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .btn-multi-test:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        background: #f8f9fa;
    }

    .btn-multi-test:active {
        transform: translateY(0);
    }

    .btn-multi-test i {
        font-size: 1.25rem;
    }

    @@media (max-width: 1024px) {
        .exercises-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .page-content {
            padding: 1.5rem 1rem;
        }

        .exercises-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .multi-test-card {
            flex-direction: column;
            align-items: stretch;
            gap: 1rem;
            padding: 1.25rem 1.5rem;
        }

        .multi-test-title {
            font-size: 1.25rem;
        }

        .multi-test-description {
            font-size: 0.875rem;
        }

        .btn-multi-test {
            width: 100%;
            justify-content: center;
            font-size: 1rem;
            padding: 0.75rem 1.5rem;
        }
    }
</style>
