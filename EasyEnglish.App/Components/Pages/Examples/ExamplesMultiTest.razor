@page "/examples-multi-test"
@using EasyEnglish.App.Components.Shared
@using EasyEnglish.App.Models
@using EasyEnglish.App.Components.Pages.Learning.Shared
@using EasyEnglish.App.Services
@inject NavigationManager NavigationManager
@inject IBrowserConsoleService BrowserConsole
@inject ILogger<ExamplesMultiTest> Logger

<div class="page-content">
    <PageHeader Title="Мульті-тест прикладів" />

    <LearningCard 
        Title="@GetTestTitle()"
        HeaderClass="@GetHeaderClass()"
        IconClass="@GetIconClass()"
        Rate="@(currentItem?.Word?.Rate ?? 0)"
        TotalCount="@totalItems"
        CompletedCount="@completed"
        IsLoading="@isLoading"
        ErrorMessage="@errorMessage"
        ShowStats="@showStats"
        CompletedWords="@completed"
        TotalAttempts="@totalAttempts"
        CorrectAnswers="@correctAnswers"
        IncorrectAnswers="@incorrectAnswers"
        ShowNextButton="@GetShowNextButton()"
        OnNextCard="@NextItem"
        OnFinish="@FinishTest">

        <ChildContent>
            @if (currentItem != null && !string.IsNullOrEmpty(currentTestType))
            {
                <!-- Word Badge -->
                @if (currentTestType != "review-examples" || isRated)
                {
                    <div class="word-badge-container">
                        <div class="word-badge">
                            <span class="word-text">@currentItem.Word?.Word</span>
                            @if (!string.IsNullOrEmpty(currentItem.Word?.Transcription))
                            {
                                <span class="word-transcription">[@currentItem.Word.Transcription]</span>
                            }
                        </div>
                    </div>
                }

                <!-- Review Examples - Простий перегляд -->
                @if (currentTestType == "review-examples")
                {
                    <div class="example-container">
                        <!-- English Sentence -->
                        <div class="sentence-section english">
                            <div class="language-label">
                                <i class="bi bi-translate"></i>
                                English
                            </div>
                            <div class="sentence-text">
                                @((MarkupString)ExampleMarkdownService.RenderMarkdownWithHidden(currentItem.Sentence, showHidden: true))
                            </div>
                        </div>

                        <!-- Translation -->
                        @if (!string.IsNullOrEmpty(currentItem.Translation))
                        {
                            <div class="sentence-section translation">
                                <div class="language-label">
                                    <i class="bi bi-arrow-return-right"></i>
                                    Переклад
                                </div>
                                <div class="sentence-text">
                                    @currentItem.Translation
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Rating Section -->
                    <DifficultyRatingSection 
                        OnRate="@RateExample"
                        IsRating="@isRating"
                        LastRatedValue="@lastRatedValue" />
                }

                <!-- Review Examples Blurred - Розмитий текст -->
                @if (currentTestType == "review-examples-blurred")
                {
                    @if (!isRevealed)
                    {
                        <div class="hint-container">
                            <div class="hint-badge">
                                <i class="bi bi-lightbulb"></i>
                                <span>Натисніть на розмитий текст</span>
                            </div>
                        </div>
                    }

                    <div class="example-container">
                        <!-- English Sentence with Blurred Part -->
                        <div class="sentence-section english">
                            <div class="language-label">
                                <i class="bi bi-translate"></i>
                                English
                            </div>
                            <div class="sentence-text">
                                @if (parsedSentence.beforeHidden != "")
                                {
                                    @((MarkupString)ExampleMarkdownService.RenderMarkdown(parsedSentence.beforeHidden))
                                    <span class="hidden-word @(isRevealed ? "revealed" : "blurred")" 
                                          @onclick="RevealHiddenText">
                                        @parsedSentence.hiddenText
                                    </span>
                                    @((MarkupString)ExampleMarkdownService.RenderMarkdown(parsedSentence.afterHidden))
                                }
                                else
                                {
                                    @((MarkupString)ExampleMarkdownService.RenderMarkdown(currentItem.Sentence))
                                }
                            </div>
                        </div>

                        <!-- Translation -->
                        @if (isRevealed && !string.IsNullOrEmpty(currentItem.Translation))
                        {
                            <div class="sentence-section translation fade-in">
                                <div class="language-label">
                                    <i class="bi bi-arrow-return-right"></i>
                                    Переклад
                                </div>
                                <div class="sentence-text">
                                    @currentItem.Translation
                                </div>
                            </div>
                        }
                    </div>

                    @if (isRevealed)
                    {
                        <DifficultyRatingSection 
                            OnRate="@RateExample"
                            IsRating="@isRating"
                            LastRatedValue="@lastRatedValue" />
                    }
                }

                <!-- Input Examples - Введення слова -->
                @if (currentTestType == "input-examples")
                {
                    @if (!isAnswerSubmitted)
                    {
                        <div class="hint-container">
                            <div class="hint-badge">
                                <i class="bi bi-pencil"></i>
                                <span>Введіть правильне слово</span>
                            </div>
                        </div>
                    }

                    <div class="example-container">
                        <!-- English Sentence with Input -->
                        <div class="sentence-section english">
                            <div class="language-label">
                                <i class="bi bi-translate"></i>
                                English
                            </div>
                            <div class="sentence-text">
                                @if (parsedSentence.beforeHidden != "")
                                {
                                    @((MarkupString)ExampleMarkdownService.RenderMarkdown(parsedSentence.beforeHidden))
                                    
                                    @if (!isAnswerSubmitted)
                                    {
                                        <input type="text" 
                                               class="word-input" 
                                               @bind="userAnswer" 
                                               @bind:event="oninput"
                                               placeholder="..."
                                               @onkeydown="@HandleKeyDown"
                                               autofocus />
                                    }
                                    else
                                    {
                                        <span class="answer-display @GetAnswerClass()">
                                            @(isCorrect ? userAnswer : parsedSentence.hiddenText)
                                        </span>
                                    }
                                    
                                    @((MarkupString)ExampleMarkdownService.RenderMarkdown(parsedSentence.afterHidden))
                                }
                                else
                                {
                                    @((MarkupString)ExampleMarkdownService.RenderMarkdown(currentItem.Sentence))
                                }
                            </div>
                        </div>

                        <!-- Submit Button -->
                        @if (!isAnswerSubmitted && parsedSentence.hiddenText != "")
                        {
                            <div class="submit-container">
                                <button class="btn-submit" 
                                        @onclick="CheckAnswer" 
                                        disabled="@string.IsNullOrWhiteSpace(userAnswer)">
                                    <i class="bi bi-check-circle"></i>
                                    Перевірити
                                </button>
                            </div>
                        }

                        <!-- Result Display -->
                        @if (isAnswerSubmitted)
                        {
                            <div class="result-container @GetResultContainerClass()">
                                <div class="result-header">
                                    <div class="result-icon">
                                        @if (isCorrect)
                                        {
                                            <i class="bi bi-check-circle-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x-circle-fill"></i>
                                        }
                                    </div>
                                    <div class="result-message">
                                        @(isCorrect ? "Правильно!" : "Не зовсім")
                                    </div>
                                </div>
                                
                                @if (!isCorrect)
                                {
                                    <div class="result-details">
                                        <div class="user-answer-display">
                                            Ваша відповідь: <strong>@userAnswer</strong>
                                        </div>
                                        <div class="correct-answer-display">
                                            Правильна відповідь: <strong>@parsedSentence.hiddenText</strong>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Translation -->
                        @if (isAnswerSubmitted && !string.IsNullOrEmpty(currentItem.Translation))
                        {
                            <div class="sentence-section translation fade-in">
                                <div class="language-label">
                                    <i class="bi bi-arrow-return-right"></i>
                                    Переклад
                                </div>
                                <div class="sentence-text">
                                    @currentItem.Translation
                                </div>
                            </div>
                        }
                    </div>

                    @if (isAnswerSubmitted)
                    {
                        <DifficultyRatingSection 
                            OnRate="@RateExample"
                            IsRating="@isRating"
                            LastRatedValue="@lastRatedValue" />
                    }
                }
            }
        </ChildContent>
    </LearningCard>
</div>

@code {
    // Test configuration
    private List<string> selectedTests = new();
    private string currentTestType = "";
    private int currentTestIndex = 0;

    // Data
    private List<ExampleModel> items = new();
    private List<(ExampleModel example, string testType)> pendingItems = new();
    private ExampleModel? currentItem;
    private (string beforeHidden, string hiddenText, string afterHidden) parsedSentence;

    // User Input
    private string userAnswer = "";

    // State
    private int currentIndex = 0;
    private bool isLoading = false;
    private string? errorMessage;
    private bool isAnswerSubmitted = false;
    private bool isRevealed = false;
    private bool isCorrect = false;
    private bool showStats = false;
    private bool isRating = false;
    private double lastRatedValue = 0;
    private bool isRated = false;

    // Statistics
    private int totalItems = 0;
    private int correctAnswers = 0;
    private int incorrectAnswers = 0;
    private int totalAttempts = 0;
    private int completed => totalItems - pendingItems.Count;

    private Random random = new Random();

    protected override async Task OnInitializedAsync()
    {
        ParseQueryParameters();
        await LoadData();
    }

    private void ParseQueryParameters()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = uri.Query;

        if (!string.IsNullOrEmpty(query))
        {
            var queryParams = query.TrimStart('?')
                .Split('&')
                .Select(param => param.Split('='))
                .Where(parts => parts.Length == 2)
                .ToDictionary(parts => parts[0], parts => Uri.UnescapeDataString(parts[1]));

            if (queryParams.TryGetValue("tests", out var testsValue))
            {
                selectedTests = testsValue.Split(',').ToList();
            }
        }
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            // TODO: Завантажити приклади з сервісу
            // items = await ExampleService.GetAllAsync();
            
            // Тимчасові дані для тестування
            items = new List<ExampleModel>
            {
                new ExampleModel 
                { 
                    Id = 1,
                    Sentence = "I ***go*** to school every day.",
                    Translation = "Я ходжу до школи щодня.",
                    WordId = 1,
                    Word = new WordModel 
                    { 
                        Word = "go", 
                        Transcription = "ɡəʊ",
                        Translation = "йти, ходити",
                        Rate = 3
                    }
                },
                new ExampleModel 
                { 
                    Id = 2,
                    Sentence = "She **likes** to ***read*** books in the library.",
                    Translation = "Вона любить читати книги в бібліотеці.",
                    WordId = 2,
                    Word = new WordModel 
                    { 
                        Word = "read", 
                        Transcription = "riːd",
                        Translation = "читати",
                        Rate = 3
                    }
                },
                new ExampleModel 
                { 
                    Id = 3,
                    Sentence = "We ***study*** English at school.",
                    Translation = "Ми вивчаємо англійську в школі.",
                    WordId = 3,
                    Word = new WordModel 
                    { 
                        Word = "study", 
                        Transcription = "ˈstʌdi",
                        Translation = "вивчати",
                        Rate = 3
                    }
                }
            };

            // Фільтрація прикладів для різних типів тестів
            var filteredItems = items.ToList();
            
            // Для blurred та input потрібні тільки приклади з прихованим текстом
            if (selectedTests.Contains("review-examples-blurred") || selectedTests.Contains("input-examples"))
            {
                filteredItems = items.Where(e => ExampleMarkdownService.HasHiddenText(e.Sentence)).ToList();
            }

            // Create test items for each selected test type
            foreach (var example in filteredItems)
            {
                foreach (var testType in selectedTests)
                {
                    // Пропускаємо приклади без прихованого тексту для blurred та input
                    if ((testType == "review-examples-blurred" || testType == "input-examples") 
                        && !ExampleMarkdownService.HasHiddenText(example.Sentence))
                    {
                        continue;
                    }

                    pendingItems.Add((example, testType));
                }
            }

            // Shuffle the pending items
            pendingItems = pendingItems
                .OrderBy(x => Guid.NewGuid())
                .ToList();
            
            totalItems = pendingItems.Count;

            if (pendingItems.Any())
            {
                LoadNextTestItem();
            }
            else
            {
                errorMessage = "Немає прикладів для вибраних типів тестів";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Помилка завантаження: {ex.Message}";
            Logger.LogError(ex, "Error loading examples for multi-test");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void LoadNextTestItem()
    {
        if (!pendingItems.Any()) return;

        var (example, testType) = pendingItems[currentIndex];
        currentItem = example;
        currentTestType = testType;

        // Reset state
        isAnswerSubmitted = false;
        isRevealed = false;
        isCorrect = false;
        userAnswer = "";
        isRated = false;
        lastRatedValue = 0;

        // Parse hidden text for blurred and input tests
        if (testType == "review-examples-blurred" || testType == "input-examples")
        {
            parsedSentence = ExampleMarkdownService.ParseHiddenText(example.Sentence);
        }

        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(userAnswer) && !isAnswerSubmitted)
        {
            CheckAnswer();
        }
    }

    private void CheckAnswer()
    {
        if (string.IsNullOrWhiteSpace(userAnswer)) return;

        totalAttempts++;
        isCorrect = ExampleMarkdownService.CheckAnswer(userAnswer, parsedSentence.hiddenText);
        
        if (isCorrect)
        {
            correctAnswers++;
        }
        else
        {
            incorrectAnswers++;
        }

        isAnswerSubmitted = true;
        StateHasChanged();
    }

    private void RevealHiddenText()
    {
        if (!isRevealed)
        {
            isRevealed = true;
            totalAttempts++;
            StateHasChanged();
        }
    }

    private async Task RateExample(double rating)
    {
        if (currentItem == null || isRating) return;

        try
        {
            isRating = true;
            lastRatedValue = rating;
            StateHasChanged();

            // TODO: Зберегти оцінку
            // await WordService.UpdateRateAsync(currentItem.WordId, rating);
            if (currentItem.Word != null)
            {
                currentItem.Word.Rate = (float)rating;
            }

            await BrowserConsole.LogInfoAsync($"Example rated with {rating}");
            await Task.Delay(300);

            isRated = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Помилка оцінки: {ex.Message}";
            Logger.LogError(ex, "Error rating example");
        }
        finally
        {
            isRating = false;
            StateHasChanged();
        }
    }

    private async Task NextItem()
    {
        // Для review-examples завжди видаляємо з pending (оцінено або ні)
        if (currentTestType == "review-examples")
        {
            if (isRating) return;
            pendingItems.RemoveAt(currentIndex);
            isRated = false;
        }
        // Для review-examples-blurred видаляємо після розкриття
        else if (currentTestType == "review-examples-blurred")
        {
            if (isRating) return;
            pendingItems.RemoveAt(currentIndex);
            isRated = false;
        }
        // Для input-examples обробляємо результат
        else if (currentTestType == "input-examples")
        {
            if (isRating) return;
            
            if (isCorrect)
            {
                // Правильна відповідь - видаляємо
                pendingItems.RemoveAt(currentIndex);
            }
            else
            {
                // Неправильна відповідь - переміщуємо далі
                if (pendingItems.Count > 1)
                {
                    var item = pendingItems[currentIndex];
                    pendingItems.RemoveAt(currentIndex);
                    
                    int offset = random.Next(2, 5);
                    int insertAt = Math.Min(currentIndex + offset, pendingItems.Count);
                    pendingItems.Insert(insertAt, item);
                }
                else
                {
                    pendingItems.RemoveAt(currentIndex);
                }
            }
        }

        if (pendingItems.Any())
        {
            currentIndex = currentIndex % pendingItems.Count;
            LoadNextTestItem();
        }
        else
        {
            showStats = true;
        }

        StateHasChanged();
        await Task.CompletedTask;
    }

    private void FinishTest()
    {
        NavigationManager.NavigateTo("/examples-learning");
    }

    private bool GetShowNextButton()
    {
        return currentTestType switch
        {
            "review-examples" => true,
            "review-examples-blurred" => isRevealed,
            "input-examples" => isAnswerSubmitted,
            _ => false
        };
    }

    private string GetTestTitle()
    {
        return currentTestType switch
        {
            "review-examples" => "Перегляд прикладів",
            "review-examples-blurred" => "Угадай слово",
            "input-examples" => "Введи слово",
            _ => "Мульті-тест прикладів"
        };
    }

    private string GetHeaderClass()
    {
        return currentTestType switch
        {
            "review-examples" => "pastel-blue",
            "review-examples-blurred" => "pastel-purple",
            "input-examples" => "pastel-green",
            _ => "pastel-blue"
        };
    }

    private string GetIconClass()
    {
        return currentTestType switch
        {
            "review-examples" => "bi-eye",
            "review-examples-blurred" => "bi-search",
            "input-examples" => "bi-keyboard",
            _ => "bi-collection"
        };
    }

    private string GetAnswerClass()
    {
        return isCorrect ? "correct" : "incorrect";
    }

    private string GetResultContainerClass()
    {
        return isCorrect ? "correct-result" : "incorrect-result";
    }
}

<style>
    .page-content {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    /* Word Badge */
    .word-badge-container {
        display: flex;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .word-badge {
        background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
        padding: 0.75rem 1.5rem;
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
    }

    .word-text {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1976D2;
    }

    .word-transcription {
        font-size: 0.875rem;
        font-style: italic;
        color: #1976D2;
        opacity: 0.8;
    }

    /* Hint */
    .hint-container {
        display: flex;
        justify-content: center;
        margin-bottom: 1.5rem;
    }

    .hint-badge {
        background: linear-gradient(135deg, #F3E5F5, #E1BEE7);
        padding: 0.75rem 1.5rem;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #7B1FA2;
        font-weight: 600;
        font-size: 0.9375rem;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }

    /* Example Container */
    .example-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .sentence-section {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 1.5rem;
    }

    .sentence-section.english {
        background: linear-gradient(135deg, #F5F7FA, #E8EAF6);
        border-left: 4px solid #5E35B1;
    }

    .sentence-section.translation {
        background: linear-gradient(135deg, #F1F8E9, #DCEDC8);
        border-left: 4px solid #7CB342;
    }

    .language-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #666;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .sentence-text {
        font-size: 1.25rem;
        line-height: 1.8;
        color: #333;
    }

    /* Hidden Word */
    .hidden-word {
        display: inline-block;
        padding: 0.125rem 0.5rem;
        border-radius: 6px;
        transition: all 0.3s ease;
        cursor: pointer;
        position: relative;
    }

    .hidden-word.blurred {
        background: #E0E0E0;
        color: transparent;
        text-shadow: 0 0 8px rgba(0, 0, 0, 0.5);
        user-select: none;
    }

    .hidden-word.blurred:hover {
        background: #D0D0D0;
        transform: scale(1.05);
    }

    .hidden-word.blurred::before {
        content: "?";
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        color: #666;
        font-weight: 700;
        font-size: 1.25rem;
    }

    .hidden-word.revealed {
        background: linear-gradient(135deg, #FFE082, #FFD54F);
        color: #F57C00;
        font-weight: 700;
        animation: reveal 0.5s ease;
    }

    @@keyframes reveal {
        0% { transform: scale(0.8); opacity: 0; }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); opacity: 1; }
    }

    /* Input */
    .word-input {
        display: inline-block;
        min-width: 120px;
        padding: 0.25rem 0.75rem;
        font-size: 1.25rem;
        border: 2px dashed #66BB6A;
        border-radius: 6px;
        background: white;
        outline: none;
        transition: all 0.2s;
    }

    .word-input:focus {
        border-style: solid;
        border-color: #4CAF50;
        box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.1);
    }

    .answer-display {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 6px;
        font-weight: 700;
    }

    .answer-display.correct {
        background: linear-gradient(135deg, #A5D6A7, #81C784);
        color: #2E7D32;
    }

    .answer-display.incorrect {
        background: linear-gradient(135deg, #EF9A9A, #E57373);
        color: #C62828;
    }

    /* Submit Button */
    .submit-container {
        display: flex;
        justify-content: center;
    }

    .btn-submit {
        background: linear-gradient(135deg, #66BB6A, #4CAF50);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 0.875rem 2rem;
        font-size: 1.125rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-submit:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(102, 187, 106, 0.3);
    }

    .btn-submit:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* Result Container */
    .result-container {
        border-radius: 12px;
        padding: 1.5rem;
        border: 2px solid;
        animation: slideIn 0.3s ease;
    }

    .result-container.correct-result {
        background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
        border-color: #66BB6A;
    }

    .result-container.incorrect-result {
        background: linear-gradient(135deg, #FFEBEE, #FFCDD2);
        border-color: #EF5350;
    }

    .result-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .result-icon {
        font-size: 2rem;
    }

    .correct-result .result-icon {
        color: #4CAF50;
    }

    .incorrect-result .result-icon {
        color: #F44336;
    }

    .result-message {
        font-size: 1.5rem;
        font-weight: 700;
        color: #333;
    }

    .result-details {
