@page "/input-examples"
@using EasyEnglish.App.Components.Shared
@using EasyEnglish.App.Models
@using EasyEnglish.App.Components.Pages.Learning.Shared
@using EasyEnglish.App.Services
@inject NavigationManager NavigationManager
@inject IBrowserConsoleService BrowserConsole

<div class="page-content">
    <PageHeader Title="Введи слово" />

    <LearningCard 
        Title="Введи слово"
        HeaderClass="pastel-green"
        IconClass="bi-keyboard"
        TotalCount="@totalItems"
        CompletedCount="@completed"
        IsLoading="@isLoading"
        ErrorMessage="@errorMessage"
        ShowStats="@showStats"
        CompletedWords="@completed"
        TotalAttempts="@totalAttempts"
        CorrectAnswers="@correctAnswers"
        IncorrectAnswers="@incorrectAnswers"
        ShowNextButton="@isAnswerSubmitted"
        OnNextCard="@NextItem"
        OnFinish="@FinishTest">

        <ChildContent>
            @if (currentItem != null)
            {
                <!-- Hint Badge (показується до перевірки) -->
                @if (!isAnswerSubmitted)
                {
                    <div class="hint-container">
                        <div class="hint-badge">
                            <i class="bi bi-pencil"></i>
                            <span>Введіть правильне слово замість пропуску</span>
                        </div>
                    </div>
                }

                <!-- Example Display -->
                <div class="example-container">
                    <!-- English Sentence with Input -->
                    <div class="sentence-section english">
                        <div class="language-label">
                            <i class="bi bi-translate"></i>
                            English
                        </div>
                        <div class="sentence-text">
                            @if (parsedSentence.beforeHidden != "")
                            {
                                @((MarkupString)ExampleMarkdownService.RenderMarkdown(parsedSentence.beforeHidden))
                                
                                @if (!isAnswerSubmitted)
                                {
                                    <input type="text" 
                                           class="word-input" 
                                           @bind="userAnswer" 
                                           @bind:event="oninput"
                                           placeholder="..."
                                           @onkeydown="@HandleKeyDown"
                                           autofocus />
                                }
                                else
                                {
                                    <span class="answer-display @GetAnswerClass()">
                                        @(isCorrect ? userAnswer : parsedSentence.hiddenText)
                                    </span>
                                }
                                
                                @((MarkupString)ExampleMarkdownService.RenderMarkdown(parsedSentence.afterHidden))
                            }
                            else
                            {
                                @((MarkupString)ExampleMarkdownService.RenderMarkdown(currentItem.Sentence))
                            }
                        </div>
                    </div>

                    <!-- Submit Button (показується до перевірки) -->
                    @if (!isAnswerSubmitted && parsedSentence.hiddenText != "")
                    {
                        <div class="submit-container">
                            <button class="btn-submit" 
                                    @onclick="CheckAnswer" 
                                    disabled="@string.IsNullOrWhiteSpace(userAnswer)">
                                <i class="bi bi-check-circle"></i>
                                Перевірити
                            </button>
                        </div>
                    }

                    <!-- Result Display (показується після перевірки) -->
                    @if (isAnswerSubmitted)
                    {
                        <div class="result-container @GetResultContainerClass()">
                            <div class="result-header">
                                <div class="result-icon">
                                    @if (isCorrect)
                                    {
                                        <i class="bi bi-check-circle-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill"></i>
                                    }
                                </div>
                                <div class="result-message">
                                    @(isCorrect ? "Правильно!" : "Не зовсім")
                                </div>
                            </div>
                            
                            @if (!isCorrect)
                            {
                                <div class="result-details">
                                    <div class="user-answer-display">
                                        Ваша відповідь: <strong>@userAnswer</strong>
                                    </div>
                                    <div class="correct-answer-display">
                                        Правильна відповідь: <strong>@parsedSentence.hiddenText</strong>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Translation (показується після перевірки) -->
                    @if (isAnswerSubmitted && !string.IsNullOrEmpty(currentItem.Translation))
                    {
                        <div class="sentence-section translation fade-in">
                            <div class="language-label">
                                <i class="bi bi-arrow-return-right"></i>
                                Переклад
                            </div>
                            <div class="sentence-text">
                                @currentItem.Translation
                            </div>
                        </div>
                    }
                </div>
            }
        </ChildContent>
    </LearningCard>
</div>

@code {
    // Data
    private List<ExampleModel> items = new();
    private ExampleModel? currentItem;
    private int currentIndex = 0;
    private (string beforeHidden, string hiddenText, string afterHidden) parsedSentence;

    // User Input
    private string userAnswer = "";

    // State
    private bool isLoading = false;
    private string? errorMessage;
    private bool showStats = false;
    private bool isRating = false;
    private double lastRatedValue = 0;
    private bool isAnswerSubmitted = false;
    private bool isCorrect = false;

    // Statistics
    private int totalItems = 0;
    private int totalAttempts = 0;
    private int correctAnswers = 0;
    private int incorrectAnswers = 0;
    private int completed => currentIndex;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            // TODO: Завантажити приклади з сервісу
            // items = await ExampleService.GetAllWithHiddenTextAsync();
            
            // Тимчасові дані для тестування
            items = new List<ExampleModel>
            {
                new ExampleModel 
                { 
                    Id = 1,
                    Sentence = "I ***go*** to school every day.",
                    Translation = "Я ходжу до школи щодня.",
                    WordId = 1,
                },
                new ExampleModel 
                { 
                    Id = 2,
                    Sentence = "She **likes** to ***read*** books in the library.",
                    Translation = "Вона любить читати книги в бібліотеці.",
                    WordId = 2,
                }
            };

            totalItems = items.Count;
            
            if (items.Any())
            {
                currentItem = items[currentIndex];
                parsedSentence = ExampleMarkdownService.ParseHiddenText(currentItem.Sentence);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            BrowserConsole.LogErrorAsync("Error loading examples", ex);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(userAnswer) && !isAnswerSubmitted)
        {
            CheckAnswer();
        }
    }

    private void CheckAnswer()
    {
        if (string.IsNullOrWhiteSpace(userAnswer)) return;

        totalAttempts++;
        isCorrect = ExampleMarkdownService.CheckAnswer(userAnswer, parsedSentence.hiddenText);
        
        if (isCorrect)
        {
            correctAnswers++;
        }
        else
        {
            incorrectAnswers++;
        }

        isAnswerSubmitted = true;
        StateHasChanged();
    }

    private async Task RateExample(double rating)
    {
        if (currentItem == null) return;

        try
        {
            isRating = true;
            lastRatedValue = rating;

            // TODO: Зберегти оцінку
            // await WordService.UpdateRateAsync(currentItem.WordId, rating);

            await Task.Delay(300);
        }
        catch (Exception ex)
        {
            BrowserConsole.LogErrorAsync("Error rating example", ex);
        }
        finally
        {
            isRating = false;
            StateHasChanged();
        }
    }

    private async Task NextItem()
    {
        currentIndex++;
        lastRatedValue = 0;
        isAnswerSubmitted = false;
        isCorrect = false;
        userAnswer = "";

        if (currentIndex >= totalItems)
        {
            showStats = true;
        }
        else
        {
            currentItem = items[currentIndex];
            parsedSentence = ExampleMarkdownService.ParseHiddenText(currentItem.Sentence);
        }

        StateHasChanged();
    }

    private void FinishTest()
    {
        NavigationManager.NavigateTo("/examples-learning");
    }

    private string GetAnswerClass()
    {
        return isCorrect ? "correct" : "incorrect";
    }

    private string GetResultContainerClass()
    {
        return isCorrect ? "correct-result" : "incorrect-result";
    }
}

<style>
    .page-content {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .hint-container {
        display: flex;
        justify-content: center;
        margin-bottom: 1.5rem;
    }

    .hint-badge {
        background: linear-gradient(135deg, #E8F5E9, #C5E1A5);
        padding: 0.75rem 1.5rem;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #558B2F;
        font-weight: 600;
        font-size: 0.9375rem;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.05);
        }
    }

    .hint-badge i {
        font-size: 1.125rem;
    }

    .example-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .sentence-section {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 1.5rem;
    }

    .sentence-section.english {
        background: linear-gradient(135deg, #F5F7FA, #E8EAF6);
        border-left: 4px solid #66BB6A;
    }

    .sentence-section.translation {
        background: linear-gradient(135deg, #F1F8E9, #DCEDC8);
        border-left: 4px solid #7CB342;
    }

    .language-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #666;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .sentence-text {
        font-size: 1.25rem;
        line-height: 1.8;
        color: #333;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.25rem;
    }

    /* Input Styles */
    .word-input {
        display: inline-block;
        min-width: 120px;
        padding: 0.25rem 0.75rem;
        font-size: 1.25rem;
        border: 2px dashed #66BB6A;
        border-radius: 6px;
        background: white;
        outline: none;
        transition: all 0.2s;
    }

    .word-input:focus {
        border-style: solid;
        border-color: #4CAF50;
        box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.1);
    }

    /* Answer Display */
    .answer-display {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 6px;
        font-weight: 700;
    }

    .answer-display.correct {
        background: linear-gradient(135deg, #A5D6A7, #81C784);
        color: #2E7D32;
    }

    .answer-display.incorrect {
        background: linear-gradient(135deg, #EF9A9A, #E57373);
        color: #C62828;
    }

    /* Submit Button */
    .submit-container {
        display: flex;
        justify-content: center;
    }

    .btn-submit {
        background: linear-gradient(135deg, #66BB6A, #4CAF50);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 0.875rem 2rem;
        font-size: 1.125rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-submit:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(102, 187, 106, 0.3);
    }

    .btn-submit:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* Result Container */
    .result-container {
        border-radius: 12px;
        padding: 1.5rem;
        border: 2px solid;
        animation: slideIn 0.3s ease;
    }

    .result-container.correct-result {
        background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
        border-color: #66BB6A;
    }

    .result-container.incorrect-result {
        background: linear-gradient(135deg, #FFEBEE, #FFCDD2);
        border-color: #EF5350;
    }

    .result-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .result-icon {
        font-size: 2rem;
    }

    .correct-result .result-icon {
        color: #4CAF50;
    }

    .incorrect-result .result-icon {
        color: #F44336;
    }

    .result-message {
        font-size: 1.5rem;
        font-weight: 700;
        color: #333;
    }

    .result-details {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
    }

    .user-answer-display,
    .correct-answer-display {
        font-size: 1rem;
        color: #666;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* Markdown styles */
    .sentence-text :deep(strong) {
        color: #1976D2;
        font-weight: 700;
    }

    .sentence-text :deep(em) {
        color: #7B1FA2;
        font-style: italic;
    }

    .sentence-text :deep(code) {
        background: #FFF9C4;
        padding: 0.125rem 0.375rem;
        border-radius: 4px;
        font-family: 'Courier New', monospace;
        font-size: 1.1rem;
    }

    /* Word Info Section */
    .word-info-section {
        margin-bottom: 2rem;
    }

    .word-card {
        background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
    }

    .word-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .word-main {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1976D2;
    }

    .word-transcription {
        font-size: 1rem;
        font-style: italic;
        color: #1976D2;
        opacity: 0.8;
    }

    .word-translation {
        font-size: 1.125rem;
        color: #333;
    }

    /* Fade in animation */
    .fade-in {
        animation: fadeIn 0.5s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .sentence-text {
            font-size: 1.125rem;
        }

        .word-input {
            font-size: 1.125rem;
            min-width: 100px;
        }

        .word-main {
            font-size: 1.5rem;
        }

        .hint-badge {
            font-size: 0.875rem;
            padding: 0.625rem 1.25rem;
        }

        .result-message {
            font-size: 1.25rem;
        }
    }
</style>
