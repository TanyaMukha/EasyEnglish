@page "/review-examples-blurred"
@using EasyEnglish.App.Components.Shared
@using EasyEnglish.App.Models
@using EasyEnglish.App.Components.Pages.Learning.Shared
@using EasyEnglish.App.Services
@inject NavigationManager NavigationManager
@inject IBrowserConsoleService BrowserConsole

<div class="page-content">
    <PageHeader Title="Угадай слово" />

    <LearningCard 
        Title="Угадай слово"
        HeaderClass="pastel-purple"
        IconClass="bi-search"
        TotalCount="@totalItems"
        CompletedCount="@completed"
        IsLoading="@isLoading"
        ErrorMessage="@errorMessage"
        ShowStats="@showStats"
        CompletedWords="@completed"
        TotalAttempts="@totalAttempts"
        CorrectAnswers="@correctAnswers"
        IncorrectAnswers="@incorrectAnswers"
        ShowNextButton="@isRevealed"
        OnNextCard="@NextItem"
        OnFinish="@FinishTest">

        <ChildContent>
            @if (currentItem != null)
            {
                <!-- Hint Badge (показується до розкриття) -->
                @if (!isRevealed)
                {
                    <div class="hint-container">
                        <div class="hint-badge">
                            <i class="bi bi-lightbulb"></i>
                            <span>Натисніть на розмитий текст, щоб побачити слово</span>
                        </div>
                    </div>
                }

                <!-- Example Display -->
                <div class="example-container">
                    <!-- English Sentence with Blurred Part -->
                    <div class="sentence-section english">
                        <div class="language-label">
                            <i class="bi bi-translate"></i>
                            English
                        </div>
                        <div class="sentence-text">
                            @if (parsedSentence.beforeHidden != "")
                            {
                                @((MarkupString)ExampleMarkdownService.RenderMarkdown(parsedSentence.beforeHidden))
                                <span class="hidden-word @(isRevealed ? "revealed" : "blurred")" 
                                      @onclick="RevealHiddenText">
                                    @parsedSentence.hiddenText
                                </span>
                                @((MarkupString)ExampleMarkdownService.RenderMarkdown(parsedSentence.afterHidden))
                            }
                            else
                            {
                                @((MarkupString)ExampleMarkdownService.RenderMarkdown(currentItem.Sentence))
                            }
                        </div>
                    </div>

                    <!-- Translation (показується після розкриття) -->
                    @if (isRevealed && !string.IsNullOrEmpty(currentItem.Translation))
                    {
                        <div class="sentence-section translation fade-in">
                            <div class="language-label">
                                <i class="bi bi-arrow-return-right"></i>
                                Переклад
                            </div>
                            <div class="sentence-text">
                                @currentItem.Translation
                            </div>
                        </div>
                    }
                </div>
            }
        </ChildContent>
    </LearningCard>
</div>

@code {
    // Data
    private List<ExampleModel> items = new();
    private ExampleModel? currentItem;
    private int currentIndex = 0;
    private (string beforeHidden, string hiddenText, string afterHidden) parsedSentence;

    // State
    private bool isLoading = false;
    private string? errorMessage;
    private bool showStats = false;
    private bool isRating = false;
    private double lastRatedValue = 0;
    private bool isRevealed = false;

    // Statistics
    private int totalItems = 0;
    private int totalAttempts = 0;
    private int correctAnswers = 0;
    private int incorrectAnswers = 0;
    private int completed => currentIndex;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            // TODO: Завантажити приклади з сервісу
            // items = await ExampleService.GetAllWithHiddenTextAsync();
            
            // Тимчасові дані для тестування
            items = new List<ExampleModel>
            {
                new ExampleModel 
                { 
                    Id = 1,
                    Sentence = "I ***go*** to school every day.",
                    Translation = "Я ходжу до школи щодня.",
                    WordId = 1,
                },
                new ExampleModel 
                { 
                    Id = 2,
                    Sentence = "She **likes** to ***read*** books in the library.",
                    Translation = "Вона любить читати книги в бібліотеці.",
                    WordId = 2,
                }
            };

            totalItems = items.Count;
            
            if (items.Any())
            {
                currentItem = items[currentIndex];
                parsedSentence = ExampleMarkdownService.ParseHiddenText(currentItem.Sentence);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            BrowserConsole.LogErrorAsync("Error loading examples", ex);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void RevealHiddenText()
    {
        if (!isRevealed)
        {
            isRevealed = true;
            totalAttempts++;
            StateHasChanged();
        }
    }

    private async Task RateExample(double rating)
    {
        if (currentItem == null) return;

        try
        {
            isRating = true;
            lastRatedValue = rating;

            // TODO: Зберегти оцінку
            // await WordService.UpdateRateAsync(currentItem.WordId, rating);

            await Task.Delay(300);
        }
        catch (Exception ex)
        {
            BrowserConsole.LogErrorAsync("Error rating example", ex);
        }
        finally
        {
            isRating = false;
            StateHasChanged();
        }
    }

    private async Task NextItem()
    {
        currentIndex++;
        lastRatedValue = 0;
        isRevealed = false;

        if (currentIndex >= totalItems)
        {
            showStats = true;
        }
        else
        {
            currentItem = items[currentIndex];
            parsedSentence = ExampleMarkdownService.ParseHiddenText(currentItem.Sentence);
        }

        StateHasChanged();
    }

    private void FinishTest()
    {
        NavigationManager.NavigateTo("/examples-learning");
    }
}

<style>
    .page-content {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .hint-container {
        display: flex;
        justify-content: center;
        margin-bottom: 1.5rem;
    }

    .hint-badge {
        background: linear-gradient(135deg, #F3E5F5, #E1BEE7);
        padding: 0.75rem 1.5rem;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #7B1FA2;
        font-weight: 600;
        font-size: 0.9375rem;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.05);
        }
    }

    .hint-badge i {
        font-size: 1.125rem;
    }

    .example-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .sentence-section {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 1.5rem;
    }

    .sentence-section.english {
        background: linear-gradient(135deg, #F5F7FA, #E8EAF6);
        border-left: 4px solid #7E57C2;
    }

    .sentence-section.translation {
        background: linear-gradient(135deg, #F1F8E9, #DCEDC8);
        border-left: 4px solid #7CB342;
    }

    .language-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #666;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .sentence-text {
        font-size: 1.25rem;
        line-height: 1.8;
        color: #333;
    }

    /* Hidden Word Styles */
    .hidden-word {
        display: inline-block;
        padding: 0.125rem 0.5rem;
        border-radius: 6px;
        transition: all 0.3s ease;
        cursor: pointer;
        position: relative;
    }

    .hidden-word.blurred {
        background: #E0E0E0;
        color: transparent;
        text-shadow: 0 0 8px rgba(0, 0, 0, 0.5);
        user-select: none;
    }

    .hidden-word.blurred:hover {
        background: #D0D0D0;
        transform: scale(1.05);
    }

    .hidden-word.blurred::before {
        content: "?";
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        color: #666;
        font-weight: 700;
        font-size: 1.25rem;
    }

    .hidden-word.revealed {
        background: linear-gradient(135deg, #FFE082, #FFD54F);
        color: #F57C00;
        font-weight: 700;
        text-shadow: none;
        animation: reveal 0.5s ease;
    }

    @@keyframes reveal {
        0% {
            transform: scale(0.8);
            opacity: 0;
        }
        50% {
            transform: scale(1.1);
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    /* Markdown styles */
    .sentence-text :deep(strong) {
        color: #1976D2;
        font-weight: 700;
    }

    .sentence-text :deep(em) {
        color: #7B1FA2;
        font-style: italic;
    }

    .sentence-text :deep(code) {
        background: #FFF9C4;
        padding: 0.125rem 0.375rem;
        border-radius: 4px;
        font-family: 'Courier New', monospace;
        font-size: 1.1rem;
    }

    /* Word Info Section */
    .word-info-section {
        margin-bottom: 2rem;
    }

    .word-card {
        background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
    }

    .word-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .word-main {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1976D2;
    }

    .word-transcription {
        font-size: 1rem;
        font-style: italic;
        color: #1976D2;
        opacity: 0.8;
    }

    .word-translation {
        font-size: 1.125rem;
        color: #333;
    }

    /* Fade in animation */
    .fade-in {
        animation: fadeIn 0.5s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .sentence-text {
            font-size: 1.125rem;
        }

        .word-main {
            font-size: 1.5rem;
        }

        .hint-badge {
            font-size: 0.875rem;
            padding: 0.625rem 1.25rem;
        }
    }
</style>
