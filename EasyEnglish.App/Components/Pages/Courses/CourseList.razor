@page "/courses"
@using System.Dynamic
@using MukhaLab.SelectQueryParameters.Models
@using System.Collections.Generic
@using EasyEnglish.App.Components.Shared
@using Microsoft.Extensions.Logging
@using MukhaLab.Database
@inject ILogger<Index> Logger

<div class="page-content">
    <PageHeader Title="Courses" />

    <div class="courses-grid">
        @foreach (var course in AvailableCourses)
        {
            <PreviewCard
                Id="@course.Id"
                Title="@course.Title"
                Description="@course.Description"
                ItemsCount="@course.Units.Count"
                IsEditable="true"
                BadgeText="Словник"
                GoToViewPage="@((id) => Navigation.NavigateTo($"/courses/{id}"))"
                GoToEditPage="GoToEditPage"
                RemoveItem="RemoveCourse"
            />
        }

        <CourseShortForm OnCourseCreated="@(async () => await LoadData())" />
    </div>
</div>

@code {
    private IEnumerable<CourseModel>? AvailableCourses = [];
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            AvailableCourses = await CourseService.GetAllAsync(null, true);
            BrowserConsole.LogInfoAsync($"Loaded {AvailableCourses?.Count() ?? 0} courses");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading courses: {ex.Message}";
            BrowserConsole.LogErrorAsync("Failed to load courses", ex);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void GoToEditPage(int id)
    {
        Navigation.NavigateTo($"/courses/{id}/edit");
    }

    private async Task RemoveCourse(int id)
    {
        try
        {
            await CourseService.DeleteAsync(id);
            AvailableCourses = await CourseService.GetAllAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting word list: {ex.Message}");
        }
    }

    private async Task RefreshCourses()
    {
        await LoadData();
    }
}

<style>
    .page-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .courses-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    @@media (max-width: 768px) {
        .courses-page {
            padding: 1.5rem 1rem;
        }

        .courses-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
    }

    @@media (min-width: 769px) and (max-width: 1024px) {
        .courses-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
