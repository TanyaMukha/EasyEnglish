@page "/courses/{CourseId:int}/units/{UnitId:int}/irregular-forms/{IrregularFormId:int}"

@using EasyEnglish.App.Components.Shared
@using EasyEnglish.App.Components.Shared.Breadcrumb

<div class="irregular-form-details-page">
    <div class="header-section">
        <Breadcrumb Items="breadcrumbs" />

        <div class="title-section">
            <h1 class="word-title">@IrregularForm.FirstForm</h1>
            <a href="/courses/@CourseId/units/@UnitId/irregular-forms/@IrregularFormId/edit" class="btn-edit" title="Edit">
                <i class="bi bi-pencil"></i>
            </a>
        </div>

        @if (!string.IsNullOrEmpty(IrregularForm.PartOfSpeech))
        {
            <div class="meta-tags">
                <span class="tag tag-speech">@GetPartOfSpeechLabel()</span>
            </div>
        }
    </div>

    <!-- First Form Section -->
    <div class="form-section">
        <h2 class="section-title">
            <i class="bi bi-1-circle"></i> @GetFormLabel(1)
        </h2>
        <div class="content-grid">
            <div class="info-card">
                <div class="card-icon">
                    <i class="bi bi-card-text"></i>
                </div>
                <div class="card-content">
                    <h3 class="card-title">Word</h3>
                    <SelectableText>
                        <p class="card-text">@IrregularForm.FirstForm</p>
                    </SelectableText>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(IrregularForm.FirstFormTranscription))
            {
                <div class="info-card">
                    <div class="card-icon">
                        <i class="bi bi-chat-square-quote"></i>
                    </div>
                    <div class="card-content">
                        <h3 class="card-title">Transcription</h3>
                        <SelectableText>
                            <p class="card-text transcription-text">[ @IrregularForm.FirstFormTranscription ]</p>
                        </SelectableText>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(IrregularForm.FirstFormTranslation))
            {
                <div class="info-card">
                    <div class="card-icon">
                        <i class="bi bi-translate"></i>
                    </div>
                    <div class="card-content">
                        <h3 class="card-title">Translation</h3>
                        <SelectableText>
                            <p class="card-text">@IrregularForm.FirstFormTranslation</p>
                        </SelectableText>
                    </div>
                </div>
            }

            @if (IrregularForm.FirstFormPronunciation?.Length > 0)
            {
                <div class="info-card">
                    <div class="card-icon">
                        <i class="bi bi-volume-up"></i>
                    </div>
                    <div class="card-content">
                        <h3 class="card-title">Pronunciation</h3>
                        <button type="button" class="btn-play" @onclick="() => PlayAudio(1)">
                            <i class="bi bi-play-fill"></i> Play Audio
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Second Form Section -->
    <div class="form-section">
        <h2 class="section-title">
            <i class="bi bi-2-circle"></i> @GetFormLabel(2)
        </h2>
        <div class="content-grid">
            <div class="info-card">
                <div class="card-icon">
                    <i class="bi bi-card-text"></i>
                </div>
                <div class="card-content">
                    <h3 class="card-title">Word</h3>
                    <SelectableText>
                        <p class="card-text">@IrregularForm.SecondForm</p>
                    </SelectableText>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(IrregularForm.SecondFormTranscription))
            {
                <div class="info-card">
                    <div class="card-icon">
                        <i class="bi bi-chat-square-quote"></i>
                    </div>
                    <div class="card-content">
                        <h3 class="card-title">Transcription</h3>
                        <SelectableText>
                            <p class="card-text transcription-text">[ @IrregularForm.SecondFormTranscription ]</p>
                        </SelectableText>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(IrregularForm.SecondFormTranslation))
            {
                <div class="info-card">
                    <div class="card-icon">
                        <i class="bi bi-translate"></i>
                    </div>
                    <div class="card-content">
                        <h3 class="card-title">Translation</h3>
                        <SelectableText>
                            <p class="card-text">@IrregularForm.SecondFormTranslation</p>
                        </SelectableText>
                    </div>
                </div>
            }

            @if (IrregularForm.SecondFormPronunciation?.Length > 0)
            {
                <div class="info-card">
                    <div class="card-icon">
                        <i class="bi bi-volume-up"></i>
                    </div>
                    <div class="card-content">
                        <h3 class="card-title">Pronunciation</h3>
                        <button type="button" class="btn-play" @onclick="() => PlayAudio(2)">
                            <i class="bi bi-play-fill"></i> Play Audio
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Third Form Section -->
    @if (!string.IsNullOrEmpty(IrregularForm.ThirdForm))
    {
        <div class="form-section">
            <h2 class="section-title">
                <i class="bi bi-3-circle"></i> @GetFormLabel(3)
            </h2>
            <div class="content-grid">
                <div class="info-card">
                    <div class="card-icon">
                        <i class="bi bi-card-text"></i>
                    </div>
                    <div class="card-content">
                        <h3 class="card-title">Word</h3>
                        <SelectableText>
                            <p class="card-text">@IrregularForm.ThirdForm</p>
                        </SelectableText>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(IrregularForm.ThirdFormTranscription))
                {
                    <div class="info-card">
                        <div class="card-icon">
                            <i class="bi bi-chat-square-quote"></i>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Transcription</h3>
                            <SelectableText>
                                <p class="card-text transcription-text">[ @IrregularForm.ThirdFormTranscription ]</p>
                            </SelectableText>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(IrregularForm.ThirdFormTranslation))
                {
                    <div class="info-card">
                        <div class="card-icon">
                            <i class="bi bi-translate"></i>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Translation</h3>
                            <SelectableText>
                                <p class="card-text">@IrregularForm.ThirdFormTranslation</p>
                            </SelectableText>
                        </div>
                    </div>
                }

                @if (IrregularForm.ThirdFormPronunciation?.Length > 0)
                {
                    <div class="info-card">
                        <div class="card-icon">
                            <i class="bi bi-volume-up"></i>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Pronunciation</h3>
                            <button type="button" class="btn-play" @onclick="() => PlayAudio(3)">
                                <i class="bi bi-play-fill"></i> Play Audio
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Learning Progress Section -->
    <div class="stats-section">
        <h2 class="section-title">
            <i class="bi bi-bar-chart"></i> Learning Progress
        </h2>
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-star"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Rating</div>
                    <div class="stat-value">@IrregularForm.Rate.ToString("F1") / 5</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-arrow-repeat"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Reviews</div>
                    <div class="stat-value">@IrregularForm.ReviewCount</div>
                </div>
            </div>

            @if (IrregularForm.LastReviewDate.HasValue)
            {
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Last Review</div>
                        <div class="stat-value">@IrregularForm.LastReviewDate.Value.ToString("dd MMM yyyy")</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int UnitId { get; set; }
    [Parameter] public int IrregularFormId { get; set; }
    
    public IrregularFormModel IrregularForm { get; set; } = new();

    private List<Breadcrumb.BreadcrumbItem> breadcrumbs = new();

    protected override async Task OnInitializedAsync()
    {
        IrregularForm = await IrregularFormService.GetByIdAsync(IrregularFormId) ?? new IrregularFormModel();
        BrowserConsole.LogInfoAsync($"✅ IrregularForm : {JsonSerializer.Serialize(IrregularForm)}");

        breadcrumbs = BreadcrumbBuilder.Create()
            .WithLink("Courses", "/courses")
            .WithLink(IrregularForm.Unit?.Course?.Title ?? "Course", $"/courses/{CourseId}")
            .WithLink(IrregularForm.Unit?.Title ?? "Unit", $"/courses/{CourseId}/units/{UnitId}")
            .WithActive(IrregularForm.FirstForm)
            .Build();
    }

    private string GetPartOfSpeechLabel()
    {
        return IrregularForm.PartOfSpeech?.ToLower() switch
        {
            "verb" => "Verb (Дієслово)",
            "noun" => "Noun (Іменник)",
            "adjective" => "Adjective (Прикметник)",
            "adverb" => "Adverb (Прислівник)",
            _ => IrregularForm.PartOfSpeech ?? "Unknown"
        };
    }

    private string GetFormLabel(int formNumber)
    {
        if (string.IsNullOrEmpty(IrregularForm.PartOfSpeech))
        {
            return formNumber switch
            {
                1 => "First Form (Base Form)",
                2 => "Second Form",
                3 => "Third Form",
                _ => "Form"
            };
        }

        return IrregularForm.PartOfSpeech.ToLower() switch
        {
            "verb" => formNumber switch
            {
                1 => "Infinitive (Base Form)",
                2 => "Past Simple",
                3 => "Past Participle",
                _ => "Form"
            },
            "noun" => formNumber switch
            {
                1 => "Singular",
                2 => "Plural",
                3 => "Alternative Plural",
                _ => "Form"
            },
            "adjective" => formNumber switch
            {
                1 => "Positive",
                2 => "Comparative",
                3 => "Superlative",
                _ => "Form"
            },
            "adverb" => formNumber switch
            {
                1 => "Positive",
                2 => "Comparative",
                3 => "Superlative",
                _ => "Form"
            },
            _ => formNumber switch
            {
                1 => "First Form",
                2 => "Second Form",
                3 => "Third Form",
                _ => "Form"
            }
        };
    }

    private void PlayAudio(int formNumber)
    {
        // Implement audio playback - you might need JS interop
        Console.WriteLine($"Playing audio for form {formNumber}");
    }
}

<style>
    .irregular-form-details-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .header-section {
        margin-bottom: 2rem;
    }

    .title-section {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.75rem;
    }

    .word-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #333;
        margin: 0;
    }

    .btn-edit {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        color: #666;
        text-decoration: none;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-edit:hover {
        background: white;
        border-color: #A3BFFA;
        color: #A3BFFA;
        transform: translateY(-2px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .meta-tags {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .tag {
        padding: 0.375rem 0.875rem;
        border-radius: 12px;
        font-size: 0.875rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
    }

    .tag-speech {
        background: #E3F2FD;
        color: #1976D2;
    }

    .form-section {
        margin-bottom: 2.5rem;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #333;
        margin: 0 0 1.25rem 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .section-title i {
        color: #A3BFFA;
    }

    .content-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
    }

    .info-card {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        gap: 1rem;
        transition: all 0.2s;
    }

    .info-card:hover {
        border-color: #A3BFFA;
        box-shadow: 0 4px 12px rgba(163, 191, 250, 0.15);
    }

    .card-icon {
        width: 40px;
        height: 40px;
        background: #f8f9fa;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #A3BFFA;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .card-content {
        flex: 1;
        min-width: 0;
    }

    .card-title {
        font-size: 0.85rem;
        font-weight: 600;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0 0 0.5rem 0;
    }

    .card-text {
        font-size: 1rem;
        color: #333;
        line-height: 1.6;
        margin: 0;
        word-wrap: break-word;
    }

    .transcription-text {
        font-style: italic;
        color: #666;
    }

    .btn-play {
        background: linear-gradient(135deg, #A3BFFA, #B5EAD7);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 0.5rem 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-play:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(163, 191, 250, 0.3);
    }

    .btn-play i {
        font-size: 1.1rem;
    }

    .stats-section {
        margin-top: 2.5rem;
        padding-top: 2rem;
        border-top: 2px solid #f0f0f0;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .stat-card {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: all 0.2s;
    }

    .stat-card:hover {
        border-color: #A3BFFA;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(163, 191, 250, 0.15);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, #A3BFFA, #B5EAD7);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .stat-content {
        flex: 1;
    }

    .stat-label {
        font-size: 0.85rem;
        color: #666;
        margin-bottom: 0.25rem;
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #333;
    }

    @@media (max-width: 768px) {
        .irregular-form-details-page {
            padding: 1.5rem 1rem;
        }

        .word-title {
            font-size: 2rem;
        }

        .content-grid {
            grid-template-columns: 1fr;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
