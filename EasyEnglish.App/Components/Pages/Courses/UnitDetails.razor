@page "/courses/{CourseId:int}/units/{UnitId:int}"

@using System.Dynamic
@using System.Collections.Generic
@using EasyEnglish.App.Components.Shared
@using Microsoft.Extensions.Logging
@using MukhaLab.Database
@using EasyEnglish.App.Models
@using AutoMapper
@inject ILogger<Index> Logger
@inject NavigationManager NavigationManager
@inject IMapper mapper
@inject RecentActivityService RecentActivityService
@using EasyEnglish.App.Components.Shared.Breadcrumb

<PageShell Breadcrumbs="breadcrumbs" Width="PageWidth.Full">
    <div class="header-section">

        <div class="title-section">
            <h1 class="page-title">@Unit.Title</h1>
            <a href="/courses/@CourseId/units/@UnitId/edit" class="btn-edit" title="Edit">
                <i class="bi bi-pencil"></i>
            </a>
        </div>

        @if (!string.IsNullOrEmpty(Unit.Description))
        {
            <p class="page-description">@Unit.Description</p>
        }
    </div>

    @if (!string.IsNullOrEmpty(Unit.Content))
    {
        <div class="content-section content-html">
            <div class="section-header collapsible" @onclick="ToggleMaterial">
                <h2 class="section-title">
                    <i class="bi bi-file-text"></i>
                    Матеріал
                </h2>
                <i class="bi @(isMaterialExpanded ? "bi-chevron-up" : "bi-chevron-down") collapse-icon"></i>
            </div>

            @if (isMaterialExpanded)
            {
                <div class="html-content">
                    @((MarkupString)GetHtmlContent())
                </div>
            }
        </div>
    }

    <div class="content-section">
        @if (availableTabs.Any())
        {
            <div class="tabs-container">
                <div class="tabs-header">
                    <div class="tabs-scroll">
                        @foreach (var tab in availableTabs)
                        {
                            <button class="tab-button @(activeTab == tab.Key ? "active" : "")" 
                                    @onclick="() => SetActiveTab(tab.Key)">
                                <i class="bi @tab.Icon"></i>
                                <span class="tab-label">@tab.Label</span>
                                @if (tab.Count > 0)
                                {
                                    <span class="tab-count">@tab.Count</span>
                                }
                            </button>
                        }
                    </div>

                    @if (GetAvailableTabsToAdd().Any())
                    {
                        <div class="add-tab-container">
                            <button class="add-tab-button" @onclick="ToggleAddTabDropdown">
                                <i class="bi bi-plus-circle"></i>
                                <span>Add Section</span>
                            </button>

                            @if (showAddTabDropdown)
                            {
                                <div class="add-tab-dropdown">
                                    @foreach (var tab in GetAvailableTabsToAdd())
                                    {
                                        <button class="dropdown-item" @onclick="() => AddNewTab(tab.Key)">
                                            <i class="bi @tab.Icon"></i>
                                            <span>@tab.Label</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="tabs-content">
                    @if (activeTab == "words")
                    {
                        <div class="tab-panel">
                            @if (!isLoading && Unit.Words != null && Unit.Words.Any())
                            {
                                <div class="tab-toolbar-top">
                                    <a href="/courses/@CourseId/units/@Unit.Id/examples/practice" class="btn-cancel">
                                        <i class="bi bi-arrow-repeat"></i>
                                        Практикувати приклади
                                    </a>
                                    <a href="/courses/@CourseId/units/@Unit.Id/words/practice" class="btn-cancel">
                                        <i class="bi bi-play-fill"></i>
                                        Практикувати слова
                                    </a>
                                </div>
                            }
                            @if (isLoading)
                            {
                                <div class="loading-container">
                                    <div class="spinner">
                                        <div class="spinner-border" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </div>
                                    <p class="loading-text">Завантаження...</p>
                                </div>
                            }
                            else if (Unit.Words != null && Unit.Words.Any())
                            {
                                <div class="items-grid">
                                    @foreach (var word in Unit.Words)
                                    {
                                        <WordCard word="@word" OnDelete="RemoveWord" />
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="empty-container">
                                    <div class="empty-icon">
                                        <i class="bi bi-inbox"></i>
                                    </div>
                                    <p class="empty-message">Немає слів у цьому списку.</p>
                                    <p class="empty-hint">Додайте перше слово, використовуючи форму нижче</p>
                                </div>
                            }

                            <div class="create-section">
                                <WordShortForm 
                                    CourseId="CourseId" 
                                    UnitId="Unit.Id" 
                                    OnWordsCreated="OnUnitChanged"
                                />
                            </div>
                        </div>
                    }
                    else if (activeTab == "irregular-forms")
                    {
                        <div class="tab-panel">
                            @if (!isLoading && Unit.IrregularForms != null && Unit.IrregularForms.Any())
                            {
                                <div class="tab-toolbar-top">
                                    <a href="/courses/@CourseId/units/@Unit.Id/irregular-forms/practice" class="btn-cancel">
                                        <i class="bi bi-play-fill"></i>
                                        Практикувати
                                    </a>
                                </div>
                            }
                            @if (isLoading)
                            {
                                <div class="loading-container">
                                    <div class="spinner">
                                        <div class="spinner-border" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </div>
                                    <p class="loading-text">Завантаження...</p>
                                </div>
                            }
                            else if (Unit.IrregularForms != null && Unit.IrregularForms.Any())
                            {
                                <div class="items-grid">
                                    @foreach (var irregularForm in Unit.IrregularForms)
                                    {
                                        <IrregularFormCard irregularForm="@irregularForm" OnDelete="RemoveIrregularForm" />
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="empty-container">
                                    <div class="empty-icon">
                                        <i class="bi bi-inbox"></i>
                                    </div>
                                    <p class="empty-message">Немає неправильних форм у цьому списку.</p>
                                    <p class="empty-hint">Додайте першу неправильну форму, використовуючи форму нижче</p>
                                </div>
                            }

                            <div class="create-section">
                                <IrregularFormShortForm
                                    CourseId="CourseId"
                                    UnitId="Unit.Id"
                                    OnFormsCreated="OnUnitChanged"
                                />
                            </div>
                        </div>
                    }
                    else if (activeTab == "study-cards")
                    {
                        <div class="tab-panel">
                            @if (!isLoading && Unit.StudyCards != null && Unit.StudyCards.Any())
                            {
                                <div class="tab-toolbar-top">
                                    <a href="/courses/@CourseId/units/@Unit.Id/study-cards/practice/setup" class="btn-cancel">
                                        <i class="bi bi-play-fill"></i>
                                        Практикувати
                                    </a>
                                </div>
                            }
                            @if (isLoading)
                            {
                                <div class="loading-container">
                                    <div class="spinner">
                                        <div class="spinner-border" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </div>
                                    <p class="loading-text">Завантаження...</p>
                                </div>
                            }
                            else if (Unit.StudyCards != null && Unit.StudyCards.Any())
                            {
                                <div class="items-grid">
                                    @foreach (var studyCard in Unit.StudyCards)
                                    {
                                        <StudyCardPreview card="@studyCard" CourseId="CourseId" OnDelete="RemoveStudyCard" />
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="empty-container">
                                    <div class="empty-icon">
                                        <i class="bi bi-inbox"></i>
                                    </div>
                                    <p class="empty-message">Немає навчальних карток у цьому модулі.</p>
                                </div>
                            }

                            <div class="create-section" style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                                @if (Unit.StudyCards != null && Unit.StudyCards.Any())
                                {
                                    <a href="/courses/@CourseId/units/@Unit.Id/study-cards/practice/setup" class="btn-cancel">
                                        <i class="bi bi-play-fill"></i>
                                        Практикувати
                                    </a>
                                }
                                <a href="/courses/@CourseId/units/@Unit.Id/study-cards/create" class="btn-submit">
                                    <i class="bi bi-plus-circle"></i>
                                    Додати навчальну картку
                                </a>
                            </div>
                        </div>
                    }
                    else if (activeTab == "test-cards")
                    {
                        <div class="tab-panel">
                            @if (!isLoading && Unit.TestCards != null && Unit.TestCards.Any())
                            {
                                <div class="tab-toolbar-top">
                                    <a href="/courses/@CourseId/units/@Unit.Id/test-cards/practice/setup" class="btn-cancel">
                                        <i class="bi bi-play-fill"></i>
                                        Практикувати
                                    </a>
                                </div>
                            }
                            @if (isLoading)
                            {
                                <div class="loading-container">
                                    <div class="spinner">
                                        <div class="spinner-border" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </div>
                                    <p class="loading-text">Завантаження...</p>
                                </div>
                            }
                            else if (Unit.TestCards != null && Unit.TestCards.Any())
                            {
                                <div class="items-grid">
                                    @foreach (var testCard in Unit.TestCards)
                                    {
                                        <TestCardPreview card="@testCard" CourseId="CourseId" OnDelete="RemoveTestCard" />
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="empty-container">
                                    <div class="empty-icon">
                                        <i class="bi bi-inbox"></i>
                                    </div>
                                    <p class="empty-message">Немає тестових карток у цьому модулі.</p>
                                </div>
                            }

                            <div class="create-section" style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                                @if (Unit.TestCards != null && Unit.TestCards.Any())
                                {
                                    <a href="/courses/@CourseId/units/@Unit.Id/test-cards/practice/setup" class="btn-cancel">
                                        <i class="bi bi-play-fill"></i>
                                        Практикувати
                                    </a>
                                }
                                <a href="/courses/@CourseId/units/@Unit.Id/test-cards/create" class="btn-submit">
                                    <i class="bi bi-plus-circle"></i>
                                    Додати тестову картку
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="empty-unit-container">
                <div class="empty-icon">
                    <i class="bi bi-inbox"></i>
                </div>
                <h3 class="empty-title">У цьому модулі поки немає контенту</h3>
                <p class="empty-description">Додайте секцію для початку роботи</p>
                
                <div class="add-sections-grid">
                    @foreach (var tab in GetAllPossibleTabs())
                    {
                        <button class="add-section-card" @onclick="() => AddNewTab(tab.Key)">
                            <i class="bi @tab.Icon"></i>
                            <span>@tab.Label</span>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</PageShell>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int UnitId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }

    private UnitModel Unit { get; set; } = new();
    private List<OptionDefinition> AvailableUnits { get; set; } = new();
    private bool isLoading { get; set; } = false;
    private string? errorMessage;
    private string activeTab = "words";
    private List<string> manuallyAddedTabs = new();
    private bool showAddTabDropdown = false;

    private List<Breadcrumb.BreadcrumbItem> breadcrumbs = new();

    private class TabInfo
    {
        public string Key { get; set; } = "";
        public string Label { get; set; } = "";
        public string Icon { get; set; } = "";
        public int Count { get; set; }
    }

    private List<TabInfo> availableTabs = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        breadcrumbs = BreadcrumbBuilder.Create()
            .WithHome()
            .WithLink("Курси", "/courses")
            .WithLink(Unit.Course?.Title ?? "Курс", $"/courses/{CourseId}")
            .WithActive(Unit.Title)
            .Build();

        InitializeTabs();

        if (!string.IsNullOrEmpty(TabQuery) && availableTabs.Any(t => t.Key == TabQuery))
        {
            activeTab = TabQuery;
        }
    }

    private List<TabInfo> GetAllPossibleTabs()
    {
        return new List<TabInfo>
        {
            new TabInfo 
            { 
                Key = "words", 
                Label = "Vocabulary", 
                Icon = "bi-card-text",
                Count = Unit.Words?.Count ?? 0
            },
            new TabInfo
            {
                Key = "irregular-forms",
                Label = "Irregular Forms",
                Icon = "bi-layers",
                Count = Unit.IrregularForms?.Count ?? 0
            },
            new TabInfo
            {
                Key = "study-cards",
                Label = "Study Cards",
                Icon = "bi-journal-text",
                Count = Unit.StudyCards?.Count ?? 0
            },
            new TabInfo
            {
                Key = "test-cards",
                Label = "Tests",
                Icon = "bi-patch-question",
                Count = Unit.TestCards?.Count ?? 0
            }
            // New kinds are easy to add here:
            // new TabInfo { Key = "phrases", Label = "Phrases", Icon = "bi-chat-quote", Count = Unit.Phrases?.Count ?? 0 },
        };
    }

    private void InitializeTabs()
    {
        var allTabs = GetAllPossibleTabs();
        
        // Show tabs that have content, plus the ones the user added manually
        availableTabs = allTabs.Where(t => t.Count > 0 || manuallyAddedTabs.Contains(t.Key)).ToList();

        // If there are tabs, make the first one active
        if (availableTabs.Any() && !availableTabs.Any(t => t.Key == activeTab))
        {
            activeTab = availableTabs.First().Key;
        }
    }

    private List<TabInfo> GetAvailableTabsToAdd()
    {
        var allTabs = GetAllPossibleTabs();
        var currentTabKeys = availableTabs.Select(t => t.Key).ToList();
        return allTabs.Where(t => !currentTabKeys.Contains(t.Key)).ToList();
    }

    private void AddNewTab(string tabKey)
    {
        if (!manuallyAddedTabs.Contains(tabKey))
        {
            manuallyAddedTabs.Add(tabKey);
        }
        InitializeTabs();
        activeTab = tabKey;
        showAddTabDropdown = false;
        StateHasChanged();
    }

    private void ToggleAddTabDropdown()
    {
        showAddTabDropdown = !showAddTabDropdown;
        StateHasChanged();
    }

    private void SetActiveTab(string tabKey)
    {
        activeTab = tabKey;
        StateHasChanged();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            Unit = await UnitService.GetByIdAsync(UnitId, UnitIncludes.Full) ?? new UnitModel();
            AvailableUnits = (await CourseService.GetUnitsAsync(Unit.CourseId))
                .Select(wl => new OptionDefinition { Id = wl.Id, Title = wl.Title })
                .ToList();

            if (Unit.Id > 0)
                await RecentActivityService.RecordUnitVisitAsync(CourseId, Unit.Id, Unit.Title, Unit.Course?.Title ?? "");

            InitializeTabs();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading unit: {ex.Message}";
            BrowserConsole.LogErrorAsync("Failed to load unit", ex);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RemoveWord(int id)
    {
        var word = Unit.Words?.FirstOrDefault(w => w.Id == id);

        if (!await Confirmation.ConfirmDeleteAsync("слово", word?.Word,
                "Приклади цього слова зникнуть разом із ним."))
            return;

        try
        {
            await WordService.DeleteAsync(id);
            await OnUnitChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting word: {ex.Message}";
            BrowserConsole.LogErrorAsync("Failed to delete word", ex);
        }
    }

    private async Task RemoveIrregularForm(int id)
    {
        var form = Unit.IrregularForms?.FirstOrDefault(f => f.Id == id);

        if (!await Confirmation.ConfirmDeleteAsync("неправильну форму", form?.FirstForm))
            return;

        try
        {
            await IrregularFormService.DeleteAsync(id);
            await OnUnitChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting irregular form: {ex.Message}";
            BrowserConsole.LogErrorAsync("Failed to delete irregular form", ex);
        }
    }

    private async Task RemoveStudyCard(int id)
    {
        var card = Unit.StudyCards?.FirstOrDefault(c => c.Id == id);

        if (!await Confirmation.ConfirmDeleteAsync("навчальну картку", card?.Title))
            return;

        try
        {
            await StudyCardService.DeleteAsync(id);
            await OnUnitChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting study card: {ex.Message}";
            BrowserConsole.LogErrorAsync("Failed to delete study card", ex);
        }
    }

    private async Task RemoveTestCard(int id)
    {
        var card = Unit.TestCards?.FirstOrDefault(c => c.Id == id);

        if (!await Confirmation.ConfirmDeleteAsync("тестову картку", card?.Title ?? card?.Question))
            return;

        try
        {
            await TestCardService.DeleteAsync(id);
            await OnUnitChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting test card: {ex.Message}";
            BrowserConsole.LogErrorAsync("Failed to delete test card", ex);
        }
    }

    private async Task OnUnitChanged()
    {
        await LoadData();
        
        // Drop from the manually added tabs the ones that now have content
        var allTabs = GetAllPossibleTabs();
        manuallyAddedTabs = manuallyAddedTabs
            .Where(key => !allTabs.Any(t => t.Key == key && t.Count > 0))
            .ToList();
        
        InitializeTabs();
    }

    private bool isMaterialExpanded = false;

    private void ToggleMaterial() => isMaterialExpanded = !isMaterialExpanded;

    private MarkupString GetHtmlContent()
    {
        if (string.IsNullOrEmpty(Unit.Content))
            return new MarkupString("");

        var decoded = System.Net.WebUtility.HtmlDecode(Unit.Content);
        return new MarkupString(decoded);
    }
}

<style>

.page-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

.content-html .section-header.collapsible {
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        user-select: none;
        padding: 16px;
        border: 1px solid var(--border);
        border-radius: 12px;
    }

    .content-html .section-header.collapsible:hover .section-title {
        color: var(--accent);
    }

    .content-html .collapse-icon {
        color: var(--text-secondary);
        font-size: 1.1rem;
    }

.content-section.content-html {
        margin-bottom: 3rem;
    }

/* HTML Content */
    .html-content {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 2rem;
        line-height: 1.8;
        color: var(--text-primary);
        font-size: 1rem;
    }

    .html-content h1 {
        font-size: 2rem;
        font-weight: 700;
        margin: 1.5rem 0 1rem 0;
        color: var(--text-primary);
        border-bottom: 2px solid var(--border);
        padding-bottom: 0.5rem;
    }

    .html-content h2 {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 1.25rem 0 0.75rem 0;
        color: var(--text-primary);
    }

    .html-content h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 1rem 0 0.5rem 0;
        color: var(--text-primary);
    }

    .html-content p {
        margin: 0.75rem 0;
        line-height: 1.8;
    }

    .html-content strong {
        font-weight: 700;
        color: var(--text-primary);
    }

    .html-content em {
        font-style: italic;
        color: var(--text-secondary);
    }

    .html-content u {
        text-decoration: underline;
    }

    .html-content a {
        color: var(--accent);
        text-decoration: none;
        border-bottom: 1px solid var(--accent);
        transition: all 0.2s;
    }

    .html-content a:hover {
        color: var(--accent-dark);
        border-bottom-color: var(--accent-dark);
    }

    .html-content ul,
    .html-content ol {
        margin: 1rem 0;
        padding-left: 2rem;
    }

    .html-content li {
        margin: 0.5rem 0;
        line-height: 1.6;
    }

    .html-content ul {
        list-style-type: disc;
    }

    .html-content ol {
        list-style-type: decimal;
    }

    .html-content code {
        background: var(--surface-alt);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
        font-size: 0.9em;
        color: #c7254e;
        border: 1px solid var(--border);
    }

    .html-content blockquote {
        margin: 1rem 0;
        padding: 1rem 1.5rem;
        background: var(--surface-alt);
        border-left: 4px solid var(--accent);
        color: var(--text-secondary);
    }

    /* Tabs */
    .tabs-container {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
    }

    .tabs-header {
        display: flex;
        border-bottom: 2px solid var(--border-light);
        background: var(--surface-alt);
        position: relative;
    }

    .tabs-scroll {
        display: flex;
        overflow-x: auto;
        flex: 1;
    }

    .tabs-scroll::-webkit-scrollbar {
        height: 3px;
    }

    .tabs-scroll::-webkit-scrollbar-track {
        background: transparent;
    }

    .tabs-scroll::-webkit-scrollbar-thumb {
        background: var(--border);
        border-radius: 3px;
    }

    .tabs-scroll::-webkit-scrollbar-thumb:hover {
        background: var(--text-muted);
    }

    .tab-button {
        background: transparent;
        border: none;
        padding: 1rem 1.5rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-secondary);
        font-weight: 600;
        font-size: 0.95rem;
        border-bottom: 3px solid transparent;
        white-space: nowrap;
    }

    .tab-button:hover {
        background: rgba(163, 191, 250, 0.1);
        color: var(--text-primary);
    }

    .tab-button.active {
        background: var(--surface);
        color: var(--accent);
        border-bottom-color: var(--accent);
    }

    .tab-button i {
        font-size: 1.1rem;
    }

    .tab-label {
        font-weight: 600;
    }

    .tab-count {
        background: var(--border);
        color: var(--text-secondary);
        padding: 0.125rem 0.5rem;
        border-radius: 10px;
        font-size: 0.75rem;
        font-weight: 700;
        min-width: 1.5rem;
        text-align: center;
    }

    .tab-button.active .tab-count {
        background: var(--accent);
        color: white;
    }

    .add-tab-container {
        position: relative;
        flex-shrink: 0;
    }

    .add-tab-button {
        background: transparent;
        border: none;
        padding: 1rem 1.5rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
