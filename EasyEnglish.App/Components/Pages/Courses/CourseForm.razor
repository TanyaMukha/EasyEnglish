@page "/courses/{id:int}/edit"
@page "/courses/create"

@using EasyEnglish.App.Components.Shared
@using EasyEnglish.App.Components.Shared.Breadcrumb

<div class="page-content">
    <div class="header-section">
        <Breadcrumb Items="breadcrumbs" />

        <h1 class="page-title">
            <i class="bi @(IsEditMode ? "bi-pencil" : "bi-plus-circle")"></i>
            @(IsEditMode ? "Edit" : "Create") Course
        </h1>
    </div>

    <div class="edit-form-container">
        <EditForm Model="newCourse" OnValidSubmit="HandleValidSubmit" class="edit-form">
            <DataAnnotationsValidator />

            <div class="form-section">
                <h2 class="section-title">
                    <i class="bi bi-info-circle"></i>
                    Основна інформація
                </h2>

                <InputTextField @bind-Value="newCourse.Title"
                                Label="Назва словника" />
                <ValidationMessage For="@(() => newCourse.Title)" class="validation-message" />

                <InputMultilineField @bind-Value="newCourse.Description"
                                     Label="Опис"
                                     Rows="1" />
                <ValidationMessage For="@(() => newCourse.Description)" class="validation-message" />

                <InputSelectField @bind-Value="newCourse.LanguageCode" Label="Мова курсу">
                    @foreach (var lang in CourseLanguages.All)
                    {
                        <option value="@lang.Code">@lang.Label</option>
                    }
                </InputSelectField>
            </div>

            <div class="form-actions">
                <a href="/courses" class="btn-cancel">
                    <i class="bi bi-x-lg"></i>
                    Скасувати
                </a>
                <button type="submit" class="btn-submit">
                    <i class="bi @(IsEditMode ? "bi-check-lg" : "bi-plus-lg")"></i>
                    @(IsEditMode ? "Оновити" : "Створити")
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; } = 0;

    public CourseModel newCourse { get; set; } = new();

    private bool IsEditMode => Id > 0;

    private List<Breadcrumb.BreadcrumbItem> breadcrumbs = new();

    protected override async Task OnInitializedAsync()
    {
        if (IsEditMode)
        {
            // Loading existing course for editing
            newCourse = await CourseService.GetByIdAsync(Id)
                ?? new CourseModel();
        }
        else
        {
            newCourse = new CourseModel();
        }

        breadcrumbs = BreadcrumbBuilder.Create()
            .WithLink("Courses", "/courses")
            .WithLink(newCourse.Title, $"/courses/{Id}")
            .Build();
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (IsEditMode)
            {
                await CourseService.UpdateAsync(newCourse.Id, newCourse);
            }
            else
            {
                Console.WriteLine($"New Course: {newCourse}");
                await CourseService.CreateAsync(newCourse);
            }

            NavigationManager.NavigateTo("/courses");
        }
        catch (Exception ex)
        {
            // Handle error - you might want to show a toast or error message
            Console.WriteLine($"Error saving course: {ex.Message}");
        }
    }
}
