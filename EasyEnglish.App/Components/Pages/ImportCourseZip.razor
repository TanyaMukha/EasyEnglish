@page "/import-course-zip"
@using EasyEnglish.App.Components.Shared
@using EasyEnglish.App.Interfaces
@using EasyEnglish.Core.Mapping
@using EasyEnglish.Core.Models
@using EasyEnglish.Services
@inject CourseZipBackupService ZipBackupService
@inject IFileService FileService
@inject ICourseService CourseService
@inject IUnitService UnitService
@inject IJSRuntime JSRuntime
@inject AutoMapper.IMapper Mapper

<PageTitle>Імпорт курсу</PageTitle>

<div class="page-wrapper">
    <div class="scroll-area">
        <div class="edit-page">

            <!-- ═══════════ HEADER ═══════════ -->
            <div class="header-section">
                <h1 class="page-title">
                    <i class="bi bi-box-arrow-in-down"></i>
                    Імпорт курсу
                </h1>
                <p class="page-description">
                    Завантажте ZIP-архів курсу — він може містити кілька модулів та аудіофайли.
                </p>
            </div>

            <div class="form-container">

                <!-- ═══════════ STEP 1 — PICK FILE ═══════════ -->
                <div class="form-section">
                    <h2 class="section-title">
                        <i class="bi bi-1-circle"></i>
                        Виберіть архів
                    </h2>

                    <div class="file-picker-section">
                        <button class="btn-file-picker" @onclick="PickZipFile" disabled="@isProcessing">
                            <i class="bi bi-file-earmark-zip"></i>
                            @(selectedFileName ?? "Виберіть .zip файл...")
                        </button>
                    </div>

                    @if (importError != null)
                    {
                        <div class="alert alert-error">
                            <i class="bi bi-exclamation-triangle"></i>
                            <div>
                                <strong>Помилка:</strong>
                                <p>@importError</p>
                            </div>
                        </div>
                    }
                </div>

                <!-- ═══════════ STEP 2 — PREVIEW ═══════════ -->
                @if (manifest != null)
                {
                    <div class="form-section">
                        <h2 class="section-title">
                            <i class="bi bi-2-circle"></i>
                            Інформація про курс
                        </h2>

                        @if (existingCourse != null && manifest.Options.IsFullBackup)
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-arrow-repeat"></i>
                                <div>
                                    <strong>Курс вже імпортовано</strong>
                                    <p>
                                        «<strong>@existingCourse.Title</strong>» з таким самим GUID вже є в базі.
                                        Оберіть дію:
                                    </p>
                                </div>
                            </div>

                            <div class="radio-group">
                                <div class="radio-option @(importMode == ImportMode.Update ? "radio-option--active" : "")"
                                     @onclick="@(() => importMode = ImportMode.Update)">
                                    <i class="bi bi-arrow-clockwise"></i>
                                    <div>
                                        <strong>Оновити наявний курс</strong>
                                        <span>Модулі з тим самим GUID оновляться; нові — додадуться</span>
                                    </div>
                                </div>
                                <div class="radio-option @(importMode == ImportMode.CreateNew ? "radio-option--active" : "")"
                                     @onclick="@(() => importMode = ImportMode.CreateNew)">
                                    <i class="bi bi-plus-circle"></i>
                                    <div>
                                        <strong>Створити новий курс</strong>
                                        <span>Буде створено окремий курс незалежно від наявного</span>
                                    </div>
                                </div>
                                <div class="radio-option @(importMode == ImportMode.MergeInto ? "radio-option--active" : "")"
                                     @onclick="@(() => importMode = ImportMode.MergeInto)">
                                    <i class="bi bi-diagram-3"></i>
                                    <div>
                                        <strong>Злити з іншим курсом</strong>
                                        <span>Модулі будуть додані до обраного курсу з новими GUID</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (existingCourse != null)
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-info-circle"></i>
                                <div>
                                    <strong>Курс вже існує</strong>
                                    <p>
                                        «<strong>@existingCourse.Title</strong>» з таким самим GUID вже є в базі.
                                        Оскільки це не повна резервна копія, буде створено окрему копію курсу.
                                    </p>
                                </div>
                            </div>

                            <div class="radio-group">
                                <div class="radio-option @(importMode == ImportMode.CreateNew ? "radio-option--active" : "")"
                                     @onclick="@(() => importMode = ImportMode.CreateNew)">
                                    <i class="bi bi-plus-circle"></i>
                                    <div>
                                        <strong>Створити копію курсу</strong>
                                        <span>Буде створено окремий курс з новими GUID</span>
                                    </div>
                                </div>
                                <div class="radio-option @(importMode == ImportMode.MergeInto ? "radio-option--active" : "")"
                                     @onclick="@(() => importMode = ImportMode.MergeInto)">
                                    <i class="bi bi-diagram-3"></i>
                                    <div>
                                        <strong>Злити з іншим курсом</strong>
                                        <span>Модулі будуть додані до обраного курсу з новими GUID</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="radio-group">
                                <div class="radio-option @(importMode == ImportMode.CreateNew ? "radio-option--active" : "")"
                                     @onclick="@(() => importMode = ImportMode.CreateNew)">
                                    <i class="bi bi-plus-circle"></i>
                                    <div>
                                        <strong>Створити новий курс</strong>
                                        <span>Модулі будуть імпортовані в новий курс</span>
                                    </div>
                                </div>
                                <div class="radio-option @(importMode == ImportMode.MergeInto ? "radio-option--active" : "")"
                                     @onclick="@(() => importMode = ImportMode.MergeInto)">
                                    <i class="bi bi-diagram-3"></i>
                                    <div>
                                        <strong>Злити з існуючим курсом</strong>
                                        <span>Модулі будуть додані до обраного курсу з новими GUID</span>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (importMode == ImportMode.MergeInto)
                        {
                            <InputSelectField @bind-Value="mergeTargetCourseId"
                                              Label="Курс для злиття"
                                              EmptyOption="Виберіть курс...">
                                @foreach (var c in availableCourses)
                                {
                                    <option value="@c.Id">@c.Title</option>
                                }
                            </InputSelectField>
                        }

                        <div class="info-card">
                            <div class="info-row">
                                <span class="info-label">Назва</span>
                                <span class="info-value"><strong>@manifest.CourseTitle</strong></span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(manifest.CourseDescription))
                            {
                                <div class="info-row">
                                    <span class="info-label">Опис</span>
                                    <span class="info-value">@manifest.CourseDescription</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(manifest.LanguageCode))
                            {
                                <div class="info-row">
                                    <span class="info-label">Мова</span>
                                    <span class="info-value">
                                        @LanguageFlagHelper.GetFlagEmoji(manifest.LanguageCode)
                                        @manifest.LanguageCode
                                    </span>
                                </div>
                            }
                            <div class="info-row">
                                <span class="info-label">GUID курсу</span>
                                <span class="info-value info-value--mono">@manifest.CourseGuid</span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">Дата експорту</span>
                                <span class="info-value">
                                    @manifest.ExportedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">Версія</span>
                                <span class="info-value">@manifest.SchemaVersion</span>
                            </div>
                        </div>

                        <div class="units-list">
                            @foreach (var entry in manifest.Units)
                            {
                                <div class="unit-item">
                                    <div class="unit-item__icon">
                                        <i class="bi bi-journal-text"></i>
                                    </div>
                                    <div class="unit-item__body">
                                        <span class="unit-item__title">@entry.Title</span>
                                        <span class="unit-item__meta">
                                            @entry.WordCount слів
                                            @if (entry.AudioFiles.Count > 0)
                                            {
                                                <span class="badge-audio">
                                                    <i class="bi bi-volume-up"></i>
                                                    @entry.AudioFiles.Count аудіо
                                                </span>
                                            }
                                        </span>
                                    </div>
                                    @if (importMode == ImportMode.Update && existingUnitGuids.Contains(entry.UnitGuid))
                                    {
                                        <span class="badge badge-update">оновлення</span>
                                    }
                                    else if (importMode == ImportMode.Update)
                                    {
                                        <span class="badge badge-new">новий</span>
                                    }
                                </div>
                            }
                        </div>


                    </div>

                    <!-- ═══════════ STEP 3 — OPTIONS ═══════════ -->
                    <div class="form-section">
                        <h2 class="section-title">
                            <i class="bi bi-3-circle"></i>
                            Параметри імпорту
                        </h2>

                        <div class="checkbox-group">
                            @if (manifest.Options.IncludeExamples)
                            {
                                <InputCheckboxField @bind-Value="importOptions.IncludeExamples"
                                    Label="Приклади використання"
                                    Icon="bi-file-text" />
                            }
                            @if (manifest.Options.IncludeLearningProgress)
                            {
                                <InputCheckboxField @bind-Value="importOptions.IncludeLearningProgress"
                                    Label="Прогрес вивчення"
                                    Icon="bi-tags" />
                            }
                            @if (manifest.Options.IsFullBackup)
                            {
                                <InputCheckboxField @bind-Value="importOptions.IsFullBackup"
                                    Label="Відновити як резервну копію (зберегти ID)"
                                    Icon="bi-list-ul" />
                            }
                        </div>
                    </div>

                    <!-- ═══════════ STEP 4 — SAVE ═══════════ -->
                    <div class="form-section">
                        @if (importSuccess != null)
                        {
                            <div class="alert alert-success">
                                <i class="bi bi-check-circle"></i>
                                <div><p>@importSuccess</p></div>
                            </div>
                        }

                        <div class="form-actions">
                            <button class="btn-submit"
                                    @onclick="SaveImport"
                                    disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="spinner"></span>
                                    <text>Збереження...</text>
                                }
                                else if (importMode == ImportMode.Update && existingCourse != null)
                                {
                                    <i class="bi bi-arrow-clockwise"></i>
                                    <text>Оновити «@existingCourse.Title»</text>
                                }
                                else if (importMode == ImportMode.MergeInto && mergeTargetCourseId > 0)
                                {
                                    var target = availableCourses.FirstOrDefault(c => c.Id == mergeTargetCourseId);
                                    <i class="bi bi-diagram-3"></i>
                                    <text>Злити з «@(target?.Title ?? "...")»</text>
                                }
                                else
                                {
                                    <i class="bi bi-save"></i>
                                    <text>Зберегти курс (@manifest.Units.Count модулів)</text>
                                }
                            </button>
                        </div>


                    </div>
                }

            </div>
            <div class="keyboard-spacer"></div>
        </div>
    </div>
</div>

@code {
    private string?                selectedFileName;
    private byte[]?                zipBytes;

    private CoursePackageManifest? manifest;
    private CourseImportResult?    importResult;
    private CourseModel?           existingCourse;
    private HashSet<Guid>          existingUnitGuids = [];

    private UnitBackupOptions importOptions = new();
    private ImportMode        importMode    = ImportMode.CreateNew;
    private int               mergeTargetCourseId = 0;
    private List<CourseModel> availableCourses = [];

    private bool    isProcessing   = false;
    private string? importError;
    private string? importSuccess;

    private enum ImportMode { CreateNew, Update, MergeInto }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await JSRuntime.InvokeVoidAsync("eval", @"
            (function() {
                document.addEventListener('focusin', function(e) {
                    const el = e.target;
                    if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'SELECT') {
                        setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'center' }), 300);
                    }
                });
            })();
        ");
    }

    private async Task PickZipFile()
    {
        ClearState();
        isProcessing = true;

        try
        {
            zipBytes = await FileService.PickAndReadFileBytesAsync(); //"application/zip", ".zip"

            if (zipBytes is null || zipBytes.Length == 0)
                return;

            await ParseManifestAsync();
        }
        catch (Exception ex)
        {
            importError      = $"Помилка при читанні файлу: {ex.Message}";
            selectedFileName = null;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task ParseManifestAsync()
    {
        using var ms = new MemoryStream(zipBytes!);
        manifest = await ZipBackupService.ReadManifestAsync(ms);

        if (manifest is null)
        {
            importError = "Не вдалося прочитати course.json з архіву.";
            return;
        }

        selectedFileName = $"{manifest.CourseTitle}.zip";

        existingCourse    = await CourseService.GetByGuidAsync(manifest.CourseGuid);
        existingUnitGuids = [];
        importMode        = ImportMode.CreateNew;

        // Завантажуємо всі курси для злиття
        availableCourses = (await CourseService.GetAllAsync()).ToList();

        if (existingCourse != null)
        {
            // Оновлення доступне лише для повного бекапу — тільки тоді збережені Id
            importMode = manifest.Options.IsFullBackup
                ? ImportMode.Update
                : ImportMode.CreateNew;

            var guids = manifest.Units.Select(u => u.UnitGuid).ToList();
            existingUnitGuids = (await UnitService.GetExistingGuidsAsync(guids)).ToHashSet();
        }

        importOptions = new UnitBackupOptions
        {
            IncludeExamples         = manifest.Options.IncludeExamples,
            IncludeLearningProgress = manifest.Options.IncludeLearningProgress,
            IsFullBackup            = manifest.Options.IsFullBackup,
        };
    }

    private async Task SaveImport()
    {
        if (manifest is null || zipBytes is null) return;
        if (importMode == ImportMode.MergeInto && mergeTargetCourseId == 0)
        {
            importError = "Оберіть курс для злиття.";
            return;
        }

        isProcessing  = true;
        importError   = null;
        importSuccess = null;

        try
        {
            // Завантажуємо дані модулів прямо тут
            using var msLoad = new MemoryStream(zipBytes);
            importResult = await ZipBackupService.ImportFromZipAsync(msLoad, manifest);
            // 1. Resolve or create course.
            CourseModel targetCourse;
            bool isCopy = importMode == ImportMode.CreateNew && existingCourse != null;

            if (importMode == ImportMode.Update && existingCourse != null)
            {
                targetCourse = existingCourse;
            }
            else if (importMode == ImportMode.MergeInto)
            {
                var mergeTarget = availableCourses.FirstOrDefault(c => c.Id == mergeTargetCourseId)
                    ?? throw new InvalidOperationException("Оберіть курс для злиття.");
                targetCourse = mergeTarget;
            }
            else
            {
                targetCourse = new CourseModel
                {
                    RecordGuid   = importOptions.IsFullBackup && !isCopy
                        ? manifest.CourseGuid
                        : Guid.NewGuid(),
                    Title        = isCopy
                        ? $"{manifest.CourseTitle} (копія)"
                        : manifest.CourseTitle,
                    Description  = manifest.CourseDescription,
                    LanguageCode = manifest.LanguageCode,
                };
                targetCourse = await CourseService.CreateAsync(targetCourse);
            }

            int added   = 0;
            int updated = 0;

            // 2. Build mapping options once — same for all units in this import.
            // MergeInto завжди скидає Id і генерує нові Guid — модулі незалежні від оригіналу.
            var mappingOptions = importMode == ImportMode.MergeInto
                ? importOptions.ToMappingOptions(isCopy: true)
                : importOptions.ToMappingOptions(isCopy);

            // 3. Process each unit.
            foreach (var (entry, rawUnit) in importResult.Units)
            {
                // Apply user-selected import options via AutoMapper.
                // IrregularForms and Words (including Examples) are handled
                // by their respective MappingActions.
                var unit = Mapper.Map<UnitModel>(rawUnit, opts =>
                    opts.Items[UnitMappingOptions.Key] = mappingOptions);

                unit.CourseId = targetCourse.Id;

                if (importMode == ImportMode.Update && existingUnitGuids.Contains(entry.UnitGuid))
                {
                    var dbUnit = await UnitService.GetByGuidAsync(entry.UnitGuid);
                    if (dbUnit != null)
                    {
                        unit.Id = dbUnit.Id;
                        await UnitService.UpdateAsync(unit.Id, unit);
                        updated++;
                        continue;
                    }
                }

                // New unit — UnitId on words/irregularForms is set to 0 by
                // MappingActions; EF will fix FKs on cascade insert.
                await UnitService.CreateAsync(unit);
                added++;
            }

            importSuccess = importMode == ImportMode.Update
                ? $"Курс «{targetCourse.Title}» оновлено: +{added} нових, ↻{updated} оновлених модулів."
                : importMode == ImportMode.MergeInto
                    ? $"Додано {added} модулів до курсу «{targetCourse.Title}»: {importResult.TotalWords} слів, {importResult.TotalAudioFiles} аудіофайлів."
                    : $"Курс «{targetCourse.Title}» імпортовано: {added} модулів, "
                      + $"{importResult.TotalWords} слів, {importResult.TotalAudioFiles} аудіофайлів.";
        }
        catch (Exception ex)
        {
            importError = $"Помилка збереження: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void ClearState()
    {
        importError         = null;
        importSuccess       = null;
        manifest            = null;
        importResult        = null;
        existingCourse      = null;
        existingUnitGuids   = [];
        selectedFileName    = null;
        zipBytes            = null;
        mergeTargetCourseId = 0;
        availableCourses    = [];
    }
}

<style>
    .page-wrapper {
        display: flex;
        flex-direction: column;
        height: 100vh;
        height: 100dvh;
        overflow: hidden;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }

    .scroll-area {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;
    }

    .keyboard-spacer { height: 0; }

    .edit-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

.page-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0 0 0.5rem 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .page-description { color: var(--text-secondary); font-size: 1rem; margin: 0; }

.form-section { display: flex; flex-direction: column; gap: 0.75rem; }
    .form-section:not(:last-child) { margin-bottom: 2rem; }

    .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0 0 0.5rem 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

.file-picker-section { display: flex; flex-direction: column; gap: 0.5rem; }

    .btn-file-picker {
        padding: 0.875rem 1.5rem;
        border-radius: 10px;
        font-weight: 500;
        font-size: 1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border: 2px dashed #A3BFFA;
        background: rgba(163,191,250,0.05);
        color: #5a7fb8;
        transition: all 0.2s;
    }

    .btn-file-picker:hover:not(:disabled) { background: rgba(163,191,250,0.12); border-color: #7ea0f0; }
    .btn-file-picker:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn-file-picker i { font-size: 1.25rem; flex-shrink: 0; }

    .info-card {
        background: var(--surface-alt);
        border: 1px solid #e8eaed;
        border-radius: 10px;
        padding: 1rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .info-row { display: flex; gap: 1rem; font-size: 0.9rem; align-items: baseline; }
    .info-label { flex: 0 0 120px; color: var(--text-secondary); font-weight: 500; }
    .info-value { color: var(--text-primary); }
    .info-value--mono { font-family: monospace; font-size: 0.78rem; color: #555; word-break: break-all; }

    .units-list { display: flex; flex-direction: column; gap: 0.4rem; }

    .unit-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #fafafa;
    }

    .unit-item__icon { font-size: 1.2rem; color: #A3BFFA; flex-shrink: 0; }
    .unit-item__body { flex: 1; display: flex; flex-direction: column; gap: 0.15rem; }
    .unit-item__title { font-weight: 600; color: var(--text-primary); font-size: 0.95rem; }
    .unit-item__meta  { font-size: 0.8rem; color: #888; display: flex; align-items: center; gap: 0.5rem; }

    .badge-audio {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        background: rgba(163,191,250,0.15);
        color: #5a7fb8;
        padding: 0.1rem 0.5rem;
        border-radius: 99px;
        font-size: 0.75rem;
    }

    .badge {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.2rem 0.6rem;
        border-radius: 99px;
        flex-shrink: 0;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .badge-new    { background: rgba(181,234,215,0.3); color: #1a7a56; }
    .badge-update { background: rgba(163,191,250,0.3); color: #3558a8; }

    .radio-group { display: flex; flex-direction: column; gap: 0.5rem; }

    .radio-option {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.875rem 1rem;
        border: 2px solid var(--border);
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.15s;
    }

    .radio-option:hover { border-color: #c5d4f8; }
    .radio-option i { font-size: 1.2rem; color: #aaa; flex-shrink: 0; margin-top: 0.1rem; }
    .radio-option div { display: flex; flex-direction: column; gap: 0.2rem; }
    .radio-option strong { font-size: 0.95rem; color: var(--text-primary); }
    .radio-option span   { font-size: 0.82rem; color: #777; }
    .radio-option--active { border-color: #A3BFFA; background: rgba(163,191,250,0.07); }
    .radio-option--active i { color: #A3BFFA; }

    .btn-secondary {
        padding: 0.7rem 1.5rem;
        border-radius: 10px;
        font-weight: 500;
        font-size: 0.95rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: 1.5px solid #A3BFFA;
        background: transparent;
        color: #5a7fb8;
        transition: all 0.2s;
        align-self: flex-start;
    }

    .btn-secondary:hover { background: rgba(163,191,250,0.1); }

    .btn-submit {
        padding: 0.875rem 2rem;
