    background: transparent;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    outline: none;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    margin: -0.25rem -0.5rem;
    border-radius: 4px;
    transition: background 0.2s;
    }

    .word-list-select:hover {
    background: rgba(255, 255, 255, 0.5);
    }

    .word-list-select:focus {
    background: rgba(255, 255, 255, 0.7);
    }

    .editable-field {
    cursor: pointer;
    transition: all 0.2s;
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
    margin: -0.25rem -0.5rem;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    }

    .editable-field:hover {
    background: rgba(255, 255, 255, 0.5);
    }

