    }

    .info-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    }

    .info-description {
    font-size: 0.85rem;
    color: var(--text-secondary);
    }

    .editable-input {
    border: 2px solid #A3BFFA;
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
    outline: none;
    background: var(--surface);
    transition: border-color 0.2s;
    }

    .editable-input:focus {
    border-color: #6B8EE8;
    }

    .title-input {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    min-width: 200px;
    }

    .description-input {
    font-size: 0.85rem;
    color: var(--text-secondary);
    min-width: 250px;
    }

    .icon-btn-small {
    background: rgba(255, 255, 255, 0.7);
    border: none;
    border-radius: 6px;
    padding: 0.25rem 0.4rem;
