    color: var(--text-muted);
    }

    .icon-btn-small.cancel:hover {
    color: #dc3545;
    }

    .icon-btn-small i {
    font-size: 0.9rem;
    }

    .icon-btn {
    background: rgba(255, 255, 255, 0.5);
    border: none;
    border-radius: 8px;
    padding: 0.5rem;
    cursor: pointer;
    transition: all 0.2s;
    color: #555;
    }

    .icon-btn:hover {
    background: rgba(255, 255, 255, 0.8);
    transform: scale(1.1);
    }

    .quick-add-section {
    background: #fafafa;
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    }

    .quick-add-section h5 {
    color: #555;
