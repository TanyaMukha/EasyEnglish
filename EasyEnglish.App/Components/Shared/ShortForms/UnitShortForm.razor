@namespace EasyEnglish.App.Components.Shared

<ShortForm @ref="shortForm"
           Title="Створити новий список"
           FullFormUrl="@($"/courses/{CourseId}/units/create")"
           OnFormClosed="ResetForm">

    <EditForm Model="newUnit" OnValidSubmit="HandleCreateUnit" class="create-form">
        <DataAnnotationsValidator />

        <InputTextField @bind-Value="newUnit.Title"
                        Label="Назва списку" />
        <ValidationMessage For="@(() => newUnit.Title)" class="validation-message" />

        <InputMultilineField @bind-Value="newUnit.Description"
                             Label="Опис"
                             Rows="2" />
        <ValidationMessage For="@(() => newUnit.Description)" class="validation-message" />

        <div class="form-actions">
            <button type="button" class="btn-cancel" @onclick="CloseForm">
                Скасувати
            </button>
            <button type="submit" class="btn-create">
                <i class="bi bi-check-lg"></i> 
                Створити
            </button>
        </div>
    </EditForm>
</ShortForm>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public Func<Task>? OnUnitCreated { get; set; }

    private ShortForm? shortForm;
    private UnitModel newUnit = new UnitModel();
    private readonly List<(string, string)> levels = LanguageLevels.GetAll().ToList();

    protected override async Task OnInitializedAsync()
    {
        newUnit.CourseId = CourseId;
    }

    private void ResetForm()
    {
        newUnit = new UnitModel { CourseId = CourseId };
    }

    private void CloseForm()
    {
        shortForm?.Close();
        ResetForm();
    }

    private async Task HandleCreateUnit()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(newUnit.Title))
            {
                return;
            }

            await UnitService.CreateAsync(newUnit);

            if (OnUnitCreated != null)
            {
                await OnUnitCreated.Invoke();
            }

            CloseForm();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating word list: {ex.Message}");
        }
    }
}

<style>
    .create-form {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-actions {
        display: flex;
        gap: 0.75rem;
        margin-top: 1rem;
    }

    .btn-cancel,
    .btn-create {
        flex: 1;
        border: none;
        border-radius: 8px;
        padding: 0.75rem 1.5rem;
        cursor: pointer;
        transition: all 0.2s;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 0.95rem;
    }

    .btn-cancel {
        background: #f8f9fa;
        color: #666;
        border: 1px solid #dee2e6;
    }

    .btn-cancel:hover {
        background: white;
        border-color: #999;
        color: #333;
    }

    .btn-create {
        background: linear-gradient(135deg, #A3BFFA, #B5EAD7);
        color: white;
        box-shadow: 0 2px 8px rgba(163, 191, 250, 0.3);
    }

    .btn-create:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(163, 191, 250, 0.4);
    }

    .btn-create:active,
    .btn-cancel:active {
        transform: translateY(0);
    }

    .validation-message {
        color: #dc3545;
        font-size: 0.85rem;
        margin-top: -1rem;
        margin-bottom: 0.5rem;
        padding-left: 0.5rem;
    }

    @@media (max-width: 768px) {
        .form-actions {
            flex-direction: column;
        }
    }
</style>