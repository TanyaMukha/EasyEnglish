@namespace EasyEnglish.App.Components.Shared

<ShortForm @ref="shortForm"
           Title="Швидке додавання слів"
           FullFormUrl="@($"/courses/{CourseId}/units/{UnitId}/words/create")"
           OnFormClosed="ResetForm">

    <EditForm Model="Words" OnValidSubmit="HandleValidSubmit" class="create-form">
        <DataAnnotationsValidator />

        <div class="words-list">
            @for (var index = 0; index < Words.Count; index++)
            {
                var currentIndex = index;
                var word = Words[index];

                    <div class="word-row">
                        <span class="word-number">@(index + 1)</span>

                        <div class="word-inputs">
                            <div class="input-group">
                                <InputTextField @bind-Value="word.Word" Label="Слово" />
                                <ValidationMessage For="@(() => word.Word)" class="validation-message" />
                            </div>

                            <div class="input-group">
                                <InputTranscriptionField @bind-Value="word.Transcription" Label="Транскрипція" />
                                <ValidationMessage For="@(() => word.Transcription)" class="validation-message" />
                            </div>

                            <div class="input-group">
                                <InputTextField @bind-Value="word.Translation" Label="Переклад" />
                                <ValidationMessage For="@(() => word.Translation)" class="validation-message" />
                            </div>
                        </div>

                    @if (Words.Count > 1)
                    {
                                <button type="button" 
                                        class="remove-btn" 
                                        @onclick="() => RemoveWord(currentIndex)" 
                                        title="Видалити">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                    }
                    </div>
            }
        </div>

        <div class="form-actions">
            <button type="button" class="btn-cancel" @onclick="CloseForm">
                Скасувати
            </button>
            <button type="button" class="btn-secondary" @onclick="AddWord">
                <i class="bi bi-plus-circle"></i> 
                Додати рядок
            </button>
            <button type="submit" class="btn-create">
                <i class="bi bi-check-lg"></i> 
                Зберегти
            </button>
        </div>
    </EditForm>
</ShortForm>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int UnitId { get; set; } = 0;
    [Parameter] public Func<Task>? OnWordsCreated { get; set; }

    private ShortForm? shortForm;
    private List<WordModel> Words { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        AddWord();
    }

    private void ResetForm()
    {
        Words.Clear();
        AddWord();
    }

    private void CloseForm()
    {
        shortForm?.Close();
        ResetForm();
    }

    private bool HasAnyInput()
    {
        return Words.Any(w => !string.IsNullOrWhiteSpace(w.Word) ||
                             !string.IsNullOrWhiteSpace(w.Transcription) ||
                             !string.IsNullOrWhiteSpace(w.Translation));
    }

    private void AddWord()
    {
        var newWord = new WordModel
            {
                UnitId = UnitId
            };
        Words.Add(newWord);
    }

    private void RemoveWord(int index)
    {
        if (Words.Count > 1)
        {
            Words.RemoveAt(index);
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            var validWords = Words.Where(w => !string.IsNullOrWhiteSpace(w.Word)).ToList();

            if (!validWords.Any())
            {
                return;
            }

            foreach (var word in validWords)
            {
                await WordService.CreateAsync(word);
            }

            if (OnWordsCreated != null)
            {
                await OnWordsCreated.Invoke();
            }

            CloseForm();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving word list items: {ex.Message}");
        }
    }
}

<style>
    .create-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        height: 100%;
    }

    .words-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        flex: 1;
        overflow-y: auto;
        max-height: 400px;
        padding-right: 0.5rem;
    }

    .word-row {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1rem;
        /* background: var(--surface-alt); */
        border-radius: 8px;
        transition: all 0.2s;
    }

    .word-row:hover {
        background: var(--surface-hover);
    }

    .word-number {
        font-size: 0.9rem;
        color: var(--text-muted);
        font-weight: 600;
        min-width: 1.5rem;
        text-align: center;
        padding-top: 1.25rem;
        flex-shrink: 0;
    }

    .word-inputs {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 1rem;
        flex: 1;
    }

    .input-group {
        display: flex;
        flex-direction: column;
    }

    .remove-btn {
        background: transparent;
        border: 1px solid var(--border-muted);
        border-radius: 8px;
        color: var(--text-muted);
        cursor: pointer;
        padding: 0.5rem;
        transition: all 0.2s;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 0.75rem;
    }

    .remove-btn:hover {
        background: var(--danger-bg);
        border-color: #dc3545;
        color: #dc3545;
    }

    .remove-btn i {
        font-size: 0.9rem;
    }

    .form-actions {
        display: flex;
        gap: 0.75rem;
        margin-top: auto;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
    }

    .btn-cancel,
    .btn-secondary,
    .btn-create {
        border: none;
        border-radius: 8px;
        padding: 0.75rem 1.5rem;
        cursor: pointer;
        transition: all 0.2s;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 0.95rem;
    }

.btn-cancel:hover {
        background: var(--surface);
        border-color: var(--text-muted);
        color: var(--text-primary);
    }

    .btn-secondary {
        flex: 1;
        background: var(--surface-alt);
        color: var(--text-secondary);
        border: 1px solid var(--border-muted);
    }

    .btn-secondary:hover {
        background: var(--surface);
        border-color: #A3BFFA;
        color: #A3BFFA;
        transform: translateY(-2px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .btn-create {
        flex: 1;
        background: linear-gradient(135deg, #A3BFFA, #B5EAD7);
        color: white;
        box-shadow: 0 2px 8px rgba(163, 191, 250, 0.3);
    }

    .btn-create:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(163, 191, 250, 0.4);
    }

    .btn-create:active,
    .btn-secondary:active,
    .btn-cancel:active {
        transform: translateY(0);
    }

/* Scrollbar styling */
    .words-list::-webkit-scrollbar {
        width: 6px;
    }

    .words-list::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 3px;
    }

    .words-list::-webkit-scrollbar-thumb {
        background: #A3BFFA;
        border-radius: 3px;
    }

    .words-list::-webkit-scrollbar-thumb:hover {
        background: #8FA9E8;
    }

    @@media (max-width: 1024px) {
        .word-inputs {
            grid-template-columns: 1fr;
            gap: 0.5rem;
        }

        .word-row {
            flex-direction: column;
            gap: 0.75rem;
        }

        .word-number {
            padding-top: 0;
        }

        .remove-btn {
            margin-top: 0;
            align-self: flex-end;
        }

        .form-actions {
            flex-direction: column;
        }
    }
</style>