@namespace EasyEnglish.App.Components.Shared

<a href="@Link" class="irregular-card @ColorClass">
    <div class="card-header-section">
        <div class="card-icon-wrapper">
            <div class="card-icon">
                <i class="bi @Icon"></i>
            </div>
            @if (Type == "review")
            {
                <div class="type-badge review">
                    <i class="bi bi-eye"></i>
                </div>
            }
            else if (Type == "input")
            {
                <div class="type-badge input">
                    <i class="bi bi-pencil"></i>
                </div>
            }
        </div>
    </div>

    <div class="card-content">
        <h3 class="card-title">@Title</h3>
        <p class="card-description">@Description</p>
    </div>

    <div class="card-footer">
        <span class="btn-start">
            <i class="bi bi-play-fill"></i>
            Почати
        </span>
    </div>
</a>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = "bi-book";
    [Parameter] public string Link { get; set; } = "#";
    [Parameter] public string Type { get; set; } = "review"; // review or input
    [Parameter] public string Color { get; set; } = "blue";

    private string ColorClass => $"color-{Color.ToLower()}";
}

<style>
    .irregular-card {
        background: var(--surface);
        border: 2px solid var(--border);
        border-radius: 16px;
        padding: 1.5rem;
        text-decoration: none;
        transition: all 0.2s;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        position: relative;
    }

        .irregular-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        }

        /* Color Variations - Border on Hover */
        .irregular-card.color-blue:hover {
            border-color: #42A5F5;
        }

        .irregular-card.color-light-blue:hover {
            border-color: #4FC3F7;
        }

        .irregular-card.color-green:hover {
            border-color: #66BB6A;
        }

        .irregular-card.color-mint:hover {
            border-color: #26A69A;
        }

        .irregular-card.color-purple:hover {
            border-color: #AB47BC;
        }

        .irregular-card.color-lavender:hover {
            border-color: #9575CD;
        }

        .irregular-card.color-pink:hover {
            border-color: #EC407A;
        }

        .irregular-card.color-coral:hover {
            border-color: #FF7043;
        }

    /* Header Section */
    .card-header-section {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .card-icon-wrapper {
        position: relative;
    }

    /* Icon - Same size as ExerciseCard (56px) */
    .card-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        color: white;
    }

    /* Icon Colors */
    .color-blue .card-icon {
        background: linear-gradient(135deg, #42A5F5, #1E88E5);
    }

    .color-light-blue .card-icon {
        background: linear-gradient(135deg, #4FC3F7, #29B6F6);
    }

    .color-green .card-icon {
        background: linear-gradient(135deg, #66BB6A, #4CAF50);
    }

    .color-mint .card-icon {
        background: linear-gradient(135deg, #26A69A, #00897B);
    }

    .color-purple .card-icon {
        background: linear-gradient(135deg, #AB47BC, #8E24AA);
    }

    .color-lavender .card-icon {
        background: linear-gradient(135deg, #9575CD, #7E57C2);
    }

    .color-pink .card-icon {
        background: linear-gradient(135deg, #EC407A, #D81B60);
    }

    .color-coral .card-icon {
        background: linear-gradient(135deg, #FF7043, #F4511E);
    }

    /* Type Badge */
    .type-badge {
        position: absolute;
        top: -8px;
        right: -8px;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        color: white;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

        .type-badge.review {
            background: linear-gradient(135deg, #A3BFFA, #7B9FE8);
        }

        .type-badge.input {
            background: linear-gradient(135deg, #66BB6A, #4CAF50);
        }

    /* Content */
    .card-content {
        flex: 1;
    }

    .card-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0 0 0.5rem 0;
    }

    .card-description {
        font-size: 0.95rem;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.5;
    }

    /* Footer */
    .card-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        padding-top: 1rem;
        border-top: 1px solid var(--border-light);
        background-color: transparent;
    }

    /* Button - Same as ExerciseCard */
    .btn-start {
        background: var(--surface-alt);
        border: 1px solid var(--border-muted);
        border-radius: 10px;
        padding: 0.625rem 1.25rem;
        color: var(--text-secondary);
        font-weight: 600;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

    .irregular-card:hover .btn-start {
        background: var(--surface);
        border-color: #A3BFFA;
        color: #A3BFFA;
        transform: scale(1.05);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .irregular-card
        {
            padding: 1.25rem;
        }

        .card-title {
            font-size: 1.1rem;
        }

        .card-description {
            font-size: 0.9rem;
        }
    }
</style>