@namespace EasyEnglish.App.Components.Shared
@using System.Globalization
@using EasyEnglish.Core.Enums

<div class="card-tile" @onclick="@(() => NavigationManager.NavigateTo($"/courses/{CourseId}/units/{card.UnitId}/test-cards/{card.Id}"))">
    <div class="card-tile-header">
        <div class="card-tile-header-main">
            <h3 class="card-tile-title">@GetTitle()</h3>
            <span class="card-tile-kind-badge">@GetKindLabel()</span>
        </div>
    </div>

    <div class="card-tile-body">
        @GetPreviewText()
    </div>

    <div class="card-tile-footer">
        <div class="card-tile-stats">
            <span class="card-tile-stat-item">
                <i class="bi bi-star-fill"></i>
                @card.Rate.ToString("F1", CultureInfo.InvariantCulture)
            </span>
            <span class="card-tile-stat-item">
                <i class="bi bi-arrow-repeat"></i>
                @card.ReviewCount
            </span>
        </div>
        @if (ShowActions)
        {
            <CardActionsMenu EditHref="@($"/courses/{CourseId}/units/{card.UnitId}/test-cards/{card.Id}/edit")"
                             OnDelete="@(() => OnDelete.InvokeAsync(card.Id))" />
        }
    </div>
</div>

@code {
    [Parameter] public TestCardModel card { get; set; } = null!;

    /// <summary>Показувати кнопки редагування/видалення.</summary>
    [Parameter] public bool ShowActions { get; set; } = true;

    [Parameter] public EventCallback<int> OnDelete { get; set; }

    [Parameter] public int CourseId { get; set; }

    private string GetTitle() =>
        string.IsNullOrEmpty(card.Title) ? GetKindLabel() : card.Title;

    /// <summary>Question when it's set; otherwise falls back to FormattedText (e.g. a Cloze
    /// card's fill-in-the-blank template often has no separate task text).</summary>
    private string GetPreviewText() =>
        string.IsNullOrWhiteSpace(card.Question) ? card.FormattedText ?? "" : card.Question;

    private string GetKindLabel() => card.Kind switch
    {
        TestCardKind.SingleChoice => "Один варіант",
        TestCardKind.MultipleChoice => "Кілька варіантів",
        TestCardKind.ShortAnswer => "Коротка відповідь",
        TestCardKind.Cloze => "Заповнити пропуск",
        TestCardKind.Matching => "Відповідність",
        _ => card.Kind.ToString()
    };
}
