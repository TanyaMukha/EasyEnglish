@namespace EasyEnglish.App.Components.Shared
@using EasyEnglish.App.Models
@using EasyEnglish.App.Interfaces
@inject IPronunciationCheckService PronunciationCheckService

@*
    Picker for exercise types: a plain checkbox list, collapsed by default.

    Cards were the wrong shape here — this is a set of switches, not a gallery, and a dozen tiles
    pushed the actual content selection off the screen. Collapsed, the summary shows how many are
    on, so the page opens with the choice already made and the details out of the way.

    An exercise that needs speech recognition is not listed where the platform cannot do it
    (Android today): offering an exercise that silently fails is worse than not offering it.
*@

<details class="exercise-list">
    <summary>
        @* display:flex on a summary hides the native triangle, so the block gets its own *@
        <i class="bi bi-chevron-right block-chevron"></i>
        <span class="exercise-list-title">@Title</span>
        <span class="exercise-list-count">@SelectedKeys.Count із @Available.Count</span>
    </summary>

    <div class="exercise-presets">
        <button type="button" class="preset-btn" @onclick="ApplyDefaultPreset">За замовчуванням</button>
        <button type="button" class="preset-btn" @onclick="SelectAll">Усі</button>
        <button type="button" class="preset-btn" @onclick="SelectNone">Зняти всі</button>
    </div>

    <ul class="exercise-rows">
        @foreach (var option in Available)
        {
            var key = option.Key;

            <li>
                <label class="exercise-row">
                    <input type="checkbox"
                           checked="@SelectedKeys.Contains(key)"
                           @onchange="@(e => Toggle(key, (bool)(e.Value ?? false)))" />
                    <span class="exercise-row-text">
                        <span class="exercise-row-title">@option.Title</span>
                        @if (!string.IsNullOrWhiteSpace(option.Description))
                        {
                            <span class="exercise-row-desc">@option.Description</span>
                        }
                    </span>
                </label>
            </li>
        }
    </ul>
</details>

@code {
    [Parameter, EditorRequired] public List<ExerciseOption> Options { get; set; } = new();
    [Parameter] public HashSet<string> SelectedKeys { get; set; } = new();
    [Parameter] public EventCallback<HashSet<string>> SelectedKeysChanged { get; set; }
    [Parameter] public string Title { get; set; } = "Типи вправ";

    private bool SpeechAvailable => PronunciationCheckService.IsSupported;

    /// <summary>What this device can actually run.</summary>
    private List<ExerciseOption> Available =>
        Options.Where(o => SpeechAvailable || !o.RequiresSpeech).ToList();

    private bool _initialized;

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized)
            return;

        _initialized = true;

        // An empty selection means the page has not chosen anything yet — start from the preset.
        // Anything the device cannot run is dropped even if a caller pre-selected it.
        var next = SelectedKeys.Count == 0
            ? ExerciseCatalog.DefaultKeys(Options, SpeechAvailable)
            : SelectedKeys.Where(k => Available.Any(o => o.Key == k)).ToHashSet();

        if (next.SetEquals(SelectedKeys))
            return;

        SelectedKeys = next;
        await SelectedKeysChanged.InvokeAsync(SelectedKeys);
    }

    private Task ApplyDefaultPreset() => Apply(ExerciseCatalog.DefaultKeys(Options, SpeechAvailable));
    private Task SelectAll()          => Apply(Available.Select(o => o.Key).ToHashSet());
    private Task SelectNone()         => Apply([]);

    private Task Toggle(string key, bool isChecked)
    {
        var next = new HashSet<string>(SelectedKeys);

        if (isChecked) next.Add(key);
        else           next.Remove(key);

        return Apply(next);
    }

    private async Task Apply(HashSet<string> keys)
    {
        SelectedKeys = keys;
        await SelectedKeysChanged.InvokeAsync(SelectedKeys);
    }
}

<style>
    .exercise-list {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 0.5rem 1rem;
    }

    .exercise-list summary {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        padding: 0.5rem 0;
        font-weight: 600;
        color: var(--text-primary);
    }

    .exercise-list summary::-webkit-details-marker {
        display: none;
    }

    /* Shared with the other collapsible blocks: a chevron that turns when the block opens */
    .block-chevron {
        color: var(--text-muted);
        font-size: 0.85rem;
        transition: transform 0.15s ease;
    }

    details[open] > summary .block-chevron {
        transform: rotate(90deg);
    }

    .exercise-list[open] summary {
        margin-bottom: 0.5rem;
        border-bottom: 1px solid var(--border-light);
    }

    .exercise-list-count {
        margin-left: auto;
        padding: 0.1rem 0.55rem;
        border-radius: 999px;
        background: var(--surface-alt);
        border: 1px solid var(--border);
        color: var(--text-muted);
        font-size: 0.8rem;
        font-weight: 500;
    }

    .exercise-presets {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        padding: 0.5rem 0;
    }

    .preset-btn {
        padding: 0.3rem 0.7rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: transparent;
        color: var(--text-secondary);
        font-size: 0.85rem;
        transition: all 0.15s ease;
    }

    .preset-btn:hover {
        border-color: var(--accent);
        color: var(--accent);
    }

    .exercise-rows {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .exercise-row {
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
        padding: 0.5rem 0;
        cursor: pointer;
    }

    .exercise-row input {
        width: 20px;
        height: 20px;
        margin-top: 0.1rem;
        flex-shrink: 0;
        accent-color: var(--accent);
    }

    .exercise-row-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .exercise-row-title {
        font-size: 0.95rem;
        color: var(--text-primary);
    }

    .exercise-row-desc {
        font-size: 0.8rem;
        color: var(--text-muted);
        line-height: 1.35;
    }
</style>
