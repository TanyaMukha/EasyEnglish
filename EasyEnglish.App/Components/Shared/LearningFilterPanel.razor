@namespace EasyEnglish.App.Components.Shared
@using EasyEnglish.Core.Enums
@using EasyEnglish.Core.Options

@*
    Quick selection of items for a session.

    The filter applies immediately — there is no "Apply" button: it forced the learner to guess
    whether the latest change was taken into account. Priority is a mutually exclusive choice,
    hence a chip row rather than a set of checkboxes; options that make no sense with the chosen
    priority are disabled with an explanation instead of being silently ignored.
*@

<div class="learning-filter-panel">
    <div class="filter-row">
        <span class="filter-label"><i class="bi bi-sort-down"></i> Що вибрати</span>

        <div class="chip-row" role="group">
            @foreach (var option in Priorities)
            {
                var priority = option.Value;
                <button type="button"
                        class="chip @(Options.Priority == priority ? "active" : "")"
                        title="@option.Hint"
                        @onclick="() => SetPriorityAsync(priority)">
                    <i class="bi @option.Icon"></i>
                    <span>@option.Title</span>
                </button>
            }
        </div>
        <span class="filter-hint">@CurrentPriorityHint</span>
    </div>

    <div class="filter-row">
        <span class="filter-label">
            <i class="bi bi-123"></i> Скільки
            <span class="filter-value">@(IsAll ? AllLabel : _count.ToString())</span>
        </span>

        @* Step of exactly 1: a slider with step 5 could not reach the right edge when the
           item count is not divisible by 5 (23 items → 20 was the maximum).
           "All" is the right edge, not zero: a header saying "усі 31" and a slider lying on the
           left edge described the same thing in two contradictory ways. *@
        <input type="range"
               class="field-slider"
               min="1"
               max="@Limit"
               step="1"
               value="@_count"
               @oninput="OnCountInput"
               @onchange="OnCountCommitAsync" />
        <div class="slider-labels">
            <span>1</span>
            <span>@(Limit / 2)</span>
            <span>@AllLabel</span>
        </div>

        @* Round numbers without aiming with the slider — and "all" in a single tap *@
        <div class="preset-row">
            @foreach (var preset in CountPresets)
            {
                var value = preset;
                <button type="button"
                        class="preset @(!IsAll && _count == value ? "active" : "")"
                        @onclick="() => SetCountAsync(value)">@value</button>
            }

            <button type="button"
                    class="preset @(IsAll ? "active" : "")"
                    @onclick="() => SetCountAsync(Limit)">усі</button>
        </div>
    </div>

    <div class="filter-row">
        <div class="switch-list">
            <label class="switch @(IsLearnedToggleDisabled ? "disabled" : "")"
                   title="@(IsLearnedToggleDisabled ? "Нові елементи ще ніхто не вивчав — опція тут ні на що не впливає" : "")">
                <input type="checkbox"
                       checked="@Options.IncludeLearnedWords"
                       disabled="@IsLearnedToggleDisabled"
                       @onchange="OnIncludeLearnedChangedAsync" />
                <span>Включати вивчені</span>
            </label>

            <label class="switch">
                <input type="checkbox"
                       checked="@Options.ShuffleWords"
                       @onchange="OnShuffleChangedAsync" />
                <span>Перемішати</span>
            </label>
        </div>
    </div>

    @if (OnApply.HasDelegate)
    {
        <div class="filter-footer">
            <span class="filter-result">
                @if (ResultCount is { } count)
                {
                    <text>Обрано <strong>@count</strong> із @TotalCount</text>
                }
                else
                {
                    <text>Обрано @TotalCount із @TotalCount</text>
                }
            </span>

            @if (OnReset.HasDelegate)
            {
                <button type="button" class="btn-reset" @onclick="() => OnReset.InvokeAsync()">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Скинути
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public LearningSelectionOptions Options { get; set; } = new();
    [Parameter] public int MaxCount { get; set; } = 100;

    /// <summary>How many items exist in total — for the result line.</summary>
    [Parameter] public int TotalCount { get; set; }

    /// <summary>How many the last application picked; null — the filter has not run yet.</summary>
    [Parameter] public int? ResultCount { get; set; }

    /// <summary>
    /// Raised after every filter change. When not set, the panel only edits the options
    /// (that is how course practice setup works, where the selection is resolved later).
    /// </summary>
    [Parameter] public EventCallback OnApply { get; set; }

    /// <summary>Back to manual selection (all items).</summary>
    [Parameter] public EventCallback OnReset { get; set; }

    private int _count;

    /// <summary>Right edge of the slider — "all there is". Never zero, so the control stays usable.</summary>
    private int Limit => Math.Max(MaxCount, 1);

    /// <summary>No limit: the whole set. Stored as WordCount = 0, shown as the right edge.</summary>
    private bool IsAll => _count >= Limit;

    /// <summary>Course practice does not know the total yet — then "усі" stands without a number.</summary>
    private string AllLabel => TotalCount > 0 ? $"усі {Limit}" : "усі";

    /// <summary>Round values worth offering: only those below the available count.</summary>
    private IEnumerable<int> CountPresets =>
        new[] { 5, 10, 20, 50, 100 }.Where(v => v < Limit);

    private sealed record PriorityOption(LearningPriority Value, string Title, string Icon, string Hint);

    private static readonly PriorityOption[] Priorities =
    [
        new(LearningPriority.Random,    "Випадкові",  "bi-shuffle",              "Будь-які елементи з набору"),
        new(LearningPriority.Recent,    "Попередні",  "bi-clock-history",        "Ті, що вивчалися останніми"),
        new(LearningPriority.Old,       "Найстаріші", "bi-hourglass-bottom",     "Давно не повторювались"),
        new(LearningPriority.Difficult, "Складні",    "bi-exclamation-triangle", "З найбільшою складністю"),
        new(LearningPriority.New,       "Нові",       "bi-star",                 "Ще жодного разу не вивчені"),
        new(LearningPriority.Review,    "Повторення", "bi-arrow-repeat",         "Уже вивчені — час закріпити"),
    ];

    /// <summary>"New" items have no learning history, so the learned toggle is meaningless.</summary>
    private bool IsLearnedToggleDisabled => Options.Priority == LearningPriority.New;

    private string CurrentPriorityHint =>
        Priorities.FirstOrDefault(p => p.Value == Options.Priority)?.Hint ?? "";

    /// <summary>Short description of the filter state — pages show it while the panel is collapsed.</summary>
    public static string Describe(LearningSelectionOptions options)
    {
        var priority = Priorities.FirstOrDefault(p => p.Value == options.Priority)?.Title ?? "Випадкові";
        var count    = options.WordCount > 0 ? options.WordCount.ToString() : "усі";
        return $"{priority} · {count}";
    }

    // WordCount = 0 means "no limit"; on the slider that is the right edge, not the left one.
    protected override void OnParametersSet() =>
        _count = Options.WordCount > 0 ? Math.Min(Options.WordCount, Limit) : Limit;

    private Task SetPriorityAsync(LearningPriority priority)
    {
        Options.Priority = priority;

        // "New" items are never learned — do not leave an enabled option that lies.
        if (priority == LearningPriority.New)
            Options.IncludeLearnedWords = false;

        return NotifyAsync();
    }

    private void OnCountInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
            _count = value;   // the slider moves live, the query runs only on release
    }

    private Task OnCountCommitAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
            return SetCountAsync(value);

        return NotifyAsync();
    }

    private Task SetCountAsync(int value)
    {
        _count = Math.Clamp(value, 1, Limit);

        // The right edge is "everything", and everything is stored as no limit at all.
        Options.WordCount = _count >= Limit ? 0 : _count;

        return NotifyAsync();
    }

    private Task OnIncludeLearnedChangedAsync(ChangeEventArgs e)
    {
        Options.IncludeLearnedWords = (bool)(e.Value ?? false);
        return NotifyAsync();
    }

    private Task OnShuffleChangedAsync(ChangeEventArgs e)
    {
        Options.ShuffleWords = (bool)(e.Value ?? false);
        return NotifyAsync();
    }

    private Task NotifyAsync() => OnApply.HasDelegate ? OnApply.InvokeAsync() : Task.CompletedTask;
}

<style>
    .learning-filter-panel {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .filter-row {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .filter-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .filter-label i {
        color: var(--accent);
    }

    .filter-value {
        margin-left: auto;
        background: var(--accent-gradient);
        color: white;
        padding: 0.15rem 0.6rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.85rem;
    }

    .filter-hint {
        font-size: 0.8rem;
        color: var(--text-muted);
        font-style: italic;
    }

    /* A mutually exclusive choice looks like one switch, not a set of independent buttons */
    .chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .chip {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.45rem 0.8rem;
        min-height: 38px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface);
        color: var(--text-secondary);
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.15s ease;
    }

    .chip i {
        font-size: 0.95rem;
    }

    .chip:hover {
        border-color: var(--accent);
        color: var(--accent);
    }

    .chip.active {
        background: var(--accent-gradient);
        border-color: transparent;
        color: white;
        font-weight: 600;
    }

    .field-slider {
        width: 100%;
        height: 8px;
        border-radius: 4px;
        background: var(--surface-hover);
        outline: none;
        -webkit-appearance: none;
        appearance: none;
    }

    .field-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: linear-gradient(135deg, #A3BFFA, #7B9FE8);
        cursor: pointer;
    }

    .field-slider::-moz-range-thumb {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: linear-gradient(135deg, #A3BFFA, #7B9FE8);
        cursor: pointer;
        border: none;
    }

    .slider-labels {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .preset-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin-top: 0.25rem;
    }

    .preset {
        min-width: 44px;
        min-height: 32px;
        padding: 0.25rem 0.6rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
        color: var(--text-secondary);
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.15s ease;
    }

    .preset:hover {
        border-color: var(--accent);
        color: var(--accent);
    }

    .preset.active {
        background: var(--accent);
        border-color: transparent;
        color: white;
        font-weight: 600;
    }

    .switch-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.5rem;
    }

    .switch {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        color: var(--text-primary);
        cursor: pointer;
    }

    .switch input {
        width: 18px;
        height: 18px;
        accent-color: var(--accent);
    }

    .switch.disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    .filter-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border-light);
    }

    .filter-result {
        font-size: 0.9rem;
        color: var(--text-secondary);
    }

    .filter-result strong {
        color: var(--text-primary);
    }

    .btn-reset {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.8rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: transparent;
        color: var(--text-secondary);
        font-size: 0.85rem;
        transition: all 0.15s ease;
    }

    .btn-reset:hover {
        border-color: var(--accent);
        color: var(--accent);
    }
</style>
