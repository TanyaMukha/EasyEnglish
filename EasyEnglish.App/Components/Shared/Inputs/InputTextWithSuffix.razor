@namespace EasyEnglish.App.Components.Shared

<div class="form-field-inline">
    <div class="input-wrapper input-with-suffix-wrapper">
        <InputText Value="@Value"
                   ValueChanged="@HandleValueChanged"
                   ValueExpression="@(() => Value)"
                   class="inline-input with-suffix"
                   @onfocus="@(() => isFocused = true)"
                   @onblur="@(() => isFocused = false)"
                   id="@inputId"
                   placeholder="@Placeholder" />
        <label for="@inputId" 
               class="@GetLabelClass()">
            @Label
        </label>
        <span class="input-suffix">@Suffix</span>
    </div>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Suffix { get; set; } = string.Empty;
    [Parameter] public string? Placeholder { get; set; }

    private bool isFocused = false;
    private string inputId = $"input-{Guid.NewGuid():N}";
    private string? currentValue;

    protected override void OnParametersSet()
    {
        currentValue = Value;
    }

    private bool HasValue => !string.IsNullOrWhiteSpace(currentValue);

    private string GetLabelClass()
    {
        return (isFocused || HasValue) ? "floating-label active" : "floating-label";
    }

    private async Task HandleValueChanged(string? newValue)
    {
        currentValue = newValue;
        await ValueChanged.InvokeAsync(newValue);
    }
}

<style>
    .form-field-inline {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-bottom: 1.5rem;
    }

    .input-wrapper {
        position: relative;
    }

    .input-with-suffix-wrapper {
        display: flex;
        align-items: flex-end;
    }

    .inline-input {
        width: 100%;
        border: none;
        border-bottom: 2px solid rgba(0, 0, 0, 0.1);
        padding: 1.5rem 0.5rem 0.5rem 0.5rem;
        background: transparent;
        outline: none !important;
        transition: border-color 0.2s;
        font-size: 1rem;
        color: var(--text-primary);
        font-family: inherit;
        box-shadow: none;
    }

    .inline-input.with-suffix {
        border-bottom-right-radius: 0;
        flex: 1;
    }

    .inline-input:focus {
        border-bottom-color: #A3BFFA;
        box-shadow: none;
    }

    .inline-input:hover:not(:focus) {
        border-bottom-color: rgba(0, 0, 0, 0.2);
    }

    .floating-label {
        position: absolute;
        left: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        font-size: 1rem;
        pointer-events: none;
        transition: all 0.2s ease-out;
        background: transparent;
    }

    .floating-label.active {
        top: 0.3rem;
        transform: translateY(0);
        font-size: 0.75rem;
        color: #A3BFFA;
    }

    .inline-input:focus ~ .floating-label {
        color: #A3BFFA;
    }

    .input-suffix {
        padding: 0.5rem 0.75rem;
        /* background: rgba(163, 191, 250, 0.1); */
        border-bottom: 2px solid rgba(0, 0, 0, 0.1);
        color: var(--text-secondary);
        font-weight: 600;
        font-size: 0.95rem;
        white-space: nowrap;
        transition: all 0.2s;
        margin-left: -1px;
    }

    .inline-input:focus ~ .input-suffix {
        border-bottom-color: #A3BFFA;
        /* background: rgba(163, 191, 250, 0.15); */
    }

    .inline-input:hover:not(:focus) ~ .input-suffix {
        border-bottom-color: rgba(0, 0, 0, 0.2);
    }

    @@media (max-width: 768px) {
        .inline-input,
        .input-suffix {
            font-size: 0.95rem;
        }
    }
</style>
