@namespace EasyEnglish.App.Components.Shared

<div class="form-field-inline">
    <div class="input-wrapper"
            @oncontextmenu="@HandleContextMenu"
            @oncontextmenu:preventDefault>
        <InputTextArea Value="@Value"
                       ValueChanged="@HandleValueChanged"
                       ValueExpression="@(() => Value)"
                       class="inline-textarea auto-resize"
                       @onfocus="@(() => isFocused = true)"
                       @onblur="@(() => isFocused = false)"
                       id="@inputId"
                       rows="@Rows" />
        <label for="@inputId"
               class="@GetLabelClass()">
            @Label
        </label>
    </div>

    @* <ContextMenu IsVisible="@showContextMenu" *@
    @*              X="@contextMenuX" *@
    @*              Y="@contextMenuY" *@
    @*              ElementId="@inputId" *@
    @*              OnValueChanged="@HandlePasteOrClear" *@
    @*              OnMenuClosed="@CloseContextMenu" /> *@
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public int Rows { get; set; } = 1;

    private bool isFocused = false;
    private bool showContextMenu = false;
    private double contextMenuX = 0;
    private double contextMenuY = 0;
    private string inputId = $"textarea-{Guid.NewGuid():N}";
    private string? currentValue;

    protected override void OnParametersSet()
    {
        currentValue = Value;
    }

    private bool HasValue => !string.IsNullOrWhiteSpace(currentValue);

    private string GetLabelClass()
    {
        return (isFocused || HasValue) ? "floating-label active" : "floating-label";
    }

    private async Task HandleValueChanged(string? newValue)
    {
        currentValue = newValue;
        await ValueChanged.InvokeAsync(newValue);
    }

    private void HandleContextMenu(MouseEventArgs e)
    {
        contextMenuX = e.ClientX;
        contextMenuY = e.ClientY;
        showContextMenu = true;
    }

    private void CloseContextMenu()
    {
        showContextMenu = false;
    }

    private async Task HandlePasteOrClear(string newValue)
    {
        currentValue = newValue;
        await ValueChanged.InvokeAsync(newValue);
    }
}

<style>
    .form-field-inline {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-bottom: 1.5rem;
    }

    .input-wrapper {
        position: relative;
    }

    .inline-textarea {
        width: 100%;
        border: none;
        border-bottom: 2px solid rgba(0, 0, 0, 0.1);
        padding: 1.5rem 0.5rem 0.5rem 0.5rem;
        background: transparent;
        outline: none !important;
        transition: border-color 0.2s;
        font-size: 1rem;
        color: var(--text-primary);
        font-family: inherit;
        box-shadow: none;
        min-height: 2.5rem;
        max-height: 300px;
        line-height: 1.5;
        resize: none;
        overflow-y: auto;
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .inline-textarea.auto-resize {
        field-sizing: content;
        overflow-y: hidden;
    }

    @@supports not (field-sizing: content) {
        .inline-textarea.auto-resize {
            overflow-y: auto;
        }
    }

    .inline-textarea:focus {
        border-bottom-color: #A3BFFA;
        box-shadow: none;
    }

    .inline-textarea:hover:not(:focus) {
        border-bottom-color: rgba(0, 0, 0, 0.2);
    }

    .floating-label {
        position: absolute;
        left: 0.5rem;
        top: 1.75rem;
        color: var(--text-muted);
        font-size: 1rem;
        pointer-events: none;
        transition: all 0.2s ease-out;
        background: transparent;
    }

    .floating-label.active {
        top: 0.3rem;
        font-size: 0.75rem;
        color: #A3BFFA;
    }

    .inline-textarea:focus ~ .floating-label {
        color: #A3BFFA;
    }
</style>