@namespace EasyEnglish.App.Components.Shared
@using EasyEnglish.App.Models

<div class="exercise-type-grid-wrapper">
    <div>
        <InputCheckboxField Label="Вибрати всі" Value="@IsAllSelected" ValueChanged="@ToggleAll" />
    </div>

    <div class="exercises-grid">
        @foreach (var option in Options)
        {
            <ExerciseCard
                Title="@option.Title"
                Description="@option.Description"
                Icon="@option.Icon"
                Color="@option.Color"
                IsSelected="@SelectedKeys.Contains(option.Key)"
                IsSelectedChanged="@(value => ToggleOption(option.Key, value))" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<ExerciseOption> Options { get; set; } = new();
    [Parameter] public HashSet<string> SelectedKeys { get; set; } = new();
    [Parameter] public EventCallback<HashSet<string>> SelectedKeysChanged { get; set; }

    private bool IsAllSelected => Options.Count > 0 && Options.All(o => SelectedKeys.Contains(o.Key));

    private async Task ToggleAll(bool value)
    {
        SelectedKeys = value ? Options.Select(o => o.Key).ToHashSet() : new HashSet<string>();
        await SelectedKeysChanged.InvokeAsync(SelectedKeys);
    }

    private async Task ToggleOption(string key, bool isChecked)
    {
        if (isChecked)
            SelectedKeys.Add(key);
        else
            SelectedKeys.Remove(key);

        await SelectedKeysChanged.InvokeAsync(SelectedKeys);
    }
}

<style>
    .exercise-type-grid-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .exercises-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.25rem;
    }
</style>
