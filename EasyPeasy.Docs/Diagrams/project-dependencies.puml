@startuml Project Dependencies

<style>
title {
  HorizontalAlignment right
  FontSize 22
}

legend {
  FontSize 12
  BackGroundColor #f7f7f7
  Margin 10
  Padding 10
}
</style>

skinparam {
    ComponentStyle rectangle
    ArrowColor #2688d4
    ArrowThickness 1.2
    ComponentBorderThickness 1.2
    ComponentBorderColor #2688d4
    ComponentBackgroundColor white
    ComponentFontColor black
    ComponentFontSize 12
    padding 4
    roundCorner 8
    shadowing false
}

title Exact ProjectReference Graph (derived from every .csproj, incl. test projects)

legend top left
  Ground-truth graph, not a simplified narrative -- see solution-architecture.puml for the
  annotated layered view. Every arrow here is a literal ""<ProjectReference>"" element.
  Test projects (dashed border) are excluded from the runtime app but shown for completeness --
  e.g. this is where you'd notice EasyPeasy.Business.Tests needs EasyPeasy.Data for its
  real-SQLite integration fixtures even though EasyPeasy.Business itself does not.
end legend

component "MukhaLab.SelectQueryParameters" as SQP
component "MukhaLab.Database" as MDb
component "MukhaLab.LoggerExtensionDelegate" as LogExt
component "MukhaLab.BrowserConsoleLogger" as BrowserLog
component "EasyPeasy.Core" as Core
component "EasyPeasy.Data" as Data
component "EasyPeasy.Business" as Business
component "EasyPeasy.Cache" as Cache
component "EasyPeasy.App" as App
component "EasyPeasy.ContentTools" as ContentTools

MDb --> SQP
Core --> MDb
Data --> Core
Business --> Core
Cache --> Core
App --> Cache
App --> Core
App --> Data
App --> Business
App --> BrowserLog
App --> LogExt
ContentTools --> Core

component "EasyPeasy.App.Tests" as AppTests #line.dashed
component "EasyPeasy.Core.Tests" as CoreTests #line.dashed
component "EasyPeasy.Data.Tests" as DataTests #line.dashed
component "EasyPeasy.Business.Tests" as BusinessTests #line.dashed
component "EasyPeasy.Cache.Tests" as CacheTests #line.dashed
component "MukhaLab.SelectQueryParameters.Tests" as SQPTests #line.dashed
component "MukhaLab.Database.Tests" as MDbTests #line.dashed
component "MukhaLab.BrowserConsoleLogger.Tests" as BrowserLogTests #line.dashed
component "MukhaLab.LoggerExtensionDelegate.Tests" as LogExtTests #line.dashed

AppTests ..> Core : Compile Include\n(NOT ProjectReference --\nsee key-decisions.md)
CoreTests ..> Core
DataTests ..> Data
BusinessTests ..> Business
BusinessTests ..> Data : real-SQLite fixtures
CacheTests ..> Cache
SQPTests ..> SQP
MDbTests ..> MDb
MDbTests ..> SQP
BrowserLogTests ..> BrowserLog
LogExtTests ..> LogExt

@enduml
